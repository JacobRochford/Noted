<noted:OverlayWindow x:Class="Noted.ChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:noted="clr-namespace:Noted"
        xmlns:h="clr-namespace:Noted.Helpers"
        xmlns:vm="clr-namespace:Noted.ViewModels"
        xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Checklist"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="340"
        Height="480"
        MinWidth="280"
        MinHeight="320">

    <noted:OverlayWindow.Resources>

        <!-- Converters -->
        <h:PriorityToColorConverter   x:Key="PriorityToColor"/>
        <h:DueDateToTextConverter     x:Key="DueDateToText"/>
        <h:DueDateToColorConverter    x:Key="DueDateToColor"/>
        <h:EnumToBoolConverter        x:Key="EnumToBool"/>
        <h:NullToVisibilityConverter  x:Key="NullToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Header icon button (sky blue pill, matches main app) -->
        <Style x:Key="HeaderIconBtn" TargetType="Button">
            <Setter Property="Background"      Value="#87CEEB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5BB8D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter tab RadioButton -->
        <Style x:Key="FilterTab" TargetType="RadioButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="Foreground"      Value="#64748B"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="BorderBrush" Value="#87CEEB"/>
                                <Setter Property="Foreground"  Value="#87CEEB"/>
                                <Setter Property="FontWeight"  Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small icon button used inside item rows -->
        <Style x:Key="SmallIconBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#94A3B8"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="2"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Width"           Value="22"/>
            <Setter Property="Height"          Value="22"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#374151"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete button — red hover -->
        <Style x:Key="DeleteBtn" TargetType="Button" BasedOn="{StaticResource SmallIconBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEE2E2"/>
                    <Setter Property="Foreground" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Underline link button for footer -->
        <Style x:Key="FooterLinkBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#64748B"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Txt"
                                       Text="{TemplateBinding Content}"
                                       TextDecorations="Underline"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="Foreground" Value="#87CEEB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#87CEEB"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5BB8D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </noted:OverlayWindow.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Controls bar -->
            <RowDefinition Height="Auto"/>  <!-- 1: Search bar   -->
            <RowDefinition Height="Auto"/>  <!-- 2: Progress bar -->
            <RowDefinition Height="*"/>     <!-- 3: Items list   -->
            <RowDefinition Height="Auto"/>  <!-- 4: Footer       -->
        </Grid.RowDefinitions>

        <!-- Resize thumb (invisible, bottom-right) -->
        <Primitives:Thumb x:Name="ResizeThumb"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Width="16" Height="16"
                          Cursor="SizeNWSE" Background="Transparent" Opacity="0"
                          DragDelta="ResizeThumb_DragDelta"
                          Grid.RowSpan="5" Panel.ZIndex="999"/>

        <!-- ══ Row 0: Header bar (tabs + actions) ════════════════════ -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="White"
                BorderBrush="#D4EEF7" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✓" Foreground="#87CEEB" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="2,0,8,0"/>
                    <RadioButton Content="All"    GroupName="CL_Filter" Style="{StaticResource FilterTab}"
                                 IsChecked="{Binding FilterMode, Converter={StaticResource EnumToBool},
                                             ConverterParameter={x:Static vm:ChecklistFilterMode.All}, Mode=TwoWay}"/>
                    <RadioButton Content="Active" GroupName="CL_Filter" Style="{StaticResource FilterTab}"
                                 IsChecked="{Binding FilterMode, Converter={StaticResource EnumToBool},
                                             ConverterParameter={x:Static vm:ChecklistFilterMode.Active}, Mode=TwoWay}"/>
                    <RadioButton Content="Done"   GroupName="CL_Filter" Style="{StaticResource FilterTab}"
                                 IsChecked="{Binding FilterMode, Converter={StaticResource EnumToBool},
                                             ConverterParameter={x:Static vm:ChecklistFilterMode.Completed}, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox SelectedValue="{Binding SortMode, Mode=TwoWay}" SelectedValuePath="Tag"
                              Background="White" Foreground="#64748B" BorderBrush="#D4EEF7"
                              FontSize="11" Padding="6,3" MinWidth="80" VerticalContentAlignment="Center"
                              ToolTip="Sort items" Margin="0,0,6,0">
                        <ComboBoxItem Content="Manual"   Tag="{x:Static vm:ChecklistSortMode.Manual}"/>
                        <ComboBoxItem Content="Priority" Tag="{x:Static vm:ChecklistSortMode.Priority}"/>
                        <ComboBoxItem Content="Due Date" Tag="{x:Static vm:ChecklistSortMode.DueDate}"/>
                        <ComboBoxItem Content="A → Z"    Tag="{x:Static vm:ChecklistSortMode.Alphabetical}"/>
                    </ComboBox>
                    <Button Content="⌕" Style="{StaticResource HeaderIconBtn}"
                            Click="SearchToggle_Click" ToolTip="Search (Ctrl+F)" Margin="0,0,4,0"/>
                    <Button Content="—" Style="{StaticResource HeaderIconBtn}"
                            Click="HideButton_Click" ToolTip="Hide"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Row 1: Search bar (collapsible) ═══════════════════════════ -->
        <Border Grid.Row="1" Background="#F0F9FF" BorderBrush="#D4EEF7" BorderThickness="0,0,0,1" Padding="10,7"
                Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Background="White" BorderBrush="#87CEEB" BorderThickness="1"
                         Foreground="#1E293B" CaretBrush="#1E293B"
                         Padding="8,6" FontSize="12" VerticalContentAlignment="Center"
                         KeyDown="SearchBox_KeyDown"/>
                <TextBlock Text="Search items and notes…" Foreground="#94A3B8" FontSize="12"
                           Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ══ Row 2: Progress bar ════════════════════════════════════════ -->
        <ProgressBar Grid.Row="2"
                     Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"
                     Height="4" BorderThickness="0"
                     Foreground="#87CEEB" Background="#E2E8F0"/>

        <!-- ══ Row 3: Items list ══════════════════════════════════════════ -->
        <ListBox x:Name="ItemsList" Grid.Row="3"
                 ItemsSource="{Binding FilteredItems}"
                 Background="White" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="False"
                 AllowDrop="True"
                 Drop="ItemsList_Drop"
                 DragOver="ItemsList_DragOver">

            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="White">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ListBox.Template>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding"                    Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="FocusVisualStyle"           Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent"
                                        BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Context menu -->
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Set Priority">
                                    <MenuItem Header="🔴  High"   Tag="High"   Click="SetPriority_Click"/>
                                    <MenuItem Header="🟠  Medium" Tag="Medium" Click="SetPriority_Click"/>
                                    <MenuItem Header="🟡  Low"    Tag="Low"    Click="SetPriority_Click"/>
                                    <Separator/>
                                    <MenuItem Header="◯  None"   Tag="None"   Click="SetPriority_Click"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Move to Top"    Click="MoveToTop_Click"/>
                                <MenuItem Header="Move Up"        Click="MoveUp_Click"/>
                                <MenuItem Header="Move Down"      Click="MoveDown_Click"/>
                                <MenuItem Header="Move to Bottom" Click="MoveToBottom_Click"/>
                                <Separator/>
                                <MenuItem Header="Duplicate"      Click="Duplicate_Click"/>
                                <Separator/>
                                <MenuItem Header="Delete"         Click="DeleteItem_Click"/>
                            </ContextMenu>
                        </Grid.ContextMenu>

                        <!-- ── Main item row ─────────────────────────────── -->
                        <Grid Grid.Row="0" MinHeight="38">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>    <!-- Priority strip -->
                                <ColumnDefinition Width="22"/>   <!-- Drag handle    -->
                                <ColumnDefinition Width="30"/>   <!-- Checkbox       -->
                                <ColumnDefinition Width="*"/>    <!-- Text input     -->
                                <ColumnDefinition Width="Auto"/> <!-- Due date chip  -->
                                <ColumnDefinition Width="22"/>   <!-- Expand toggle  -->
                                <ColumnDefinition Width="22"/>   <!-- Delete         -->
                            </Grid.ColumnDefinitions>

                            <!-- Priority strip — click to cycle -->
                            <Border Grid.Column="0"
                                    Background="{Binding Priority, Converter={StaticResource PriorityToColor}}"
                                    Cursor="Hand" ToolTip="Click to cycle priority"
                                    MouseLeftButtonDown="PriorityStrip_MouseLeftButtonDown"/>

                            <!-- Drag handle -->
                            <TextBlock Grid.Column="1" Text="⠿" Foreground="#CBD5E1" FontSize="14"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Cursor="SizeAll" ToolTip="Drag to reorder"
                                       MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"/>

                            <!-- Checkbox -->
                            <CheckBox Grid.Column="2"
                                      IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- Text input -->
                            <TextBox Grid.Column="3"
                                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="4,2" FontSize="13"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     TextWrapping="NoWrap"
                                     KeyDown="ItemTextBox_KeyDown"
                                     GotFocus="ItemTextBox_GotFocus"
                                     LostFocus="ItemTextBox_LostFocus">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Foreground" Value="#1E293B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                <Setter Property="Foreground"      Value="#94A3B8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!-- Due date chip — hidden when null -->
                            <Border Grid.Column="4"
                                    Background="{Binding DueDate, Converter={StaticResource DueDateToColor}}"
                                    Visibility="{Binding DueDate, Converter={StaticResource NullToVisibility}}"
                                    CornerRadius="3" Padding="5,2" Margin="4,0"
                                    VerticalAlignment="Center" Cursor="Hand"
                                    ToolTip="Click to open details"
                                    MouseLeftButtonDown="DueDateChip_MouseLeftButtonDown">
                                <TextBlock Text="{Binding DueDate, Converter={StaticResource DueDateToText}}"
                                           Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                            </Border>

                            <!-- Expand / collapse toggle -->
                            <Button Grid.Column="5"
                                    Click="ExpandButton_Click" ToolTip="Notes / due date">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SmallIconBtn}">
                                        <Setter Property="Content" Value="▶"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Content"    Value="▼"/>
                                                <Setter Property="Foreground" Value="#87CEEB"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Delete -->
                            <Button Grid.Column="6" Content="✕"
                                    Style="{StaticResource DeleteBtn}"
                                    Click="DeleteItem_Click" ToolTip="Delete item"/>
                        </Grid>

                        <!-- ── Expanded detail panel ─────────────────────── -->
                        <Border Grid.Row="1" Background="#F8FAFC" Padding="57,7,8,10"
                                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>

                                <!-- Notes textarea -->
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="48" MaxHeight="120"
                                         Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                         Padding="7,5" FontSize="12" Foreground="#374151"
                                         VerticalScrollBarVisibility="Auto">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter Property="BorderBrush" Value="#87CEEB"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Due date row -->
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📅  Due:" Foreground="#6B7280"
                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <DatePicker Grid.Column="1"
                                                SelectedDate="{Binding DueDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                FontSize="12" BorderBrush="#E2E8F0" Height="28"/>
                                    <Button Grid.Column="2" Content="✕"
                                            Style="{StaticResource SmallIconBtn}"
                                            Click="ClearDueDate_Click" ToolTip="Clear due date"
                                            Margin="4,0,0,0"
                                            Visibility="{Binding DueDate, Converter={StaticResource NullToVisibility}}"/>
                                </Grid>

                            </StackPanel>
                        </Border>

                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ══ Row 4: Footer ══════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FooterText}" Foreground="#94A3B8" FontSize="11"
                               VerticalAlignment="Center"/>
                    <Button Content="Clear done" Style="{StaticResource FooterLinkBtn}"
                            Click="ClearCompleted_Click" Margin="6,0,0,0"
                            Visibility="{Binding HasCompleted, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Remove all completed items"/>
                    <Button Content="Check all" Style="{StaticResource FooterLinkBtn}"
                            Click="CheckAll_Click" Margin="4,0,0,0"
                            ToolTip="Mark all as done"/>
                    <Button Content="Uncheck all" Style="{StaticResource FooterLinkBtn}"
                            Click="UncheckAll_Click" Margin="4,0,0,0"
                            Visibility="{Binding HasCompleted, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Unmark all completed"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox Content="Ghost" VerticalAlignment="Center" Margin="0,0,8,0"
                              IsChecked="{Binding GhostModeEnabled, Mode=TwoWay}"
                              Foreground="#94A3B8" FontSize="11"/>
                    <Button Content="+ Add" Style="{StaticResource PrimaryBtn}"
                            Click="AddButton_Click" ToolTip="Add item (Enter in last item)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom-right resize corner indicator -->
        <TextBlock Text="◢" Foreground="#CBD5E1" FontSize="9"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,3,2" IsHitTestVisible="False"
                   Grid.Row="4" Panel.ZIndex="998"/>

    </Grid>
</noted:OverlayWindow>
