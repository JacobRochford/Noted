<Window x:Class="Noted.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Noted.Helpers"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Noted."
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="MainWindow_Loaded">
    <Window.Resources>
        <local:WidthToActionButtonVisibilityConverter x:Key="WidthToActionButtonVisibilityConverter"/>
        <local:WidthToHeaderVisibilityConverter x:Key="WidthToHeaderVisibilityConverter"/>
        <local:WidthBelowThresholdConverter x:Key="WidthBelow320" Threshold="320"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:IndentLevelToMarginConverter x:Key="IndentLevelToMarginConverter"/>
        
        <!-- Scrollbar thumb style -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#91C5DE" CornerRadius="3" Margin="1,2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Modern scrollbar styling -->
        <Style x:Key="ModernScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Background" Value="#E6F2F8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Background="Transparent" BorderThickness="0" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Background="Transparent" BorderThickness="0" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Apply modern scrollbar style globally -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>

        <!-- Tray context menu styles -->
        <Style x:Key="TrayContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#F5F9FC"/>
            <Setter Property="BorderBrush" Value="#A8CDE0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrayMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#2C6E91"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Margin="2,1">
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#DFF0FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C4E2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrayMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Background" Value="#C8DFEC"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="1" Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tray context menu (opened manually to ensure proper foreground activation) -->
        <ContextMenu x:Key="TrayContextMenu" Style="{StaticResource TrayContextMenuStyle}">
            <MenuItem Header="Show/Hide Notes" Click="TrayShowHideNotes_Click" Style="{StaticResource TrayMenuItemStyle}"/>
            <MenuItem Header="⚙" Click="TraySettings_Click" Style="{StaticResource TrayMenuItemStyle}"/>
            <Separator Style="{StaticResource TrayMenuSeparatorStyle}"/>
            <MenuItem Header="Exit" Click="TrayExit_Click" Style="{StaticResource TrayMenuItemStyle}"/>
        </ContextMenu>

        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Key="TrayIcon"
                        IconSource="/Resources/notes.ico"
                        ToolTipText="Noted."/>
    </Window.Resources>

        <Canvas x:Name="MainCanvas"
            Background="Transparent"
            Focusable="True" Cursor="SizeAll">

        <Border x:Name="NotesPanel"
            Background="#F5F9FC"
            BorderBrush="#87CEEB"
            Opacity="0.88"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Focusable="True"
            MinWidth="220"
            MinHeight="180"
            Width="360" Height="620"
            Canvas.Right="40" Canvas.Top="60"
            Visibility="Visible"
            Cursor="SizeAll">

            <Grid>
                <DockPanel>
                <!-- Header bar -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="NotesPanelDragHandle"
                        Grid.Column="0"
                        Background="Transparent"
                        Focusable="True"
                        Cursor="SizeAll"
                        Padding="0,4,8,4">
                        <Grid>
                            <TextBlock x:Name="HeaderText"
                                       Text="{Binding DisplayHeaderText, Mode=OneWay}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="#2C6E91"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       FocusVisualStyle="{x:Null}"
                                       ToolTip="Double-click to set a custom header"
                                       Visibility="{Binding ElementName=NotesPanel, Path=ActualWidth, Converter={StaticResource WidthToHeaderVisibilityConverter}}"
                                       MouseLeftButtonDown="HeaderText_MouseLeftButtonDown"/>
                            <TextBox x:Name="HeaderTextEdit"
                                     FontSize="16" FontWeight="SemiBold"
                                     Text="{Binding HeaderTextEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Foreground="#2C6E91"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed"
                                     MinWidth="80"
                                     FocusVisualStyle="{x:Null}"
                                     ToolTip="Enter or click away to save"
                                     LostFocus="HeaderEditBox_LostFocus"
                                     KeyDown="HeaderEditBox_KeyDown"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="8,0,0,0">
                        <Button x:Name="NewNoteButton"
                                Content="➕"
                                Click="NewNoteButton_Click"
                                FontSize="15" FontWeight="SemiBold"
                                Foreground="White" Cursor="Hand"
                                Padding="10,4" Margin="0,0,6,0"
                                MinWidth="0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=NotesPanel, Path=ActualWidth, Converter={StaticResource WidthBelow320}}" Value="True">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="18"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Padding" Value="10,4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#5BA8C8"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#4A97B7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="QuickNoteButton"
                                Content="⚡"
                                Click="QuickNoteButton_Click"
                                FontSize="15" FontWeight="SemiBold"
                                Foreground="White" Cursor="Hand"
                                Padding="8,4" Margin="0,0,6,0"
                                MinWidth="0"
                                ToolTip="Create a quick note">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#5BA8C8"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#4A97B7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="SettingsButton"
                                Content="⚙"
                                Click="SettingsButton_Click"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="White" Cursor="Hand"
                                ToolTip="Settings"
                                Padding="10,4" Margin="0,0,6,0"
                                MinWidth="0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=NotesPanel, Path=ActualWidth, Converter={StaticResource WidthBelow320}}" Value="True">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="18"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Padding" Value="10,4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#617A8A"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#516774"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="ChecklistButton"
                                Content="✓"
                                Click="ChecklistButton_Click"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="White" Cursor="Hand"
                                Padding="8,4" Margin="0,0,6,0"
                                MinWidth="0"
                                ToolTip="Toggle Checklist">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#5BA8C8"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#4A97B7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="DictionaryButton"
                                Content="📚"
                                Click="DictionaryButton_Click"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="White" Cursor="Hand"
                                Padding="8,4" Margin="0,0,6,0"
                                MinWidth="0"
                                ToolTip="Toggle Dictionary">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#5BA8C8"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#4A97B7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="ScratchpadButton"
                                Content="✏"
                                Click="ScratchpadButton_Click"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="White" Cursor="Hand"
                                Padding="8,4" Margin="0,0,6,0"
                                MinWidth="0"
                                ToolTip="Toggle Scratchpad">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#5BA8C8"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#4A97B7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="MicroScratchpadButton"
                                Content="▤"
                                Click="MicroScratchpadButton_Click"
                                FontSize="13" FontWeight="SemiBold"
                                Foreground="White" Cursor="Hand"
                                Padding="8,4" Margin="0,0,6,0"
                                MinWidth="0"
                                ToolTip="New micro scratchpad">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#5BA8C8"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#4A97B7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="MinimizeNotesButton"
                                Content="✕"
                                Click="MinimizeNotesButton_Click"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="White" Cursor="Hand"
                                Padding="10,4"
                                Margin="0,0,0,0"
                                MinWidth="0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=NotesPanel, Path=ActualWidth, Converter={StaticResource WidthBelow320}}" Value="True">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="18"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Padding" Value="10,4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#6C86A0"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#5B748D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Separator -->
                <Border DockPanel.Dock="Top"
                    Height="1" Background="#D0E4EE" Margin="0,2,0,6"/>

                <Grid>
                    <Border x:Name="NotesContentBackground"
                        Background="#D9F5F9FC"
                        BorderBrush="#D8E9F1"
                        BorderThickness="1"
                        CornerRadius="8"/>

                    <DockPanel x:Name="NotesListView"
                              Margin="8"
                              Opacity="0.95">

                        <!-- Navigation breadcrumb bar – visible when inside a subfolder -->
                        <Border DockPanel.Dock="Top"
                                Margin="0,0,0,6"
                                Background="#E8F4FA"
                                BorderBrush="#C9DFEC"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6,5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanNavigateUp}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        x:Name="NavigateUpButton"
                                        Content="&#xE72B;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="12"
                                        Foreground="#2C6E91"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,2"
                                        Cursor="Hand"
                                        ToolTip="Back to parent folder"
                                        AutomationProperties.Name="Navigate up"
                                        Click="NavigateUpButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg"
                                                    Background="Transparent"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#DCEEF8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentFolderName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#2C6E91"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="4,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Search / filter bar -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Border BorderThickness="1" CornerRadius="6" Padding="8,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#C9DFEC"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="#5BA8C8"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search icon -->
                                    <TextBlock Grid.Column="0"
                                               Text="&#xE721;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="#7AAEC5"
                                               VerticalAlignment="Center"
                                               Margin="2,0,6,0"
                                               IsHitTestVisible="False"/>

                                    <!-- Placeholder rendered BEHIND the TextBox (same column, earlier in XML order) -->
                                    <TextBlock Grid.Column="1"
                                               Text="Search notes..."
                                               FontSize="12"
                                               FontStyle="Italic"
                                               Foreground="#A0B8C8"
                                               VerticalAlignment="Center"
                                               Padding="0,7"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Search TextBox (rendered on top of placeholder) -->
                                    <TextBox x:Name="SearchBox"
                                             Grid.Column="1"
                                             FontSize="12"
                                             Foreground="#333333"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0,7"
                                             VerticalAlignment="Center"
                                             KeyDown="SearchBox_KeyDown"/>

                                    <!-- Clear button (visible only when FilterText is non-empty) -->
                                    <Button Grid.Column="2"
                                            x:Name="ClearSearchButton"
                                            Content="&#xE711;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="11"
                                            Foreground="#7AAEC5"
                                            Cursor="Hand"
                                            Padding="6,6"
                                            AutomationProperties.Name="Clear search"
                                            Click="ClearSearchButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" Background="Transparent" CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#E0F0FA"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- No-results message (shown when filter matches nothing) -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="No notes match your search."
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"
                                   Foreground="#A0B8C8"
                                   FontStyle="Italic"
                                   FontSize="12"
                                   Visibility="{Binding HasNoFilterResults, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock DockPanel.Dock="Top"
                                   Text="This folder is empty. Select + New to create a note."
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="16,20,16,0"
                                   Foreground="#A0B8C8"
                                   FontStyle="Italic"
                                   FontSize="12"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasNoNotes, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- File list -->
                        <ListBox x:Name="FileList"
                                 Foreground="#333333"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 SelectionChanged="FileList_SelectionChanged"
                                 KeyDown="FileList_KeyDown"
                                 ContextMenuOpening="FileList_ContextMenuOpening"
                                 MinHeight="60"
                                 VerticalAlignment="Stretch"
                                 DockPanel.Dock="Bottom"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 Margin="0,0,4,0">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="OpenNoteMenuItem"
                                                  Header="Open"
                                                  Click="OpenSelectedNote_Click"
                                                  InputGestureText="Enter"
                                                  ToolTip="Open this note (Enter)">
                                            <MenuItem.Icon>
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" FontSize="14" Foreground="#2C6E91"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="OpenFolderMenuItem"
                                                  Header="Open Folder"
                                                  Click="OpenFolderMenuItem_Click"
                                                  InputGestureText="Enter"
                                                  ToolTip="Navigate into this folder (Enter)">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2C6E91"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="RenameMenuItem"
                                                  Header="Rename"
                                                  Click="RenameNote_Click"
                                                  InputGestureText="F2"
                                                  ToolTip="Rename (F2)">
                                            <MenuItem.Icon>
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8AC;" FontSize="14" Foreground="#2C6E91"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="CopyNameMenuItem"
                                                  Header="Copy Name"
                                                  Click="CopyNoteName_Click"
                                                  InputGestureText="Ctrl+C"
                                                  ToolTip="Copy name to clipboard">
                                            <MenuItem.Icon>
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="14" Foreground="#2C6E91"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator x:Name="DeleteSeparator"/>
                                        <MenuItem x:Name="DeleteMenuItem"
                                                  Header="Delete"
                                                  Click="DeleteNoteButton_Click"
                                                  InputGestureText="Del"
                                                  ToolTip="Delete (Del)">
                                            <MenuItem.Icon>
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="14" Foreground="#2C6E91"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem x:Name="NewFolderMenuItem"
                                                  Header="New Folder"
                                                  Click="NewFolderMenuItem_Click"
                                                  ToolTip="Create a new subfolder here">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2C6E91"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="32" Margin="{Binding IndentLevel, Converter={StaticResource IndentLevelToMarginConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*" MinWidth="50"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Pin / folder-icon column -->
                                            <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <!-- Pin button – hidden for folder rows via last DataTrigger -->
                                                <Button Width="16" Height="16" Padding="1" Margin="-6,0,0,0"
                                                        FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                        Content="&#xE718;"
                                                        ToolTip="Pin note"
                                                        AutomationProperties.Name="Pin note"
                                                        Foreground="#C9302C"
                                                        Cursor="Hand"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="1"
                                                        Click="PinNoteButton_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Opacity" Value="0.8"/>
                                                                </DataTrigger>
                                                                <!-- Must be last – overrides hover/pin triggers for folder items -->
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <!-- Child notes in expanded folders cannot be pinned -->
                                                                <DataTrigger Binding="{Binding IndentLevel}" Value="1">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <!-- Folder icon – visible only for folder rows; icon changes when expanded -->
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           Foreground="#5BA8C8"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           Margin="-6,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE8B7;"/>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE8DA;"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <!-- Note display column -->
                                            <Grid Grid.Column="1" Margin="0,0,8,0">
                                                <StackPanel x:Name="DisplayPanel">
                                                    <TextBlock x:Name="DisplayTextBlock"
                                                               Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayName}"/>
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="#7A93A0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Subtitle}"
                                                               Visibility="{Binding DataContext.ShowModifiedSubtitle, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                                <TextBox x:Name="EditTextBox" 
                                                         Text="{Binding EditableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="Collapsed"
                                                         Padding="2"
                                                         Background="White"
                                                         BorderBrush="#5BA8C8"
                                                         BorderThickness="1"
                                                         KeyDown="RenameTextBox_KeyDown"
                                                         LostFocus="RenameTextBox_LostFocus"/>
                                            </Grid>
                                            <!-- Action buttons column -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <!-- Child notes (in expanded folders) are read-only; suppress all action buttons -->
                                                            <DataTrigger Binding="{Binding IndentLevel}" Value="1">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Content="Rename"
                                                        Click="RenameNote_Click"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="#2C6E91"
                                                        Cursor="Hand"
                                                        Background="Transparent"
                                                        BorderBrush="#9EC7DB"
                                                        BorderThickness="1"
                                                        MinWidth="40"
                                                        Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=ActualWidth, Converter={StaticResource WidthToActionButtonVisibilityConverter}, ConverterParameter=rename}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bg"
                                                                    Background="#EFF7FB"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bg" Property="Background" Value="#DCEEF8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Click="DeleteNoteButton_Click"
                                                        Width="24"
                                                        Height="24"
                                                        Margin="6,0,0,0"
                                                        Padding="0"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="13"
                                                        Content="&#xE74D;"
                                                        ToolTip="Delete note"
                                                        AutomationProperties.Name="Delete"
                                                        Foreground="#C9302C"
                                                        Cursor="Hand"
                                                        Background="Transparent"
                                                        BorderBrush="#E8B2AF"
                                                        BorderThickness="1"
                                                        Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=ActualWidth, Converter={StaticResource WidthToActionButtonVisibilityConverter}, ConverterParameter=delete}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bg"
                                                                    Background="#FFF4F3"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bg" Property="Background" Value="#FCE2E0"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter TargetName="DisplayPanel" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="EditTextBox" Property="Visibility" Value="Visible"/>
                                                <!-- Action buttons will be hidden by the DataContext logic if needed -->
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,7"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ListBoxItem_MouseLeftButtonUp"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#E0F0FA"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#C4E2F2"/>
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#5BA8C8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                    </DockPanel>

                        <DockPanel x:Name="SettingsView" Margin="0,4,0,0">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="User Settings"
                                           Grid.Column="0"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#2C6E91"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0"
                                           />

                                <Button x:Name="BackToNotesButton"
                                        Grid.Column="1"
                                        Content="Back"
                                        Click="BackToNotesButton_Click"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Cursor="Hand"
                                        Padding="18,6"
                                        Background="#2C6E91"
                                        BorderThickness="0"
                                        Margin="8,0,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg"
                                                    Background="#2C6E91"
                                                    CornerRadius="16"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE72B;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center"/>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#1B4F6B"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#153B4F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <ScrollViewer DockPanel.Dock="Bottom"
                                          VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                            <Border Background="#EFF7FB"
                                    BorderBrush="#C9DFEC"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="New Note Behavior"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#355A6E"
                                               Margin="0,0,0,8"/>
                                    <RadioButton x:Name="NewNotePromptOption"
                                                 GroupName="NewNoteBehavior"
                                                 Margin="0,0,0,6"
                                                 Checked="NewNoteMode_Changed"
                                                 HorizontalAlignment="Stretch">
                                        <TextBlock Text="Always ask for note name"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </RadioButton>
                                    <RadioButton x:Name="NewNoteQuickOption"
                                                 GroupName="NewNoteBehavior"
                                                 Margin="0,0,0,6"
                                                 Checked="NewNoteMode_Changed"
                                                 HorizontalAlignment="Stretch">
                                        <TextBlock Text="Always create quick note"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </RadioButton>
                                    <RadioButton x:Name="NewNoteBothOption"
                                                 GroupName="NewNoteBehavior"
                                                 Margin="0,0,0,0"
                                                 Checked="NewNoteMode_Changed"
                                                 HorizontalAlignment="Stretch">
                                        <TextBlock Text="Show both buttons (let me choose)"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </RadioButton>
                                    <CheckBox x:Name="ShowModifiedSubtitleOption"
                                            Foreground="#355A6E"
                                            FontWeight="SemiBold"
                                            Margin="0,12,0,0"
                                            Checked="ShowModifiedSubtitleOption_Changed"
                                            Unchecked="ShowModifiedSubtitleOption_Changed"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock Text="Show 'Modified' timestamp in note subtitle"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <Border Background="#EFF7FB"
                                    BorderBrush="#C9DFEC"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Folder Navigation"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#355A6E"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="How clicking a folder opens it"
                                               FontSize="11"
                                               Foreground="#5F7480"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <RadioButton x:Name="FolderNavDrillDownOption"
                                                 GroupName="FolderNavigation"
                                                 Margin="0,0,0,6"
                                                 Checked="FolderNavOption_Checked"
                                                 HorizontalAlignment="Stretch">
                                        <TextBlock Text="Navigate into folder (drill-down)"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </RadioButton>
                                    <RadioButton x:Name="FolderNavExpandOption"
                                                 GroupName="FolderNavigation"
                                                 Checked="FolderNavOption_Checked"
                                                 HorizontalAlignment="Stretch">
                                        <TextBlock Text="Expand folder inline (tree view)"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <Border Background="#EFF7FB"
                                    BorderBrush="#C9DFEC"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Startup"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#355A6E"
                                               Margin="0,0,0,8"/>
                                    <CheckBox x:Name="RunOnStartupOption"
                                            Foreground="#355A6E"
                                            FontWeight="SemiBold"
                                            Checked="RunOnStartupOption_Changed"
                                            Unchecked="RunOnStartupOption_Changed"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock Text="Launch Noted automatically when Windows starts"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <Border Background="#EFF7FB"
                                    BorderBrush="#C9DFEC"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Window Behavior"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#355A6E"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Choose whether Hide also hides all auxiliary windows"
                                               FontSize="11"
                                               Foreground="#5F7480"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Open Noted on"
                                               FontSize="11"
                                               Foreground="#5F7480"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="PreferredDisplayCombo"
                                              Margin="0,0,0,12"
                                              MinHeight="28"
                                              DisplayMemberPath="Label"
                                              SelectionChanged="PreferredDisplayCombo_SelectionChanged"/>
                                    <CheckBox x:Name="HideButtonHidesAllOption"
                                            Foreground="#355A6E"
                                            FontWeight="SemiBold"
                                            Checked="HideButtonHidesAllOption_Changed"
                                            Unchecked="HideButtonHidesAllOption_Changed"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock Text="Hide auxiliary windows when hiding notes"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <Border Background="#EFF7FB"
                                    BorderBrush="#C9DFEC"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Ghost Mode"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#355A6E"
                                               Margin="0,0,0,8"/>

                                    <!-- Default opacity (always active) -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Default opacity"
                                                   Grid.Column="0"
                                                   FontSize="11"
                                                   Foreground="#5F7480"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DefaultOpacityLabel"
                                                   Grid.Column="1"
                                                   Text="88%"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2C6E91"
                                                   VerticalAlignment="Center"
                                                   MinWidth="32"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="DefaultOpacitySlider"
                                            Minimum="5"
                                            Maximum="100"
                                            Value="95"
                                            SmallChange="1"
                                            LargeChange="1"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="False"
                                            Margin="0,0,0,14"/>

                                    <!-- Ghost mode toggle -->
                                    <CheckBox x:Name="GhostModeOption"
                                            Foreground="#355A6E"
                                            FontWeight="SemiBold"
                                            Checked="GhostModeOption_Changed"
                                            Unchecked="GhostModeOption_Changed"
                                            Margin="0,0,0,10"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock Text="Semi-transparent when not hovered"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </CheckBox>

                                    <!-- Ghost opacity (disabled when ghost mode is off) -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ghost opacity"
                                                   Grid.Column="0"
                                                   FontSize="11"
                                                   Foreground="#5F7480"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="GhostModeOpacityLabel"
                                                   Grid.Column="1"
                                                   Text="25%"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2C6E91"
                                                   VerticalAlignment="Center"
                                                   MinWidth="32"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="GhostModeOpacitySlider"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="75"
                                            SmallChange="1"
                                            LargeChange="1"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="False"
                                            IsEnabled="{Binding ElementName=GhostModeOption, Path=IsChecked}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#EFF7FB"
                                    BorderBrush="#C9DFEC"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="New Note Timestamp"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                              Foreground="#355A6E"
                                               Margin="0,0,0,8"/>
                                    <RadioButton x:Name="TimestampNoneOption"
                                                 GroupName="TimestampPlacement"
                                                 Margin="0,0,0,6"
                                                 Checked="TimestampPlacementOption_Checked"
                                                 HorizontalAlignment="Stretch">
                                        <TextBlock Text="No timestamp"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </RadioButton>
                                    <RadioButton x:Name="TimestampTopOption"
                                                 GroupName="TimestampPlacement"
                                                 Margin="0,0,0,6"
                                                 Checked="TimestampPlacementOption_Checked"
                                                 HorizontalAlignment="Stretch">
                                        <TextBlock Text="Add timestamp to top of page"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </RadioButton>
                                    <RadioButton x:Name="TimestampBottomOption"
                                                 GroupName="TimestampPlacement"
                                                 Checked="TimestampPlacementOption_Checked"
                                                 HorizontalAlignment="Stretch">
                                        <TextBlock Text="Add timestamp to bottom of page"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <Border Background="#EFF7FB"
                                    BorderBrush="#C9DFEC"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Notes Folder"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#355A6E"
                                                   Margin="0,0,8,0"/>
                                        <Button x:Name="ShowHideNotesDirectoryButton"
                                                Content="Show Folder"
                                                Click="ShowHideNotesDirectoryButton_Click"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="#2C6E91"
                                                Cursor="Hand"
                                                Padding="6,2"
                                                Margin="0,0,0,0"
                                                Background="Transparent"
                                                BorderBrush="#9EC7DB"
                                                BorderThickness="1"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SettingsNotesDirectoryText"
                                               FontSize="11"
                                               Foreground="#5F7480"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,10"
                                               Visibility="{Binding ShowNotesDirectory, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button x:Name="ChangeFolderButton"
                                            Content="Change Folder"
                                            Click="ChangeFolderButton_Click"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="#2C6E91"
                                            Cursor="Hand"
                                            Padding="8,3"
                                            HorizontalAlignment="Left"
                                            Background="Transparent"
                                            BorderBrush="#9EC7DB"
                                            BorderThickness="1">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg"
                                                        Background="#EFF7FB"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#DCEEF8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Background="#EFF7FB"
                                    BorderBrush="#C9DFEC"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Global Hotkey"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#355A6E"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Activate notes panel with a keyboard shortcut"
                                               FontSize="11"
                                               Foreground="#5F7480"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Current: "
                                                   Grid.Column="0"
                                                   Foreground="#5F7480"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock x:Name="CurrentHotkeyDisplay"
                                                   Grid.Column="1"
                                                   Foreground="#2C6E91"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"
                                                   MinWidth="80"
                                                   TextAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Select Modifiers"
                                                   FontSize="10"
                                                   Foreground="#5F7480"
                                                   Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <CheckBox x:Name="ModifierCtrl" Content="Ctrl" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <CheckBox x:Name="ModifierAlt" Content="Alt" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <CheckBox x:Name="ModifierShift" Content="Shift" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <CheckBox x:Name="ModifierWin" Content="Win" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <TextBlock Text="Select Key"
                                                   FontSize="10"
                                                   Foreground="#5F7480"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox x:Name="HotkeyKeyCombo"
                                                  Foreground="#355A6E"
                                                  Background="#FFFFFF"
                                                  BorderBrush="#C9DFEC"
                                                  BorderThickness="1"
                                                  Padding="8,6"
                                                  FontSize="11"
                                                  Margin="0,0,0,12"/>
                                        
                                        <TextBlock Text="Preview"
                                                   FontSize="10"
                                                   Foreground="#5F7480"
                                                   Margin="0,0,0,4"/>
                                        <Border BorderBrush="#C9DFEC"
                                                BorderThickness="1"
                                                Background="#FFFFFF"
                                                Padding="8,6"
                                                Margin="0,0,0,8">
                                            <TextBlock x:Name="HotkeyPreview"
                                                       Text="(Select modifiers and key)"
                                                       FontSize="11"
                                                       Foreground="#355A6E"/>
                                        </Border>
                                    </StackPanel>
                                    <Button x:Name="ApplyHotkeyButton"
                                            Content="Apply Hotkey"
                                            Click="ApplyHotkeyButton_Click"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="#2C6E91"
                                            Cursor="Hand"
                                            Padding="8,3"
                                            HorizontalAlignment="Left"
                                            Background="Transparent"
                                            BorderBrush="#9EC7DB"
                                            BorderThickness="1">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg"
                                                        Background="#EFF7FB"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#DCEEF8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>

                            </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                </Grid>
                </DockPanel>

                <Thumb x:Name="NotesPanelResizeThumb"
                       Width="18"
                       Height="18"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,1,1"
                       Cursor="SizeNWSE"
                       DragDelta="NotesPanelResizeThumb_DragDelta">
                    <!-- Always show the resize thumb, even at minimum width -->
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent">
                                <Grid HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,2,2">
                                    <Path Data="M 0 10 L 10 0 M 4 10 L 10 4 M 8 10 L 10 8"
                                          Stroke="#6E90A5"
                                          StrokeThickness="1.2"
                                          SnapsToDevicePixels="True"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>

        <Button x:Name="OverlayButton"
                Content="Notes"
            Width="96" Height="48"
                Canvas.Right="20" Canvas.Bottom="20"
                FontSize="16" FontWeight="SemiBold"
            Foreground="White">

            <Button.Background>
                <SolidColorBrush Color="#87CEEB" Opacity="0.45"/>
            </Button.Background>

            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="12"
                                        Opacity="{TemplateBinding Opacity}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#A0D8F0" Opacity="0.70"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#B0E0F6" Opacity="0.85"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

    </Canvas>
</Window>
