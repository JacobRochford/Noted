<noted:OverlayWindow x:Class="Noted.DictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:noted="clr-namespace:Noted"
        xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Dictionary"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="400"
        Height="500"
        Left="200"
        Top="150"
        MinWidth="300"
        MinHeight="350">
    <Grid Background="#FFFFFF" OpacityMask="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Resize Thumb in bottom-right corner -->
        <Primitives:Thumb x:Name="ResizeThumb"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Width="20"
                          Height="20"
                          Cursor="SizeNWSE"
                          Background="Transparent"
                          Opacity="0"
                          DragDelta="ResizeThumb_DragDelta"
                          Grid.Row="0"
                          Grid.RowSpan="3"
                          Panel.ZIndex="999"
                          Margin="0,0,-2,-2"/>

        <!-- Title Bar -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="10,8" Cursor="Hand">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Dictionary" FontSize="14" FontWeight="SemiBold" Foreground="#333333" IsHitTestVisible="False"/>
                <Button Grid.Column="1" x:Name="HideButton" Content="✕" Click="HideButton_Click"
                        Background="Transparent" BorderThickness="0" Foreground="#999999"
                        FontSize="14" Padding="4,0" Margin="8,0,0,0" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" Width="20" Height="20" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Items List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}" Padding="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="6" Margin="0,0,0,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top row: word | view | delete -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Word -->
                                    <TextBox Grid.Column="0"
                                       Text="{Binding Word, UpdateSourceTrigger=LostFocus}"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       Padding="4,2"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       VerticalAlignment="Center"/>

                                    <!-- Small inline description toggle (right side) -->
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <Hyperlink Click="DescriptionLink_Click" Tag="{Binding}">
                                          <Run Foreground="#0066CC" FontSize="12">Toggle Definition</Run>
                                        </Hyperlink>
                                    </TextBlock>

                                    <!-- Delete -->
                                    <Button Grid.Column="2" Content="✕" Click="DeleteButton_Click"
                                      Background="Transparent" BorderThickness="0" Foreground="#999999"
                                      FontSize="12" Padding="4,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                      HorizontalContentAlignment="Center" Width="22" Height="22"/>
                                </Grid>

                                <!-- Collapsible description (keeps small min height) -->
                                <TextBox x:Name="DescriptionBox"
                                     Grid.Row="1"
                                     Text="{Binding Description, UpdateSourceTrigger=LostFocus}"
                                     Background="#F8F8F8"
                                     BorderBrush="#E0E0E0"
                                     BorderThickness="1"
                                     Padding="6,4"
                                     FontSize="12"
                                     Foreground="#555555"
                                     VerticalAlignment="Top"
                                     MinHeight="40"
                                     MaxHeight="120"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Margin="0,6,0,0"
                                     Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#F8F8F8" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ghost Mode Toggle -->
                <CheckBox Grid.Column="1" Content="Ghost" Margin="4,0" VerticalAlignment="Center"
                          IsChecked="{Binding GhostModeEnabled, Mode=TwoWay}"/>

                <!-- Add Button -->
                <Button Grid.Column="2" Content="+ Add" Click="AddButton_Click"
                        Background="#E8F4F8" BorderThickness="1" BorderBrush="#91C5DE" Foreground="#0066CC"
                        Padding="8,4" Margin="4,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>

                <!-- Resize Grip Indicator -->
                <TextBlock Text="◢" Foreground="#D0D0D0" FontSize="10"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,2,1" IsHitTestVisible="False" Grid.ColumnSpan="3"/>
            </Grid>
        </Border>
    </Grid>
</noted:OverlayWindow>
