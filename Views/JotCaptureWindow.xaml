<Window x:Class="Noted.JotCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jot" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        Width="480" SizeToContent="Height" MaxHeight="560">
    <Border Background="{DynamicResource NotedSurfaceBrush}" BorderBrush="{DynamicResource NotedBorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="Open Jots" Click="OpenJots_Click"
                        Style="{StaticResource NotedSecondaryButton}"/>
                <TextBlock Text="Jot" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource NotedTextBrush}"/>
            </DockPanel>
            <TextBlock Text="Title (optional)" Margin="0,0,0,4"
                       Foreground="{DynamicResource NotedMutedTextBrush}"/>
            <TextBox x:Name="TitleTextBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}" Margin="0,0,0,8"
                     AutomationProperties.Name="Title (optional)" Style="{StaticResource NotedTextInput}"/>
            <TextBlock Text="Category (optional)" Margin="0,0,0,4"
                       Foreground="{DynamicResource NotedMutedTextBrush}"/>
            <ComboBox x:Name="CategoryComboBox" IsEditable="True" IsTextSearchEnabled="False"
                      IsReadOnly="{Binding IsReadOnly}" ItemsSource="{Binding Categories}"
                      Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                      PreviewGotKeyboardFocus="CategoryComboBox_PreviewGotKeyboardFocus"
                      DropDownOpened="CategoryComboBox_DropDownOpened"
                      AutomationProperties.Name="Category (optional)">
                <ComboBox.Style>
                    <Style TargetType="ComboBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>
            <TextBlock Text="Leave blank for Inbox. Select a category or type a new name."
                       Margin="0,4,0,8" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource NotedMutedTextBrush}"/>
            <TextBox x:Name="CaptureTextBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}"
                     AutomationProperties.Name="Capture a thought" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="70" MaxHeight="280" VerticalScrollBarVisibility="Auto"
                     FontSize="14" Style="{StaticResource NotedTextInput}"/>
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource NotedWarningBrush}"/>
            <TextBlock Text="Enter save · Shift+Enter newline · Esc hide" Margin="0,8,0,0"
                       FontSize="11" Foreground="{DynamicResource NotedMutedTextBrush}"/>
        </StackPanel>
    </Border>
</Window>
