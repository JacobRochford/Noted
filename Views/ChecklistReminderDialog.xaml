<Window x:Class="Noted.ChecklistReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:noted="clr-namespace:Noted" xmlns:m="clr-namespace:Noted.Models"
        Title="Schedule task" Width="520" Height="480" MinHeight="350" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource NotedSurfaceBrush}" Foreground="{DynamicResource NotedTextBrush}">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource NotedTextInput}"/>
        <Style TargetType="Button" BasedOn="{StaticResource NotedSecondaryButton}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource NotedCheckBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource NotedComboBox}"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource NotedScrollBar}"/>
        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="{DynamicResource NotedInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NotedTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotedBorderBrush}"/>
        </Style>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="{DynamicResource NotedInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NotedTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource NotedTextBrush}"/>
        </Style>
        <Style TargetType="Calendar">
            <Setter Property="Background" Value="{DynamicResource NotedSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NotedTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotedStrongBorderBrush}"/>
        </Style>
        <Style TargetType="CalendarDayButton" BasedOn="{StaticResource NotedCalendarDayButton}"/>
        <Style TargetType="CalendarButton" BasedOn="{StaticResource NotedCalendarButton}"/>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,10,0,0"
                       Foreground="{DynamicResource NotedDangerBrush}" AutomationProperties.LiveSetting="Assertive"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" Padding="12,7"/>
                <Button x:Name="ApplyButton" Content="Apply" Padding="12,7" Style="{StaticResource NotedPrimaryButton}" Click="Apply_Click"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>
                <TextBlock Text="Schedule task" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <WrapPanel Margin="0,0,0,12">
                    <Button x:Name="QuickToday" Tag="today" Click="QuickDate_Click" Margin="0,0,8,4"/>
                    <Button x:Name="QuickTomorrow" Tag="tomorrow" Click="QuickDate_Click" Margin="0,0,8,4"/>
                    <Button x:Name="QuickNextWeek" Tag="next-week" Click="QuickDate_Click" Margin="0,0,0,4"/>
                </WrapPanel>
                <TextBlock Text="Due date (optional)" Margin="0,0,0,4"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Clear" Margin="8,0,0,0" Click="ClearDue_Click"/>
                    <DatePicker x:Name="DueDate" AutomationProperties.Name="Due date" SelectedDateChanged="DueDate_Changed"/>
                </DockPanel>
                <noted:ChecklistTimePicker x:Name="DueTime" Margin="0,8,0,0" SelectedTimeChanged="DueTime_Changed"/>
                <TextBlock Text="Times use your local time zone. A due date alone does not send a notification."
                           TextWrapping="Wrap" Foreground="{DynamicResource NotedMutedTextBrush}" Margin="0,8,0,16"/>
                <CheckBox x:Name="EnableReminder" Content="Notify" Checked="ReminderChoice_Changed" Unchecked="ReminderChoice_Changed"/>
                <StackPanel x:Name="ReminderControls" Margin="0,8,0,0">
                    <ComboBox x:Name="ReminderMode" SelectedIndex="0" SelectionChanged="ReminderMode_Changed" AutomationProperties.Name="When to remind">
                        <ComboBoxItem Content="At due time"/><ComboBoxItem Content="Custom notification time"/>
                    </ComboBox>
                    <StackPanel x:Name="ReminderFields" Margin="0,12,0,0">
                        <TextBlock Text="Notification date and time" Margin="0,0,0,4"/>
                        <DatePicker x:Name="ReminderDate" AutomationProperties.Name="Notification date"/>
                        <noted:ChecklistTimePicker x:Name="ReminderTime" AllowEmpty="False" Margin="0,8,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Style" Margin="0,16,0,4"/>
                    <ComboBox x:Name="StyleChoice" SelectedIndex="0" SelectedValuePath="Tag" AutomationProperties.Name="Notification style">
                        <ComboBoxItem Content="Standard Windows" Tag="{x:Static m:ChecklistNotificationStyle.Standard}"/><ComboBoxItem Content="Persistent Windows" Tag="{x:Static m:ChecklistNotificationStyle.Persistent}"/><ComboBoxItem Content="Urgent Noted" Tag="{x:Static m:ChecklistNotificationStyle.Urgent}"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Notification options..." Click="Customize_Click" Padding="10,5"/>
                        <Button x:Name="ResetOptions" Content="Reset" Click="ResetOptions_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="OptionsSummary" Text="Using defaults" Foreground="{DynamicResource NotedMutedTextBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
