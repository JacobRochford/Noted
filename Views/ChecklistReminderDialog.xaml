<noted:ChecklistEditorWindow x:Class="Noted.ChecklistReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:noted="clr-namespace:Noted" xmlns:m="clr-namespace:Noted.Models"
        Title="Schedule task" Width="520" MinWidth="400" MinHeight="280" SizeToContent="Height"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{DynamicResource NotedSurfaceBrush}" Foreground="{DynamicResource NotedTextBrush}">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource NotedTextInput}"/>
        <Style TargetType="Button" BasedOn="{StaticResource NotedSecondaryButton}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource NotedCheckBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource NotedComboBox}"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource NotedScrollBar}"/>
        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="{DynamicResource NotedInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NotedTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotedBorderBrush}"/>
        </Style>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="{DynamicResource NotedInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NotedTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource NotedTextBrush}"/>
        </Style>
        <Style TargetType="Calendar">
            <Setter Property="Background" Value="{DynamicResource NotedSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NotedTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotedStrongBorderBrush}"/>
        </Style>
        <Style TargetType="CalendarDayButton" BasedOn="{StaticResource NotedCalendarDayButton}"/>
        <Style TargetType="CalendarButton" BasedOn="{StaticResource NotedCalendarButton}"/>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,10,0,0"
                       Foreground="{DynamicResource NotedDangerBrush}" AutomationProperties.LiveSetting="Assertive"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" Padding="12,7"/>
                <Button x:Name="ApplyButton" Content="Apply" Padding="12,7" Style="{StaticResource NotedPrimaryButton}" Click="Apply_Click"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer x:Name="ScheduleFields" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <WrapPanel Margin="0,0,0,6">
                    <Button x:Name="QuickToday" Tag="today" Click="QuickDate_Click" Margin="0,0,8,4"/>
                    <Button x:Name="QuickTomorrow" Tag="tomorrow" Click="QuickDate_Click" Margin="0,0,8,4"/>
                    <Button x:Name="QuickNextWeek" Tag="next-week" Click="QuickDate_Click" Margin="0,0,0,4"/>
                </WrapPanel>
                <TextBlock Text="Due date (optional)" Margin="0,0,0,4"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Clear" Margin="8,0,0,0" Click="ClearDue_Click"/>
                    <DatePicker x:Name="DueDate" AutomationProperties.Name="Due date" SelectedDateChanged="DueDate_Changed"/>
                </DockPanel>
                <noted:ChecklistTimePicker x:Name="DueTime" Margin="0,8,0,0" SelectedTimeChanged="DueTime_Changed"/>
                <CheckBox x:Name="EnableReminder" Content="Remind me" Margin="0,12,0,0"
                          Checked="ReminderChoice_Changed" Unchecked="ReminderChoice_Changed"/>
                <StackPanel x:Name="ReminderControls" Margin="0,8,0,0">
                    <TextBlock Text="When" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ReminderMode" SelectedIndex="0" SelectionChanged="ReminderMode_Changed" AutomationProperties.Name="When to remind">
                        <ComboBoxItem Content="At due time"/><ComboBoxItem Content="Custom date and time"/>
                    </ComboBox>
                    <StackPanel x:Name="ReminderFields" Margin="0,8,0,0">
                        <DatePicker x:Name="ReminderDate" AutomationProperties.Name="Notification date"/>
                        <noted:ChecklistTimePicker x:Name="ReminderTime" AllowEmpty="False" Margin="0,8,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Style" Margin="0,10,0,4"/>
                    <WrapPanel>
                        <ComboBox x:Name="StyleChoice" SelectedIndex="0" SelectedValuePath="Tag" AutomationProperties.Name="Notification style"
                                  SelectionChanged="RepeatChoice_Changed">
                            <ComboBoxItem Content="Standard Windows" Tag="{x:Static m:ChecklistNotificationStyle.Standard}"/>
                            <ComboBoxItem Content="Persistent Windows" Tag="{x:Static m:ChecklistNotificationStyle.Persistent}"/>
                            <ComboBoxItem Content="Urgent Noted" Tag="{x:Static m:ChecklistNotificationStyle.Urgent}"/>
                        </ComboBox>
                        <Button x:Name="OptionsButton" Content="Options…" AutomationProperties.Name="Notification options"
                                Click="Customize_Click" Padding="10,5" Margin="8,0,0,0"/>
                        <Button x:Name="ResetOptions" Content="Reset" AutomationProperties.Name="Reset notification options"
                                Click="ResetOptions_Click" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <StackPanel x:Name="RepeatControls" Margin="0,10,0,0" Visibility="Collapsed">
                        <CheckBox x:Name="EnableRepeat" Content="Remind again" Checked="RepeatChoice_Changed" Unchecked="RepeatChoice_Changed"/>
                        <StackPanel x:Name="RepeatFields" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock Text="Repeat interval" Margin="0,0,0,4"/>
                            <ComboBox x:Name="RepeatInterval" AutomationProperties.Name="Repeat interval" SelectionChanged="RepeatChoice_Changed"/>
                            <StackPanel x:Name="CustomRepeatFields" Margin="0,6,0,0">
                                <TextBlock Text="Custom interval in minutes (1 to 1,440)" Margin="0,0,0,4"/>
                                <TextBox x:Name="CustomRepeatMinutes" Width="90" HorizontalAlignment="Left"
                                         AutomationProperties.Name="Custom repeat interval in minutes"/>
                            </StackPanel>
                            <TextBlock Text="Stop repeating" Margin="0,8,0,4"/>
                            <ComboBox x:Name="RepeatStop" SelectedIndex="0" AutomationProperties.Name="Stop repeating"
                                      SelectionChanged="RepeatChoice_Changed">
                                <ComboBoxItem Content="Until completed or turned off"/>
                                <ComboBoxItem Content="After a set number of additional alerts"/>
                            </ComboBox>
                            <StackPanel x:Name="RepeatLimitFields" Margin="0,6,0,0">
                                <TextBlock Text="Alerts after the first reminder (1 to 10)" Margin="0,0,0,4"/>
                                <TextBox x:Name="RepeatLimit" Text="1" Width="90" HorizontalAlignment="Left"
                                         AutomationProperties.Name="Number of additional alerts"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</noted:ChecklistEditorWindow>
