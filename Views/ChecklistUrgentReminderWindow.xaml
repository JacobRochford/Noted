<Window x:Class="Noted.ChecklistUrgentReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Urgent task reminders" Width="900" Height="650"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource NotedSurfaceBrush}" Foreground="{DynamicResource NotedTextBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource NotedTextInput}"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource NotedScrollBar}"/>
        <Style x:Key="UrgentSecondaryButton" TargetType="Button" BasedOn="{StaticResource NotedSecondaryButton}">
            <Setter Property="FontSize" Value="{DynamicResource UrgentReminderDetailsSize}"/>
            <Setter Property="MinHeight" Value="{DynamicResource UrgentReminderActionHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource UrgentReminderActionPadding}"/>
        </Style>
        <Style x:Key="UrgentPrimaryButton" TargetType="Button" BasedOn="{StaticResource NotedPrimaryButton}">
            <Setter Property="FontSize" Value="{DynamicResource UrgentReminderDetailsSize}"/>
            <Setter Property="MinHeight" Value="{DynamicResource UrgentReminderActionHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource UrgentReminderActionPadding}"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource NotedAccentBrush}" BorderThickness="4" Padding="24">
        <Grid>
            <Border x:Name="PulseAccent" BorderBrush="{DynamicResource NotedAccentBrush}" BorderThickness="4"
                    Margin="-24" Panel.ZIndex="10" IsHitTestVisible="False"/>
            <Grid x:Name="DetailsPanel" VerticalAlignment="Center" TextElement.FontSize="{DynamicResource UrgentReminderDetailsSize}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,12">
                    <TextBlock x:Name="Heading" Text="{Binding Summary}" FontSize="{DynamicResource UrgentReminderHeadingSize}"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,8"
                               Focusable="True" AutomationProperties.LiveSetting="Assertive" TextWrapping="Wrap"/>
                    <Button Content="Show smaller" Margin="0,0,8,8" Style="{StaticResource UrgentSecondaryButton}" Click="ShowSmaller_Click"/>
                    <Button Content="Stop preview" Margin="0,0,8,8" Style="{StaticResource UrgentSecondaryButton}"
                            Visibility="{Binding IsPreview, Converter={StaticResource BoolVisibility}}" Click="StopPreview_Click"/>
                </WrapPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border BorderBrush="{DynamicResource NotedBorderBrush}" BorderThickness="1"
                                        Padding="{DynamicResource UrgentReminderCardPadding}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource UrgentReminderTitleSize}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Tab.Name}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ScheduledText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding OverdueText}" FontWeight="SemiBold" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                        <ScrollViewer MaxHeight="{DynamicResource UrgentReminderNotesHeight}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock Text="{Binding Item.Notes}" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                        <WrapPanel Margin="0,20,0,0">
                                            <Button Content="Open task" VerticalAlignment="Top" Margin="0,0,12,8"
                                                    Style="{StaticResource UrgentSecondaryButton}" Click="OpenTask_Click"/>
                                            <Button Content="{Binding SilenceText}" VerticalAlignment="Top" Margin="0,0,12,8" Click="Silence_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource UrgentSecondaryButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSilenced}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <StackPanel Visibility="{Binding UsesHold, Converter={StaticResource BoolVisibility}}" Margin="0,0,12,8">
                                                <Button Style="{StaticResource UrgentPrimaryButton}"
                                                        PreviewMouseLeftButtonDown="HoldMouseDown" PreviewMouseLeftButtonUp="HoldMouseUp"
                                                        PreviewKeyDown="HoldKeyDown" PreviewKeyUp="HoldKeyUp" LostMouseCapture="HoldCaptureLost" LostKeyboardFocus="HoldFocusLost"
                                                        Content="{Binding HoldText}"/>
                                                <ProgressBar Maximum="1" Value="{Binding HoldProgress, Mode=OneWay}" Height="5" Margin="0,6,0,0"
                                                             AutomationProperties.Name="Acknowledgment hold progress"/>
                                            </StackPanel>
                                            <Button Content="Acknowledge" Visibility="{Binding UsesButton, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"
                                                    Style="{StaticResource UrgentPrimaryButton}" Click="Acknowledge_Click"
                                                    AutomationProperties.HelpText="Acknowledges this reminder without completing the task."/>
                                        </WrapPanel>
                                        <StackPanel Visibility="{Binding UsesCode, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding ConfirmationPrompt}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                            <WrapPanel>
                                                <TextBox Text="{Binding ConfirmationInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" KeyDown="Confirmation_KeyDown"
                                                         FontSize="{DynamicResource UrgentReminderDetailsSize}" MinHeight="{DynamicResource UrgentReminderActionHeight}"
                                                         Width="120" Padding="8" Margin="0,0,12,8" AutomationProperties.Name="{Binding ConfirmationPrompt}"/>
                                                <Button Content="Confirm code" Style="{StaticResource UrgentPrimaryButton}" Margin="0,0,0,8" Click="Acknowledge_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="Acknowledging a reminder does not complete its task." TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource NotedDangerBrush}" AutomationProperties.LiveSetting="Assertive"/>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="CompactPanel" Visibility="Collapsed">
                <TextBlock Text="{Binding Summary}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="These reminders still need acknowledgment." TextWrapping="Wrap" Margin="0,8"/>
                <Button Content="Stop preview" Visibility="{Binding IsPreview, Converter={StaticResource BoolVisibility}}"
                        Click="StopPreview_Click" Style="{StaticResource NotedSecondaryButton}" Margin="0,0,0,8"/>
                <Button Content="Return to alert" Style="{StaticResource NotedPrimaryButton}" Padding="12,8"
                        HorizontalAlignment="Left" Click="ReturnToAlert_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
