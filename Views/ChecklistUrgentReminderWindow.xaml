<Window x:Class="Noted.ChecklistUrgentReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Urgent Checklist reminders" Width="900" Height="650"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource NotedSurfaceBrush}" Foreground="{DynamicResource NotedTextBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource NotedTextInput}"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource NotedScrollBar}"/>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource NotedAccentBrush}" BorderThickness="4" Padding="24">
        <Grid>
            <Border x:Name="PulseAccent" BorderBrush="{DynamicResource NotedAccentBrush}" BorderThickness="4"
                    Margin="-24" Panel.ZIndex="10" IsHitTestVisible="False"/>
            <Grid x:Name="DetailsPanel" MaxWidth="1040" MaxHeight="900" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,20">
                    <Button DockPanel.Dock="Right" Content="Stop preview" Padding="14,7" Margin="16,0,0,0"
                            Visibility="{Binding IsPreview, Converter={StaticResource BoolVisibility}}"
                            Style="{StaticResource NotedSecondaryButton}" Click="StopPreview_Click"/>
                    <Button DockPanel.Dock="Right" Content="Show smaller" Padding="14,7" Margin="16,0,0,0"
                            Style="{StaticResource NotedSecondaryButton}" Click="ShowSmaller_Click"/>
                    <TextBlock x:Name="Heading" Text="{Binding Summary}" FontSize="30" FontWeight="SemiBold"
                               Focusable="True" AutomationProperties.LiveSetting="Assertive" TextWrapping="Wrap"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

    <Border BorderBrush="{DynamicResource NotedBorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource UrgentReminderTitleSize}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Tab.Name}" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding ScheduledText}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding OverdueText}" FontWeight="SemiBold" Margin="0,4,0,8"/>
                                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding Item.Notes}" FontSize="17" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                        <WrapPanel Margin="0,20,0,0">
                                            <Button Content="Open task" Padding="14,8" VerticalAlignment="Top" Margin="0,0,10,8"
                                                    Style="{StaticResource NotedSecondaryButton}" Click="OpenTask_Click"/>
                                            <Button Content="{Binding SilenceText}" Padding="14,8" VerticalAlignment="Top" Margin="0,0,10,8" Click="Silence_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource NotedSecondaryButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSilenced}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <StackPanel Width="260" Visibility="{Binding UsesCode, Converter={StaticResource BoolVisibility}}" Margin="0,0,10,8">
                                                <TextBlock Text="{Binding ConfirmationPrompt}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding ConfirmationInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" KeyDown="Confirmation_KeyDown"
                                                         MinWidth="120" Padding="8" AutomationProperties.Name="{Binding ConfirmationPrompt}"/>
                                                <Button Content="Confirm code" Padding="14,8" Margin="0,5,0,0"
                                                        Style="{StaticResource NotedPrimaryButton}" Click="Acknowledge_Click"/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding UsesHold, Converter={StaticResource BoolVisibility}}" Margin="0,0,10,8">
                                                <Button Content="{Binding HoldText}" Padding="14,8" Style="{StaticResource NotedPrimaryButton}"
                                                        PreviewMouseLeftButtonDown="HoldMouseDown" PreviewMouseLeftButtonUp="HoldMouseUp"
                                                        PreviewKeyDown="HoldKeyDown" PreviewKeyUp="HoldKeyUp" LostMouseCapture="HoldCaptureLost" LostKeyboardFocus="HoldFocusLost"/>
                                                <ProgressBar Maximum="1" Value="{Binding HoldProgress, Mode=OneWay}" Height="5" Margin="0,6,0,0"
                                                             AutomationProperties.Name="Acknowledgment hold progress"/>
                                            </StackPanel>
                                            <Button Content="Acknowledge" Visibility="{Binding UsesButton, Converter={StaticResource BoolVisibility}}" Padding="14,8" Margin="0,0,0,8"
                                                    Style="{StaticResource NotedPrimaryButton}" Click="Acknowledge_Click"
                                                    AutomationProperties.HelpText="Acknowledges this reminder without completing the task."/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="Acknowledging a reminder does not complete its task." TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource NotedDangerBrush}" AutomationProperties.LiveSetting="Assertive"/>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="CompactPanel" Visibility="Collapsed">
                <TextBlock Text="{Binding Summary}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="These reminders still need acknowledgment." TextWrapping="Wrap" Margin="0,8"/>
                <Button Content="Stop preview" Visibility="{Binding IsPreview, Converter={StaticResource BoolVisibility}}"
                        Click="StopPreview_Click" Style="{StaticResource NotedSecondaryButton}" Margin="0,0,0,8"/>
                <Button Content="Return to alert" Style="{StaticResource NotedPrimaryButton}" Padding="12,8"
                        HorizontalAlignment="Left" Click="ReturnToAlert_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
