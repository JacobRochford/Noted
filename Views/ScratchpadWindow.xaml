<noted:OverlayWindow x:Class="Noted.ScratchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:noted="clr-namespace:Noted"
        xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Scratchpad"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="450"
        Height="500"
        Left="150"
        Top="150"
        MinWidth="300"
        MinHeight="250">

    <noted:OverlayWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#DFF0FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C4E2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#DFF0FA"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#BCD8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </noted:OverlayWindow.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Resize thumb (bottom-right corner) -->
        <Primitives:Thumb x:Name="ResizeThumb"
                          Grid.Row="0" Grid.RowSpan="5"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Width="20" Height="20"
                          Cursor="SizeNWSE"
                          Background="Transparent" Opacity="0"
                          DragDelta="ResizeThumb_DragDelta"
                          DragCompleted="ResizeThumb_DragCompleted"
                          Panel.ZIndex="999"
                          Margin="0,0,-2,-2"/>

        <!-- Title bar -->
        <Border x:Name="TitleBar"
                Grid.Row="0"
                Background="#E8F4F8"
                BorderBrush="#87CEEB"
                BorderThickness="0,0,0,1"
                Padding="10,7"
                Cursor="Hand">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="✏" FontSize="13" Foreground="#2C6E91" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Scratchpad" FontSize="14" FontWeight="SemiBold" Foreground="#2C6E91"/>
                </StackPanel>
                <Button x:Name="HideButton" Grid.Column="1"
                        Content="✕" Click="HideButton_Click"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#999999" FontSize="14"
                        Padding="4,0" Margin="8,0,0,0"
                        VerticalAlignment="Center" HorizontalContentAlignment="Center"
                        Width="20" Height="20" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Find / Replace bar (collapsible) -->
        <Border Grid.Row="1"
                Background="#EEF6FB"
                BorderBrush="#C8E4F0"
                BorderThickness="0,0,0,1"
                Padding="8,6"
                Visibility="{Binding IsFindBarVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Find row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FindBox"
                             Grid.Column="0"
                             Text="{Binding FindText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12" Padding="4,3"
                             BorderBrush="#A8CDE0" BorderThickness="1"
                             Background="White" VerticalContentAlignment="Center"
                             KeyDown="FindBox_KeyDown"/>
                    <Button Grid.Column="1" Content="▲" Style="{StaticResource ToolbarBtn}"
                            Click="FindPrevButton_Click" ToolTip="Previous (Shift+Enter)"
                            Margin="3,0,0,0" FontSize="10"/>
                    <Button Grid.Column="2" Content="▼" Style="{StaticResource ToolbarBtn}"
                            Click="FindNextButton_Click" ToolTip="Next (Enter)"
                            Margin="2,0,0,0" FontSize="10"/>
                    <TextBlock Grid.Column="3"
                               Text="{Binding FindResultText}"
                               FontSize="11" Foreground="#888888"
                               VerticalAlignment="Center" Margin="6,0"/>
                    <Button Grid.Column="4" Content="✕" Style="{StaticResource ToolbarBtn}"
                            Click="CloseFindBar_Click" Foreground="#999999" FontSize="11"
                            ToolTip="Close (Escape)"/>
                </Grid>
                <!-- Replace row -->
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding ReplaceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12" Padding="4,3"
                             BorderBrush="#A8CDE0" BorderThickness="1"
                             Background="White" VerticalContentAlignment="Center"
                             ToolTip="Replace with"/>
                    <Button Grid.Column="1" Content="Replace" Style="{StaticResource ToolbarBtn}"
                            Click="ReplaceButton_Click" Margin="4,0,0,0"
                            FontSize="11" Padding="8,3"/>
                    <Button Grid.Column="2" Content="Replace All" Style="{StaticResource ToolbarBtn}"
                            Click="ReplaceAllButton_Click" Margin="3,0,0,0"
                            FontSize="11" Padding="8,3" ToolTip="Replace all occurrences"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Formatting toolbar -->
        <Border Grid.Row="2"
                Background="#F0F8FC"
                BorderBrush="#C8E4F0"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <!-- Text formatting -->
                <ToggleButton x:Name="BoldButton" Style="{StaticResource ToggleBtn}"
                              FontWeight="Bold" Content="B"
                              Click="BoldButton_Click" ToolTip="Bold (Ctrl+B)"/>
                <ToggleButton x:Name="ItalicButton" Style="{StaticResource ToggleBtn}"
                              FontStyle="Italic" Content="I" Margin="2,0,0,0"
                              Click="ItalicButton_Click" ToolTip="Italic (Ctrl+I)"/>
                <ToggleButton x:Name="UnderlineButton" Style="{StaticResource ToggleBtn}"
                              Margin="2,0,0,0"
                              Click="UnderlineButton_Click" ToolTip="Underline (Ctrl+U)">
                    <TextBlock Text="U" TextDecorations="Underline"/>
                </ToggleButton>
                <ToggleButton x:Name="StrikeButton" Style="{StaticResource ToggleBtn}"
                              Margin="2,0,0,0"
                              Click="StrikeButton_Click" ToolTip="Strikethrough">
                    <TextBlock Text="S" TextDecorations="Strikethrough"/>
                </ToggleButton>

                <Border Width="1" Background="#C8E4F0" Margin="5,2"/>

                <!-- Font size -->
                <ComboBox x:Name="FontSizeCombo"
                          Width="54" Height="24" FontSize="11"
                          VerticalContentAlignment="Center"
                          SelectionChanged="FontSizeCombo_SelectionChanged"
                          ToolTip="Font size"/>

                <Border Width="1" Background="#C8E4F0" Margin="5,2"/>

                <!-- Text color -->
                <Button Style="{StaticResource ToolbarBtn}"
                        Click="TextColorButton_Click" ToolTip="Text color" Margin="0,0,2,0">
                    <StackPanel>
                        <TextBlock Text="A" FontWeight="Bold" HorizontalAlignment="Center" FontSize="12"/>
                        <Border x:Name="TextColorBar" Height="3" Width="14" Background="#CC3333" CornerRadius="1"/>
                    </StackPanel>
                </Button>
                <!-- Highlight -->
                <Button Style="{StaticResource ToolbarBtn}"
                        Click="HighlightButton_Click" ToolTip="Highlight" Margin="0,0,2,0">
                    <StackPanel>
                        <TextBlock Text="H" HorizontalAlignment="Center" FontSize="12"/>
                        <Border x:Name="HighlightColorBar" Height="3" Width="14" Background="Yellow" CornerRadius="1"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="#C8E4F0" Margin="5,2"/>

                <!-- Undo / Redo -->
                <Button Style="{StaticResource ToolbarBtn}" Content="↩"
                        Click="UndoButton_Click" ToolTip="Undo (Ctrl+Z)" FontSize="14"/>
                <Button Style="{StaticResource ToolbarBtn}" Content="↪"
                        Click="RedoButton_Click" ToolTip="Redo (Ctrl+Y)" FontSize="14" Margin="2,0,0,0"/>

                <Border Width="1" Background="#C8E4F0" Margin="5,2"/>

                <!-- Find -->
                <Button Style="{StaticResource ToolbarBtn}" Content="⌕"
                        Click="FindButton_Click" ToolTip="Find &amp; Replace (Ctrl+F)" FontSize="15"/>

                <!-- Insert timestamp -->
                <Button Style="{StaticResource ToolbarBtn}" Content="⏱"
                        Click="InsertTimestampButton_Click" ToolTip="Insert timestamp" FontSize="13" Margin="2,0,0,0"/>

                <Border Width="1" Background="#C8E4F0" Margin="5,2"/>

                <!-- Word wrap toggle -->
                <ToggleButton x:Name="WordWrapButton" Style="{StaticResource ToggleBtn}"
                              IsChecked="{Binding WordWrapEnabled, Mode=TwoWay}"
                              ToolTip="Toggle word wrap" Content="⏎" Margin="0,0,2,0"/>

                <!-- Copy all -->
                <Button Style="{StaticResource ToolbarBtn}" Content="⎘"
                        Click="CopyAllButton_Click" ToolTip="Copy all text" FontSize="13" Margin="0,0,2,0"/>

                <!-- Clear -->
                <Button Style="{StaticResource ToolbarBtn}" Content="⌫"
                        Click="ClearButton_Click" ToolTip="Clear all" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Editor -->
        <RichTextBox x:Name="Editor"
                     Grid.Row="3"
                     Background="White"
                     Foreground="#222222"
                     BorderThickness="0"
                     Padding="10,8"
                     FontFamily="Segoe UI"
                     FontSize="13"
                     VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     SpellCheck.IsEnabled="True"
                     TextChanged="Editor_TextChanged"
                     SelectionChanged="Editor_SelectionChanged"
                     PreviewKeyDown="Editor_PreviewKeyDown"/>

        <!-- Status bar -->
        <Border Grid.Row="4"
                Background="#EEF6FB"
                BorderBrush="#C8E4F0"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="#777777">
                        <Run Text="W:"/>
                        <Run Text="{Binding WordCount, Mode=OneWay}" Foreground="#2C6E91" FontWeight="SemiBold"/>
                        <Run Text="  C:"/>
                        <Run Text="{Binding CharCount, Mode=OneWay}" Foreground="#2C6E91" FontWeight="SemiBold"/>
                        <Run Text="  L:"/>
                        <Run Text="{Binding LineCount, Mode=OneWay}" Foreground="#2C6E91" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Text="{Binding FindResultText}"
                               FontSize="11" Foreground="#888888"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="⚠"
                               FontSize="12" Foreground="#B35A00"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding HasPersistenceError, Converter={StaticResource BoolToVis}}"
                               ToolTip="{Binding PersistenceError}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Ghost" FontSize="11" VerticalAlignment="Center"
                              IsChecked="{Binding GhostModeEnabled, Mode=TwoWay}"
                              Margin="0,0,6,0"/>
                    <TextBlock Text="◢" Foreground="#D0D0D0" FontSize="10"
                               VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</noted:OverlayWindow>
