<noted:OverlayWindow x:Class="Noted.ScratchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:noted="clr-namespace:Noted"
        Title="Scratchpad"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="450"
        Height="500"
        Left="150"
        Top="150"
        MinWidth="300"
        MinHeight="250">

    <noted:OverlayWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource NotedScrollBar}"/>
        <Style x:Key="HeaderIconBtn"
               TargetType="Button"
               BasedOn="{StaticResource NotedHeaderIconButton}"/>

        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource NotedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="27"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource NotedAccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotedAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource NotedAccentSoftHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource NotedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="27"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource NotedAccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotedAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource NotedAccentSoftHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotedAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FindInput" TargetType="TextBox" BasedOn="{StaticResource NotedTextInput}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </noted:OverlayWindow.Resources>

    <Grid Background="Transparent">
        <Border Margin="1"
                Background="{DynamicResource NotedWindowBackgroundBrush}"
                BorderBrush="{DynamicResource NotedStrongBorderBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                        Padding="2,1,0,8" Cursor="SizeAll">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="✎" Margin="0,0,7,0" Foreground="{DynamicResource NotedAccentBrush}"
                                       FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="Scratchpad" Foreground="{DynamicResource NotedTextBrush}"
                                       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="⚠" Margin="8,0,0,0" Foreground="{DynamicResource NotedWarningBrush}"
                                       FontSize="12" VerticalAlignment="Center"
                                       Visibility="{Binding HasPersistenceError, Converter={StaticResource BoolToVis}}"
                                       ToolTip="{Binding PersistenceError}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="&#xE721;" Style="{StaticResource HeaderIconBtn}"
                                    Click="FindButton_Click" ToolTip="Find and replace (Ctrl+F)"/>
                            <Button Content="&#xE711;" Margin="3,0,0,0"
                                    Style="{StaticResource HeaderIconBtn}"
                                    Click="HideButton_Click" ToolTip="Hide"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,0,0,7" Padding="8"
                        Background="{DynamicResource NotedSubtleSurfaceBrush}"
                        BorderBrush="{DynamicResource NotedBorderBrush}"
                        BorderThickness="1" CornerRadius="7"
                        Visibility="{Binding IsFindBarVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FindBox" Grid.Column="0"
                                     Style="{StaticResource FindInput}"
                                     Text="{Binding FindText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="FindBox_KeyDown"/>
                            <Button Grid.Column="1" Content="↑" Style="{StaticResource ToolbarBtn}"
                                    Click="FindPreviousButton_Click" ToolTip="Previous (Shift+Enter)"
                                    Margin="4,0,0,0"/>
                            <Button Grid.Column="2" Content="↓" Style="{StaticResource ToolbarBtn}"
                                    Click="FindNextButton_Click" ToolTip="Next (Enter)"/>
                            <TextBlock Grid.Column="3" Text="{Binding FindResultText}"
                                       Foreground="{DynamicResource NotedSecondaryTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="6,0"/>
                            <Button Grid.Column="4" Content="×" Style="{StaticResource ToolbarBtn}"
                                    Click="CloseFindBar_Click" ToolTip="Close (Escape)"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource FindInput}"
                                     Text="{Binding ReplaceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Replace with"/>
                            <Button Grid.Column="1" Content="Replace" Style="{StaticResource ToolbarBtn}"
                                    Click="ReplaceButton_Click" Margin="4,0,1,0" Padding="8,2"/>
                            <Button Grid.Column="2" Content="Replace all" Style="{StaticResource ToolbarBtn}"
                                    Click="ReplaceAllButton_Click" Padding="8,2"
                                    ToolTip="Replace all occurrences"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Margin="0,0,0,7" Padding="5"
                        Background="{DynamicResource NotedSurfaceBrush}"
                        BorderBrush="{DynamicResource NotedBorderBrush}"
                        BorderThickness="1" CornerRadius="7">
                    <WrapPanel Orientation="Horizontal">
                        <ToggleButton x:Name="BoldButton" Style="{StaticResource ToggleBtn}"
                                      FontWeight="Bold" Content="B"
                                      Click="BoldButton_Click" ToolTip="Bold (Ctrl+B)"/>
                        <ToggleButton x:Name="ItalicButton" Style="{StaticResource ToggleBtn}"
                                      FontStyle="Italic" Content="I"
                                      Click="ItalicButton_Click" ToolTip="Italic (Ctrl+I)"/>
                        <ToggleButton x:Name="UnderlineButton" Style="{StaticResource ToggleBtn}"
                                      Click="UnderlineButton_Click" ToolTip="Underline (Ctrl+U)">
                            <TextBlock Text="U" TextDecorations="Underline"/>
                        </ToggleButton>
                        <ToggleButton x:Name="StrikethroughButton" Style="{StaticResource ToggleBtn}"
                                      Click="StrikethroughButton_Click" ToolTip="Strikethrough">
                            <TextBlock Text="S" TextDecorations="Strikethrough"/>
                        </ToggleButton>

                        <Border Width="1" Height="19" Background="{DynamicResource NotedBorderBrush}" Margin="5,5"/>

                        <ComboBox x:Name="FontSizeCombo" Width="54" Height="27" Margin="1"
                                  Padding="3,0"
                                  Style="{StaticResource NotedComboBox}"
                                  FontSize="11"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="FontSizeCombo_SelectionChanged"
                                  ToolTip="Font size"/>

                        <Border Width="1" Height="19" Background="{DynamicResource NotedBorderBrush}" Margin="5,5"/>

                        <Button Style="{StaticResource ToolbarBtn}"
                                Click="TextColorButton_Click" ToolTip="Text color">
                            <StackPanel>
                                <TextBlock Text="A" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Border x:Name="TextColorBar" Height="3" Width="14"
                                        Background="#CC3333" CornerRadius="1"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarBtn}"
                                Click="HighlightButton_Click" ToolTip="Highlight">
                            <StackPanel>
                                <TextBlock Text="H" HorizontalAlignment="Center"/>
                                <Border x:Name="HighlightColorBar" Height="3" Width="14"
                                        Background="Yellow" CornerRadius="1"/>
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="19" Background="{DynamicResource NotedBorderBrush}" Margin="5,5"/>

                        <Button Style="{StaticResource ToolbarBtn}" Content="↶"
                                Click="UndoButton_Click" ToolTip="Undo (Ctrl+Z)" FontSize="15"/>
                        <Button Style="{StaticResource ToolbarBtn}" Content="↷"
                                Click="RedoButton_Click" ToolTip="Redo (Ctrl+Y)" FontSize="15"/>
                        <Button Style="{StaticResource ToolbarBtn}" Content="⏱"
                                Click="InsertTimestampButton_Click" ToolTip="Insert timestamp"/>

                        <Border Width="1" Height="19" Background="{DynamicResource NotedBorderBrush}" Margin="5,5"/>

                        <ToggleButton x:Name="WordWrapButton" Style="{StaticResource ToggleBtn}"
                                      IsChecked="{Binding WordWrapEnabled, Mode=TwoWay}"
                                      ToolTip="Toggle word wrap" Content="↵"/>
                        <Button Style="{StaticResource ToolbarBtn}" Content="⧉"
                                Click="CopyAllButton_Click" ToolTip="Copy all text" FontSize="14"/>
                        <Button Style="{StaticResource ToolbarBtn}" Content="⌫"
                                Click="ClearButton_Click" ToolTip="Clear all" FontSize="14"/>
                    </WrapPanel>
                </Border>

                <Border Grid.Row="3"
                        Background="{DynamicResource NotedSurfaceBrush}"
                        BorderBrush="{DynamicResource NotedBorderBrush}"
                        BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <RichTextBox x:Name="Editor"
                                 Background="{DynamicResource NotedInputBackgroundBrush}"
                                 Foreground="{DynamicResource NotedTextBrush}"
                                 BorderThickness="0" Padding="11,9"
                                 FontFamily="Segoe UI" FontSize="13"
                                 CaretBrush="{DynamicResource NotedAccentBrush}"
                                 SelectionBrush="{DynamicResource NotedAccentSoftHoverBrush}"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 SpellCheck.IsEnabled="True"
                                 TextChanged="Editor_TextChanged"
                                 SelectionChanged="Editor_SelectionChanged"
                                 PreviewKeyDown="Editor_PreviewKeyDown"/>
                </Border>

                <Grid Grid.Row="4" Margin="1,8,1,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource NotedSecondaryTextBrush}" FontSize="11">
                            <Run Text="Words "/>
                            <Run Text="{Binding WordCount, Mode=OneWay}" Foreground="{DynamicResource NotedAccentBrush}" FontWeight="SemiBold"/>
                            <Run Text="   Characters "/>
                            <Run Text="{Binding CharacterCount, Mode=OneWay}" Foreground="{DynamicResource NotedAccentBrush}" FontWeight="SemiBold"/>
                            <Run Text="   Lines "/>
                            <Run Text="{Binding LineCount, Mode=OneWay}" Foreground="{DynamicResource NotedAccentBrush}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock Text="{Binding FindResultText}" Margin="12,0,0,0"
                                   Foreground="{DynamicResource NotedSecondaryTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="Ghost"
                              IsChecked="{Binding GhostModeEnabled, Mode=TwoWay}"
                              Foreground="{DynamicResource NotedSecondaryTextBrush}"
                              Style="{StaticResource NotedCheckBox}"
                              FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</noted:OverlayWindow>
