<Window x:Class="Noted.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:Noted.Services"
        xmlns:local="clr-namespace:Noted.Helpers"
        xmlns:views="clr-namespace:Noted"
        Title="Noted."
        Icon="/Noted;component/Resources/notes.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource NotedTextBrush}"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="MainWindow_Loaded">
    <Window.Resources>
        <local:WidthToActionButtonVisibilityConverter x:Key="WidthToActionButtonVisibilityConverter"/>
        <local:WidthToHeaderVisibilityConverter x:Key="WidthToHeaderVisibilityConverter"/>
        <local:WidthBelowThresholdConverter x:Key="WidthBelow240" Threshold="240"/>
        <local:WidthBelowThresholdConverter x:Key="WidthBelow320" Threshold="320"/>
        <local:WidthBelowThresholdConverter x:Key="WidthBelow340" Threshold="340"/>
        <local:WidthBelowThresholdConverter x:Key="WidthBelow400" Threshold="400"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:IndentLevelToMarginConverter x:Key="IndentLevelToMarginConverter"/>
        
        <!-- Low-emphasis scrollbar: neutral at rest, accent on interaction -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Background" Value="{DynamicResource NotedStrongBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Margin="1,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource NotedAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource NotedAccentPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern scrollbar styling -->
        <Style x:Key="ModernScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Background="Transparent" BorderThickness="0" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ScrollThumb"
                                           Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Background="Transparent" BorderThickness="0" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- ValueChanged also fires for mouse-wheel, keyboard, and page scrolling. -->
                            <EventTrigger RoutedEvent="RangeBase.ValueChanged">
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ScrollThumb"
                                                                       Storyboard.TargetProperty="Background"
                                                                       Duration="0:0:0.45"
                                                                       FillBehavior="Stop">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                                    Value="{StaticResource NotedAccentBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apply modern scrollbar style globally -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>


        <!-- Main launcher/header button styles -->
        <Style x:Key="PrimaryHeaderButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource NotedAccentTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{DynamicResource NotedAccentBrush}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NotedAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NotedAccentPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource NotedSecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NotedAccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotedAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NotedAccentSoftHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UtilityMenuButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource HeaderChromeButtonStyle}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource NotedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Tray context menu styles -->
        <Style x:Key="TrayContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource NotedWindowBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotedStrongBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrayMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource NotedTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Margin="2,1">
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NotedAccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NotedAccentSoftHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrayMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource NotedBorderBrush}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="1" Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tray context menu (opened manually to ensure proper foreground activation) -->
        <ContextMenu x:Key="TrayContextMenu" Style="{StaticResource TrayContextMenuStyle}">
            <MenuItem Header="Show/Hide Notes" Click="TrayShowHideNotes_Click" Style="{StaticResource TrayMenuItemStyle}"/>
            <MenuItem Header="⚙" Click="TraySettings_Click" Style="{StaticResource TrayMenuItemStyle}"/>
            <Separator Style="{StaticResource TrayMenuSeparatorStyle}"/>
            <MenuItem Header="Exit" Click="TrayExit_Click" Style="{StaticResource TrayMenuItemStyle}"/>
        </ContextMenu>

    </Window.Resources>

        <Canvas x:Name="MainCanvas"
            Background="Transparent"
            Focusable="True" Cursor="SizeAll">

        <Border x:Name="NotesPanel"
            Background="{DynamicResource NotedWindowBackgroundBrush}"
            BorderBrush="{DynamicResource NotedStrongBorderBrush}"
            Opacity="0.88"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Focusable="True"
            MinWidth="220"
            MinHeight="180"
            Width="360" Height="620"
            Canvas.Right="40" Canvas.Top="60"
            Visibility="Visible"
            Cursor="SizeAll">

            <Grid>
                <DockPanel>
                <!-- Header bar -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="NotesPanelDragHandle"
                                Grid.Column="0"
                                Background="Transparent"
                                Focusable="True"
                                Cursor="SizeAll"
                                Padding="0,3,6,3">
                            <Grid>
                            <TextBlock x:Name="HeaderText"
                                       Text="{Binding HeaderText, Mode=OneWay}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource NotedTextBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Cursor="Hand"
                                       ToolTip="Double-click to edit the header"
                                       MouseLeftButtonDown="HeaderText_MouseLeftButtonDown">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="{Binding ElementName=NotesPanel, Path=ActualWidth, Converter={StaticResource WidthToHeaderVisibilityConverter}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsHeaderEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="HeaderTextEdit"
                                     Text="{Binding HeaderTextEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource NotedTextBrush}"
                                     VerticalAlignment="Center"
                                     MinWidth="80"
                                     FocusVisualStyle="{x:Null}"
                                     ToolTip="Enter or click away to save"
                                     LostFocus="HeaderEditBox_LostFocus"
                                     KeyDown="HeaderEditBox_KeyDown"
                                     Visibility="{Binding IsHeaderEditing, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="Settings"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource NotedTextBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Grid.Column" Value="1"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=NotesPanel, Path=ActualWidth, Converter={StaticResource WidthBelow340}}" Value="True">
                                            <Setter Property="Grid.Column" Value="0"/>
                                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                    <Button x:Name="NewNoteButton"
                            Click="NewNoteButton_Click"
                            Margin="0,0,4,0"
                            ToolTip="Create a new note">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryHeaderButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=NotesPanel, Path=ActualWidth, Converter={StaticResource WidthBelow320}}" Value="True">
                                        <Setter Property="Width" Value="28"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE710;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="New"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=NotesPanel, Path=ActualWidth, Converter={StaticResource WidthBelow320}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Margin" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Button x:Name="QuickNoteButton"
                            Click="QuickNoteButton_Click"
                            Margin="0,0,3,0"
                            ToolTip="Create a quick note">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryHeaderButtonStyle}">
                                <Setter Property="Content" Value="Quick"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=NotesPanel, Path=ActualWidth, Converter={StaticResource WidthBelow400}}" Value="True">
                                        <Setter Property="Content" Value="⚡"/>
                                        <Setter Property="Width" Value="28"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Grid x:Name="UtilityMenu">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=NotesPanel, Path=ActualWidth, Converter={StaticResource WidthBelow240}}" Value="True"/>
                                                <Condition Binding="{Binding ElementName=QuickNoteButton, Path=Visibility}" Value="Visible"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Button x:Name="ChecklistButton"
                                    Click="ChecklistButton_Click"
                                    Style="{StaticResource UtilityMenuButtonStyle}"
                                    ToolTip="Show or hide Checklist"
                                    AutomationProperties.Name="Checklist">
                                <TextBlock Text="✓" FontSize="13"/>
                            </Button>

                            <Button x:Name="DictionaryButton"
                                    Click="DictionaryButton_Click"
                                    Style="{StaticResource UtilityMenuButtonStyle}"
                                    ToolTip="Show or hide Dictionary"
                                    AutomationProperties.Name="Dictionary">
                                <TextBlock Text="Aa" FontWeight="Bold" FontSize="10"/>
                            </Button>

                            <Button x:Name="ScratchpadButton"
                                    Click="ScratchpadButton_Click"
                                    Style="{StaticResource UtilityMenuButtonStyle}"
                                    ToolTip="Show or hide Scratchpad"
                                    AutomationProperties.Name="Scratchpad">
                                <TextBlock Text="✎" FontSize="13"/>
                            </Button>

                            <Button x:Name="MiniPadButton"
                                    Click="MiniPadButton_Click"
                                    Style="{StaticResource UtilityMenuButtonStyle}"
                                    ToolTip="Show or hide MiniPad"
                                    AutomationProperties.Name="MiniPad">
                                <TextBlock Text="▤" FontSize="12"/>
                            </Button>
                        </StackPanel>

                        <Button x:Name="CompactUtilityMenuButton"
                                Click="UtilityMenuButton_Click"
                                ToolTip="Open utility menu"
                                AutomationProperties.Name="Utility menu">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HeaderChromeButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=NotesPanel, Path=ActualWidth, Converter={StaticResource WidthBelow240}}" Value="True"/>
                                                <Condition Binding="{Binding ElementName=QuickNoteButton, Path=Visibility}" Value="Visible"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;" FontSize="15"/>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource NotedContextMenu}"
                                             Placement="Bottom">
                                    <ContextMenu.Resources>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource NotedContextMenuItem}"/>
                                    </ContextMenu.Resources>
                                    <MenuItem Header="Checklist" Click="ChecklistButton_Click">
                                        <MenuItem.Icon><TextBlock Text="✓" FontSize="13"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Dictionary" Click="DictionaryButton_Click">
                                        <MenuItem.Icon><TextBlock Text="Aa" FontSize="10" FontWeight="Bold"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Scratchpad" Click="ScratchpadButton_Click">
                                        <MenuItem.Icon><TextBlock Text="✎" FontSize="13"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="MiniPad" Click="MiniPadButton_Click">
                                        <MenuItem.Icon><TextBlock Text="▤" FontSize="12"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="SettingsButton"
                                Click="SettingsButton_Click"
                                Style="{StaticResource HeaderChromeButtonStyle}"
                                Margin="8,0,3,0"
                                ToolTip="Settings"
                                AutomationProperties.Name="Settings">
                            <TextBlock x:Name="SettingsButtonIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE713;"
                                       FontSize="16"/>
                        </Button>

                        <Button x:Name="HideNotesButton"
                                Click="HideNotesButton_Click"
                                Style="{StaticResource HeaderChromeButtonStyle}"
                                ToolTip="Hide Notes"
                                AutomationProperties.Name="Hide Notes">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE711;"
                                       FontSize="15"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Separator -->
                <Border DockPanel.Dock="Top"
                    Height="1" Background="{DynamicResource NotedBorderBrush}" Margin="0,2,0,6"/>

                <Grid>
                    <DockPanel x:Name="NotesListView"
                              Margin="2,4,2,2"
                              Opacity="0.95">

                        <!-- Navigation breadcrumb bar – visible when inside a subfolder -->
                        <Border DockPanel.Dock="Top"
                                Margin="0,0,0,6"
                                Background="{DynamicResource NotedSubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource NotedBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6,5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanNavigateUp}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        x:Name="NavigateUpButton"
                                        Content="&#xE72B;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="12"
                                        Foreground="{DynamicResource NotedTextBrush}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,2"
                                        Cursor="Hand"
                                        ToolTip="Back to parent folder"
                                        AutomationProperties.Name="Navigate up"
                                        Click="NavigateUpButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg"
                                                    Background="Transparent"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource NotedAccentSoftBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentFolderName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource NotedTextBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="4,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Search / filter bar -->
                        <Grid DockPanel.Dock="Top" Margin="2,0,2,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search icon -->
                            <TextBlock Grid.Column="0"
                                       Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="2,0,6,0"
                                       IsHitTestVisible="False"/>

                            <!-- Placeholder rendered BEHIND the TextBox (same column, earlier in XML order) -->
                            <TextBlock Grid.Column="1"
                                       Text="Search notes..."
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource NotedMutedTextBrush}"
                                       VerticalAlignment="Center"
                                       Padding="0,7"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Search TextBox (rendered on top of placeholder) -->
                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     FontSize="12"
                                     Foreground="{DynamicResource NotedTextBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,7"
                                     VerticalAlignment="Center"
                                     KeyDown="SearchBox_KeyDown"/>

                            <!-- Clear button (visible only when FilterText is non-empty) -->
                            <Button Grid.Column="2"
                                    x:Name="ClearSearchButton"
                                    Content="&#xE711;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="11"
                                    Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                    Cursor="Hand"
                                    Padding="6,6"
                                    AutomationProperties.Name="Clear search"
                                    Click="ClearSearchButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource NotedHeaderIconButton}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NotedAccentSoftBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- No-results message (shown when filter matches nothing) -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="No notes match your search."
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"
                                   Foreground="{DynamicResource NotedMutedTextBrush}"
                                   FontStyle="Italic"
                                   FontSize="12"
                                   Visibility="{Binding HasNoFilterResults, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock DockPanel.Dock="Top"
                                   Text="This folder is empty. Select + New to create a note."
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="16,20,16,0"
                                   Foreground="{DynamicResource NotedMutedTextBrush}"
                                   FontStyle="Italic"
                                   FontSize="12"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasNoNotes, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- File list -->
                        <ListBox x:Name="FileList"
                                 Foreground="{DynamicResource NotedTextBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 SelectionChanged="FileList_SelectionChanged"
                                 KeyDown="FileList_KeyDown"
                                 ContextMenuOpening="FileList_ContextMenuOpening"
                                 MinHeight="60"
                                 VerticalAlignment="Stretch"
                                 DockPanel.Dock="Bottom"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 Margin="0,0,4,0">
                                <ListBox.ContextMenu>
                                    <ContextMenu Style="{StaticResource NotedContextMenu}">
                                        <ContextMenu.Resources>
                                            <Style TargetType="MenuItem"
                                                   BasedOn="{StaticResource NotedContextMenuItem}"/>
                                        </ContextMenu.Resources>
                                        <MenuItem x:Name="OpenNoteMenuItem"
                                                  Header="Open"
                                                  Click="OpenSelectedNote_Click"
                                                  InputGestureText="Enter"
                                                  ToolTip="Open this note (Enter)">
                                            <MenuItem.Icon>
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" FontSize="14" Foreground="{DynamicResource NotedTextBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="OpenFolderMenuItem"
                                                  Header="Open Folder"
                                                  Click="OpenFolderMenuItem_Click"
                                                  InputGestureText="Enter"
                                                  ToolTip="Navigate into this folder (Enter)">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource NotedTextBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="RenameMenuItem"
                                                  Header="Rename"
                                                  Click="RenameNote_Click"
                                                  InputGestureText="F2"
                                                  ToolTip="Rename (F2)">
                                            <MenuItem.Icon>
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8AC;" FontSize="14" Foreground="{DynamicResource NotedTextBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="CopyNameMenuItem"
                                                  Header="Copy Name"
                                                  Click="CopyNoteName_Click"
                                                  InputGestureText="Ctrl+C"
                                                  ToolTip="Copy name to clipboard">
                                            <MenuItem.Icon>
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="14" Foreground="{DynamicResource NotedTextBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator x:Name="DeleteSeparator"/>
                                        <MenuItem x:Name="DeleteMenuItem"
                                                  Header="Delete"
                                                  Click="DeleteNoteButton_Click"
                                                  InputGestureText="Del"
                                                  ToolTip="Delete (Del)">
                                            <MenuItem.Icon>
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="14" Foreground="{DynamicResource NotedTextBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem x:Name="NewFolderMenuItem"
                                                  Header="New Folder"
                                                  Click="NewFolderMenuItem_Click"
                                                  ToolTip="Create a new subfolder here">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource NotedTextBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="32" Margin="{Binding IndentLevel, Converter={StaticResource IndentLevelToMarginConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*" MinWidth="50"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Pin / folder-icon column -->
                                            <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <!-- Pin button – hidden for folder rows via last DataTrigger -->
                                                <Button Width="16" Height="16" Padding="1" Margin="-6,0,0,0"
                                                        FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                        Content="&#xE718;"
                                                        ToolTip="Pin note"
                                                        AutomationProperties.Name="Pin note"
                                                        Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                                        Cursor="Hand"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="1"
                                                        Click="PinNoteButton_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource NotedHeaderIconButton}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource NotedAccentBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Opacity" Value="0.8"/>
                                                                </DataTrigger>
                                                                <!-- Must be last – overrides hover/pin triggers for folder items -->
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <!-- Child notes in expanded folders cannot be pinned -->
                                                                <DataTrigger Binding="{Binding IndentLevel}" Value="1">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <!-- Folder icon – visible only for folder rows; icon changes when expanded -->
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           Margin="-6,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE8B7;"/>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource NotedSecondaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE8DA;"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource NotedAccentBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource NotedAccentBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource NotedAccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <!-- Note display column -->
                                            <Grid Grid.Column="1" Margin="0,0,8,0">
                                                <StackPanel x:Name="DisplayPanel">
                                                    <TextBlock x:Name="DisplayTextBlock"
                                                               Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayName}"/>
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Subtitle}"
                                                               Visibility="{Binding DataContext.ShowModifiedSubtitle, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                                <TextBox x:Name="EditTextBox" 
                                                         Text="{Binding EditableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="Collapsed"
                                                         Padding="2"
                                                         Background="{DynamicResource NotedInputBackgroundBrush}"
                                                         BorderBrush="{DynamicResource NotedAccentBrush}"
                                                         Foreground="{DynamicResource NotedTextBrush}"
                                                         CaretBrush="{DynamicResource NotedTextBrush}"
                                                         BorderThickness="1"
                                                         KeyDown="RenameTextBox_KeyDown"
                                                         LostFocus="RenameTextBox_LostFocus"/>
                                            </Grid>
                                            <!-- Action buttons column -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <!-- Child notes (in expanded folders) are read-only; suppress all action buttons -->
                                                            <DataTrigger Binding="{Binding IndentLevel}" Value="1">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Content="Rename"
                                                        Click="RenameNote_Click"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource NotedTextBrush}"
                                                        Cursor="Hand"
                                                        Background="Transparent"
                                                        BorderBrush="{DynamicResource NotedStrongBorderBrush}"
                                                        BorderThickness="1"
                                                        MinWidth="40"
                                                        Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=ActualWidth, Converter={StaticResource WidthToActionButtonVisibilityConverter}, ConverterParameter=rename}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bg"
                                                                    Background="{DynamicResource NotedSubtleSurfaceBrush}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource NotedAccentSoftBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Click="DeleteNoteButton_Click"
                                                        Width="24"
                                                        Height="24"
                                                        Margin="6,0,0,0"
                                                        Padding="0"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="13"
                                                        Content="&#xE74D;"
                                                        ToolTip="Delete note"
                                                        AutomationProperties.Name="Delete"
                                                        Foreground="{DynamicResource NotedDangerBrush}"
                                                        Cursor="Hand"
                                                        Background="Transparent"
                                                        BorderBrush="{DynamicResource NotedDangerBrush}"
                                                        BorderThickness="1"
                                                        Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=ActualWidth, Converter={StaticResource WidthToActionButtonVisibilityConverter}, ConverterParameter=delete}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bg"
                                                                    Background="{DynamicResource NotedSurfaceBrush}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource NotedAccentSoftBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter TargetName="DisplayPanel" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="EditTextBox" Property="Visibility" Value="Visible"/>
                                                <!-- Action buttons will be hidden by the DataContext logic if needed -->
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,7"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ListBoxItem_MouseLeftButtonUp"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Grid>
                                                        <Border x:Name="ItemBorder"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <Border x:Name="SelectionAccent"
                                                                Width="3"
                                                                Margin="0,6,0,6"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Stretch"
                                                                Background="{DynamicResource NotedAccentBrush}"
                                                                CornerRadius="2"
                                                                Visibility="Collapsed"
                                                                IsHitTestVisible="False"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NotedSubtleSurfaceBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NotedAccentSoftBrush}"/>
                                                            <Setter TargetName="SelectionAccent" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource NotedAccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                    </DockPanel>

                        <views:SettingsView x:Name="SettingsView" />
                </Grid>
                </DockPanel>

            </Grid>
        </Border>

        <Button x:Name="FloatingNotesButton"
                Content="Notes"
            Width="96" Height="48"
                Canvas.Right="20" Canvas.Bottom="20"
                FontSize="16" FontWeight="SemiBold"
            Foreground="{DynamicResource NotedAccentTextBrush}"
            Background="{DynamicResource NotedAccentSoftBrush}"
            BorderBrush="{DynamicResource NotedStrongBorderBrush}">

            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="12"
                                        Opacity="{TemplateBinding Opacity}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource NotedAccentSoftHoverBrush}"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource NotedAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

    </Canvas>
</Window>
