<Window x:Class="Noted.AccentColorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accent Color"
        Width="390"
        Height="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{DynamicResource NotedTextBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ColorSlider"
               TargetType="Slider"
               BasedOn="{StaticResource NotedSlider}"/>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border Margin="8"
                Background="{DynamicResource NotedWindowBackgroundBrush}"
                BorderBrush="{DynamicResource NotedStrongBorderBrush}"
                BorderThickness="1"
                CornerRadius="9">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.2" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="14,10,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="2,0,0,8"
                        Background="Transparent"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <Grid Width="22" Height="22" Margin="0,0,8,0">
                                <Ellipse Width="10" Height="10"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top"
                                         Fill="#D9822B"/>
                                <Ellipse Width="10" Height="10"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Fill="#7A5CB8"/>
                                <Ellipse Width="10" Height="10"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Bottom"
                                         Fill="#008080"/>
                            </Grid>
                            <TextBlock Text="Accent color"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Style="{StaticResource NotedSecondaryButton}"
                                Click="CancelButton_Click"
                                ToolTip="Close"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1"
                           Margin="0,0,0,14"
                           Foreground="{DynamicResource NotedSecondaryTextBrush}"
                           Text="Choose any RGB color or enter its HEX value."/>

                <StackPanel Grid.Row="2">
                    <Border Height="52"
                            Margin="0,0,0,14"
                            Background="{DynamicResource NotedSurfaceBrush}"
                            BorderBrush="{DynamicResource NotedBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border x:Name="AccentPreview" Margin="6" CornerRadius="4"/>
                    </Border>

                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Red" VerticalAlignment="Center"/>
                        <Slider x:Name="RedSlider"
                                Grid.Column="1"
                                Minimum="0" Maximum="255"
                                TickFrequency="1"
                                Style="{StaticResource ColorSlider}"
                                ValueChanged="RgbSlider_ValueChanged"/>
                        <TextBlock x:Name="RedValue" Grid.Column="2"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Green" VerticalAlignment="Center"/>
                        <Slider x:Name="GreenSlider"
                                Grid.Column="1"
                                Minimum="0" Maximum="255"
                                TickFrequency="1"
                                Style="{StaticResource ColorSlider}"
                                ValueChanged="RgbSlider_ValueChanged"/>
                        <TextBlock x:Name="GreenValue" Grid.Column="2"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Blue" VerticalAlignment="Center"/>
                        <Slider x:Name="BlueSlider"
                                Grid.Column="1"
                                Minimum="0" Maximum="255"
                                TickFrequency="1"
                                Style="{StaticResource ColorSlider}"
                                ValueChanged="RgbSlider_ValueChanged"/>
                        <TextBlock x:Name="BlueValue" Grid.Column="2"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HEX" VerticalAlignment="Center"/>
                        <TextBox x:Name="HexTextBox"
                                 Grid.Column="1"
                                 MaxLength="7"
                                 MinHeight="30"
                                 Padding="8,4"
                                 Background="{DynamicResource NotedInputBackgroundBrush}"
                                 BorderBrush="{DynamicResource NotedBorderBrush}"
                                 Foreground="{DynamicResource NotedTextBrush}"
                                 CaretBrush="{DynamicResource NotedAccentBrush}"
                                 TextChanged="HexTextBox_TextChanged"/>
                    </Grid>
                    <TextBlock x:Name="ValidationText"
                               Margin="43,4,0,0"
                               FontSize="10"
                               Foreground="{DynamicResource NotedDangerBrush}"/>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="Cancel"
                                MinWidth="76"
                                Margin="0,0,8,0"
                                IsCancel="True"
                                Style="{StaticResource NotedSecondaryButton}"
                                Click="CancelButton_Click"/>
                        <Button Content="Use color"
                                MinWidth="88"
                                IsDefault="True"
                                Style="{StaticResource NotedPrimaryButton}"
                                Click="UseColorButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
