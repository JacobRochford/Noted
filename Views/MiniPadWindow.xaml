<noted:OverlayWindow x:Class="Noted.MiniPadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:noted="clr-namespace:Noted"
        Title="MiniPad"
        Width="320"
        Height="240"
        MinWidth="200"
        MinHeight="140"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent">

    <noted:OverlayWindow.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource NotedScrollBar}"/>
        <Style x:Key="HeaderIconBtn"
               TargetType="Button"
               BasedOn="{StaticResource NotedHeaderIconButton}"/>
    </noted:OverlayWindow.Resources>

    <Grid Background="Transparent">
        <Border Margin="1"
                Background="{DynamicResource NotedWindowBackgroundBrush}"
                BorderBrush="{DynamicResource NotedStrongBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="TitleBar"
                        Grid.Row="0"
                        Padding="2,1,0,8"
                        Background="Transparent"
                        Cursor="SizeAll">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock Text="✎"
                                       Margin="0,0,7,0"
                                       Foreground="{DynamicResource NotedAccentBrush}"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="MiniPad"
                                       Foreground="{DynamicResource NotedTextBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="&#xE711;"
                                    Style="{StaticResource HeaderIconBtn}"
                                    Click="HideButton_Click"
                                    ToolTip="Hide"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{DynamicResource NotedSurfaceBrush}"
                        BorderBrush="{DynamicResource NotedBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <TextBox x:Name="Editor"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Padding="11,9"
                             Background="{DynamicResource NotedInputBackgroundBrush}"
                             Foreground="{DynamicResource NotedTextBrush}"
                             CaretBrush="{DynamicResource NotedAccentBrush}"
                             SelectionBrush="{DynamicResource NotedAccentSoftHoverBrush}"
                             FontFamily="Segoe UI"
                             FontSize="13"
                             SpellCheck.IsEnabled="True"/>
                </Border>

                <Border x:Name="PersistenceErrorPanel"
                        Grid.Row="2"
                        Margin="0,7,0,0"
                        Padding="8,6"
                        Background="{DynamicResource NotedSubtleSurfaceBrush}"
                        BorderBrush="{DynamicResource NotedWarningBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                    <TextBlock x:Name="PersistenceErrorText"
                               Foreground="{DynamicResource NotedWarningBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

    </Grid>
</noted:OverlayWindow>
