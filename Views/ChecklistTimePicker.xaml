<UserControl x:Class="Noted.ChecklistTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource NotedComboBox}">
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="MaxDropDownHeight" Value="220"/>
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource NotedScrollBar}"/>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal">
        <CheckBox x:Name="UseTime" Style="{StaticResource NotedCheckBox}" Content="Time"
                  Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="Include due time"
                  Checked="UseTime_Changed" Unchecked="UseTime_Changed"/>
        <StackPanel x:Name="ClockFields" Orientation="Horizontal">
        <ComboBox x:Name="HourChoice" AutomationProperties.Name="Hour" SelectionChanged="Clock_Changed"/>
        <TextBlock Text=":" Margin="3,0" VerticalAlignment="Center" Foreground="{DynamicResource NotedTextBrush}"/>
        <ComboBox x:Name="MinuteChoice" AutomationProperties.Name="Minute" SelectionChanged="Clock_Changed"/>
        <ComboBox x:Name="PeriodChoice" Margin="6,0,0,0" MinWidth="66" AutomationProperties.Name="AM or PM"
                  SelectionChanged="Clock_Changed"/>
        </StackPanel>
    </StackPanel>
</UserControl>
