<Window x:Class="Noted.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Note Editor"
        Width="900"
        Height="650"
        MinWidth="520"
        MinHeight="250"
        Background="#F5F9FC"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="EditorScrollBarThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#91C5DE" CornerRadius="3" Margin="1,2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Background" Value="#E6F2F8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource EditorScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorButton" TargetType="Button">
            <Setter Property="Background" Value="#5BA8C8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#4A97B7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#3F86A3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBackground" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBackground" Property="Background" Value="#DCEEF6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconBackground" Property="Background" Value="#C9E5F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorFindInput" TargetType="TextBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#A8CDE0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#355A6E"/>
            <Setter Property="CaretBrush" Value="#2C6E91"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EditorFindButton" TargetType="Button">
            <Setter Property="MinWidth" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#527386"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FindButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FindButtonBackground" Property="Background" Value="#DCEEF6"/>
                                <Setter Property="Foreground" Value="#2C6E91"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorFindToggle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#527386"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="FindToggleBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FindToggleBackground" Property="Background" Value="#DCEEF6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="FindToggleBackground" Property="Background" Value="#C9E5F2"/>
                                <Setter Property="Foreground" Value="#2C6E91"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Background="#F5F9FC">
        <Border DockPanel.Dock="Top"
                Padding="10,6"
                Background="#EFF7FB"
                BorderBrush="#C9DFEC"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ToggleTabsButton"
                            Margin="0,0,4,0"
                            Click="ToggleTabsButton_Click"
                            Style="{StaticResource HeaderIconButton}"
                            AutomationProperties.Name="Toggle tabs panel">
                        <Grid Width="14" Height="14">
                            <Border BorderBrush="#5F7480"
                                    BorderThickness="1"
                                    CornerRadius="1"/>
                            <Rectangle x:Name="TabsPanelIconSidebar"
                                       Width="4"
                                       Margin="2"
                                       HorizontalAlignment="Left"
                                       Fill="#5BA8C8"/>
                            <Border Width="1"
                                    Margin="6,2,0,2"
                                    HorizontalAlignment="Left"
                                    Background="#A8CDE0"/>
                        </Grid>
                    </Button>
                    <Menu Background="Transparent" Foreground="#355A6E" FontSize="12">
                        <MenuItem Header="File">
                            <MenuItem Header="New Note"
                                      InputGestureText="Ctrl+N"
                                      Click="NewNoteButton_Click"/>
                            <MenuItem Header="Save"
                                      InputGestureText="Ctrl+S"
                                      Click="SaveButton_Click"/>
                            <Separator/>
                            <MenuItem Header="Delete Note..."
                                      Click="DeleteActiveNoteMenuItem_Click"/>
                        </MenuItem>
                        <MenuItem Header="Edit">
                            <MenuItem Header="Undo"
                                      Command="ApplicationCommands.Undo"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <MenuItem Header="Redo"
                                      Command="ApplicationCommands.Redo"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <Separator/>
                            <MenuItem Header="Cut"
                                      Command="ApplicationCommands.Cut"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <MenuItem Header="Copy"
                                      Command="ApplicationCommands.Copy"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <MenuItem Header="Paste"
                                      Command="ApplicationCommands.Paste"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <Separator/>
                            <MenuItem Header="Select All"
                                      Command="ApplicationCommands.SelectAll"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <Separator/>
                            <MenuItem Header="Find..."
                                      InputGestureText="Ctrl+F"
                                      Click="FindMenuItem_Click"/>
                            <MenuItem Header="Replace..."
                                      InputGestureText="Ctrl+H"
                                      Click="ReplaceMenuItem_Click"/>
                        </MenuItem>
                        <MenuItem Header="View">
                            <MenuItem x:Name="HeaderWordWrapMenuItem"
                                      Header="Word Wrap"
                                      IsChecked="True"
                                      IsCheckable="True"
                                      Click="WordWrapMenuItem_Click"/>
                            <MenuItem x:Name="HeaderMarkdownMenuItem"
                                      Header="Markdown Preview"
                                      InputGestureText="Ctrl+Shift+V"
                                      IsCheckable="True"
                                      Click="MarkdownMenuItem_Click"/>
                            <Separator/>
                            <MenuItem x:Name="ReopenTabsOnStartupMenuItem"
                                      Header="Reopen Tabs on Startup"
                                      IsCheckable="True"
                                      Click="ReopenTabsOnStartupMenuItem_Click"/>
                            <MenuItem x:Name="TabsPanelMenuItem"
                                      Header="Show Tabs"
                                      InputGestureText="Ctrl+B"
                                      IsCheckable="True"
                                      Click="TabsPanelMenuItem_Click"/>
                        </MenuItem>
                    </Menu>
                    <TextBlock x:Name="DirtyStatusText"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#C9302C"
                               FontSize="11"
                               Text="Unsaved changes"
                               Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="FindButton"
                            Margin="0,0,6,0"
                            Click="FindButton_Click"
                            Style="{StaticResource HeaderIconButton}"
                            ToolTip="Find in note (Ctrl+F)"
                            AutomationProperties.Name="Find in note">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="#527386"
                                   Text="&#xE721;"/>
                    </Button>
                    <Button x:Name="SaveButton"
                            Width="58"
                            Height="26"
                            Click="SaveButton_Click"
                            Content="Save"
                            IsEnabled="False"
                            Style="{StaticResource EditorButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="PersistenceErrorPanel"
                DockPanel.Dock="Bottom"
                Padding="8,5"
                Background="#FFF4E5"
                BorderBrush="#E5A23B"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="PersistenceErrorText"
                       Foreground="#7A3E00"
                       FontSize="11"
                       TextWrapping="Wrap"/>
        </Border>

        <Border Margin="10"
                Padding="1"
                Background="White"
                BorderBrush="#C9DFEC"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TabsColumn" Width="190"/>
                    <ColumnDefinition x:Name="TabsSplitterColumn" Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="TabsPanel"
                        Grid.Column="0"
                        Background="#EFF7FB"
                        CornerRadius="7,0,0,7"
                        Padding="7">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="5,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="#66879A"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="OPEN NOTES"/>
                            <Button Grid.Column="1"
                                    Width="22"
                                    Height="22"
                                    Padding="2"
                                    Click="NewNoteButton_Click"
                                    Style="{StaticResource HeaderIconButton}"
                                    ToolTip="New note (Ctrl+N)"
                                    AutomationProperties.Name="New note">
                                <TextBlock Foreground="#355A6E"
                                           FontSize="17"
                                           FontWeight="Normal"
                                           LineHeight="17"
                                           Text="+"/>
                            </Button>
                        </Grid>

                        <ListBox x:Name="OpenTabsList"
                                 AllowDrop="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Drop="OpenTabsList_Drop"
                                 HorizontalContentAlignment="Stretch"
                                 PreviewMouseDown="OpenTabsList_PreviewMouseDown"
                                 PreviewMouseLeftButtonDown="OpenTabsList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="OpenTabsList_PreviewMouseMove"
                                 PreviewKeyDown="OpenTabsList_PreviewKeyDown"
                                 SelectionChanged="OpenTabsList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,0,3"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="TabBackground"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Padding="8,6">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TabBackground"
                                                                Property="Background"
                                                                Value="#E0F0F7"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="TabBackground"
                                                                Property="Background"
                                                                Value="#C9E5F2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ContextMenu>
                                            <ContextMenu Style="{StaticResource NotedContextMenu}">
                                                <ContextMenu.Resources>
                                                    <Style TargetType="MenuItem"
                                                           BasedOn="{StaticResource NotedContextMenuItem}"/>
                                                </ContextMenu.Resources>
                                                <MenuItem Header="Close Tab"
                                                          Click="CloseTabButton_Click"/>
                                                <MenuItem Header="Rename..."
                                                          Click="RenameTabNoteMenuItem_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Delete Note..."
                                                          Click="DeleteTabNoteMenuItem_Click"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="#355A6E"
                                                   FontSize="12"
                                                   Text="{Binding TabLabel}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FilePath}"/>
                                        <Button Grid.Column="1"
                                                Margin="7,0,0,0"
                                                Padding="2,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="CloseTabButton_Click"
                                                Content="×"
                                                Cursor="Hand"
                                                Foreground="#66879A"
                                                FontSize="14"
                                                ToolTip="Close tab"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="TabsSplitter"
                              Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              Background="#C9DFEC"
                              Cursor="SizeWE"
                              DragCompleted="TabsSplitter_DragCompleted"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns"/>

                <Grid Grid.Column="2">
                    <TextBox x:Name="EditorTextBox"
                             Padding="12"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             Background="White"
                             BorderThickness="0"
                             CaretBrush="#2C6E91"
                             Foreground="#333333"
                             FontFamily="Consolas"
                             FontSize="14"
                             HorizontalScrollBarVisibility="Disabled"
                             IsEnabled="False"
                             IsInactiveSelectionHighlightEnabled="True"
                             SelectionBrush="#91C5DE"
                             SpellCheck.IsEnabled="True"
                             TextChanged="EditorTextBox_TextChanged"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto">
                        <TextBox.ContextMenu>
                            <ContextMenu Style="{StaticResource NotedContextMenu}">
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem"
                                           BasedOn="{StaticResource NotedContextMenuItem}"/>
                                </ContextMenu.Resources>
                                <MenuItem Header="Undo" Command="ApplicationCommands.Undo"/>
                                <MenuItem Header="Redo" Command="ApplicationCommands.Redo"/>
                                <Separator/>
                                <MenuItem Header="Cut" Command="ApplicationCommands.Cut"/>
                                <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                                <MenuItem Header="Paste" Command="ApplicationCommands.Paste"/>
                                <Separator/>
                                <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll"/>
                                <Separator/>
                                <MenuItem x:Name="ContextWordWrapMenuItem"
                                          Header="Word Wrap"
                                          IsChecked="True"
                                          IsCheckable="True"
                                          Click="WordWrapMenuItem_Click"/>
                                <MenuItem x:Name="ContextMarkdownMenuItem"
                                          Header="Markdown Preview"
                                          InputGestureText="Ctrl+Shift+V"
                                          IsCheckable="True"
                                          Click="MarkdownMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="Delete Note..."
                                          Foreground="#B84F4F"
                                          Click="DeleteActiveNoteMenuItem_Click"/>
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>

                    <FlowDocumentScrollViewer x:Name="MarkdownPreview"
                                              Background="White"
                                              BorderThickness="0"
                                              IsToolBarVisible="False"
                                              Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto">
                        <FlowDocumentScrollViewer.ContextMenu>
                            <ContextMenu Background="#F5F9FC"
                                         BorderBrush="#A8CDE0"
                                         BorderThickness="1"
                                         Padding="4">
                                <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                                <Separator/>
                                <MenuItem x:Name="PreviewMarkdownMenuItem"
                                          Header="Markdown Preview"
                                          InputGestureText="Ctrl+Shift+V"
                                          IsCheckable="True"
                                          Click="MarkdownMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="Delete Note..."
                                          Foreground="#B84F4F"
                                          Click="DeleteActiveNoteMenuItem_Click"/>
                            </ContextMenu>
                        </FlowDocumentScrollViewer.ContextMenu>
                    </FlowDocumentScrollViewer>

                    <Border x:Name="FindPanel"
                            Panel.ZIndex="10"
                            Width="286"
                            Margin="8"
                            Padding="7"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#F5F9FC"
                            BorderBrush="#87CEEB"
                            BorderThickness="1"
                            CornerRadius="7"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12"
                                              ShadowDepth="3"
                                              Opacity="0.18"
                                              Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="ShowReplaceToggle"
                                              Click="ShowReplaceToggle_Click"
                                              ToolTip="Show replace">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton"
                                               BasedOn="{StaticResource EditorFindToggle}">
                                            <Setter Property="Content" Value="›"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Content" Value="⌄"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <TextBox x:Name="FindTextBox"
                                         Grid.Column="1"
                                         Margin="3,0,2,0"
                                         Style="{StaticResource EditorFindInput}"
                                         TextChanged="FindTextBox_TextChanged"
                                         PreviewKeyDown="FindTextBox_PreviewKeyDown"
                                         ToolTip="Find"/>
                                <Button Grid.Column="2"
                                        Content="↑"
                                        Click="FindPreviousButton_Click"
                                        Style="{StaticResource EditorFindButton}"
                                        ToolTip="Previous match (Shift+Enter)"/>
                                <Button Grid.Column="3"
                                        Content="↓"
                                        Click="FindNextButton_Click"
                                        Style="{StaticResource EditorFindButton}"
                                        ToolTip="Next match (Enter)"/>
                                <Button Grid.Column="4"
                                        Content="×"
                                        Click="CloseFindButton_Click"
                                        Style="{StaticResource EditorFindButton}"
                                        ToolTip="Close (Escape)"/>
                            </Grid>

                            <Grid x:Name="ReplaceRow"
                                  Margin="28,5,0,0"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ReplaceTextBox"
                                         Margin="0,0,2,0"
                                         Style="{StaticResource EditorFindInput}"
                                         ToolTip="Replace with"/>
                                <Button x:Name="ReplaceButton"
                                        Grid.Column="1"
                                        Content="Replace"
                                        Click="ReplaceButton_Click"
                                        Style="{StaticResource EditorFindButton}"/>
                                <Button x:Name="ReplaceAllButton"
                                        Grid.Column="2"
                                        Content="All"
                                        Click="ReplaceAllButton_Click"
                                        Style="{StaticResource EditorFindButton}"
                                        ToolTip="Replace all"/>
                            </Grid>

                            <Grid Margin="31,4,2,0">
                                <CheckBox x:Name="MatchCaseOption"
                                          Content="Match case"
                                          Checked="MatchCaseOption_Changed"
                                          Unchecked="MatchCaseOption_Changed"
                                          Foreground="#5F7480"
                                          FontSize="10"/>
                                <TextBlock x:Name="FindResultText"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="#78909C"
                                           FontSize="10"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</Window>
