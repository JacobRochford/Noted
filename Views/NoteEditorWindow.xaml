<Window x:Class="Noted.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Note Editor"
        Width="900"
        Height="650"
        MinWidth="520"
        MinHeight="250"
        Background="{DynamicResource NotedWindowBackgroundBrush}"
        Foreground="{DynamicResource NotedTextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource NotedScrollBar}"/>

        <Style x:Key="EditorButton" TargetType="Button" BasedOn="{StaticResource NotedPrimaryButton}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>

        <Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource NotedHeaderIconButton}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style x:Key="TabCloseButton"
               TargetType="Button"
               BasedOn="{StaticResource NotedHeaderIconButton}">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style x:Key="EditorFindInput" TargetType="TextBox" BasedOn="{StaticResource NotedTextInput}">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EditorFindButton" TargetType="Button">
            <Setter Property="MinWidth" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource NotedSecondaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FindButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FindButtonBackground" Property="Background" Value="{DynamicResource NotedAccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotedAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorFindToggle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource NotedSecondaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="FindToggleBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FindToggleBackground" Property="Background" Value="{DynamicResource NotedAccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="FindToggleBackground" Property="Background" Value="{DynamicResource NotedAccentSoftHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotedAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Background="{DynamicResource NotedWindowBackgroundBrush}">
        <Border DockPanel.Dock="Top"
                Padding="10,6"
                Background="{DynamicResource NotedSubtleSurfaceBrush}"
                BorderBrush="{DynamicResource NotedBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ToggleTabsButton"
                            Margin="0,0,4,0"
                            Click="ToggleTabsButton_Click"
                            Style="{StaticResource HeaderIconButton}"
                            AutomationProperties.Name="Toggle tabs panel">
                        <Grid Width="14" Height="14">
                            <Border BorderBrush="{DynamicResource NotedSecondaryTextBrush}"
                                    BorderThickness="1"
                                    CornerRadius="1"/>
                            <Rectangle x:Name="TabsPanelIconSidebar"
                                       Width="4"
                                       Margin="2"
                                       HorizontalAlignment="Left"
                                       Fill="{DynamicResource NotedAccentBrush}"/>
                            <Border Width="1"
                                    Margin="6,2,0,2"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource NotedStrongBorderBrush}"/>
                        </Grid>
                    </Button>
                    <Menu Background="Transparent"
                          Foreground="{DynamicResource NotedTextBrush}"
                          FontSize="12">
                        <Menu.Resources>
                            <Style TargetType="MenuItem"
                                   BasedOn="{StaticResource NotedMenuItem}"/>
                            <Style TargetType="Separator"
                                   BasedOn="{StaticResource NotedMenuSeparator}"/>
                        </Menu.Resources>
                        <MenuItem Header="File">
                            <MenuItem Header="New Note"
                                      InputGestureText="Ctrl+N"
                                      Click="NewNoteButton_Click"/>
                            <MenuItem Header="Save"
                                      InputGestureText="Ctrl+S"
                                      Click="SaveButton_Click"/>
                            <MenuItem Header="Save As..."
                                      InputGestureText="Ctrl+Shift+S"
                                      Click="SaveAsMenuItem_Click"/>
                            <MenuItem Header="Show in File Explorer"
                                      InputGestureText="Ctrl+O"
                                      Click="ShowInFileExplorerMenuItem_Click"/>
                            <MenuItem x:Name="FileExplorerIntegrationMenuItem"
                                      Header="Add 'Open with Noted' to File Explorer"
                                      IsCheckable="True"
                                      Click="FileExplorerIntegrationMenuItem_Click"/>
                            <Separator/>
                            <MenuItem Header="Delete Note..."
                                      Click="DeleteActiveNoteMenuItem_Click"/>
                        </MenuItem>
                        <MenuItem Header="Edit">
                            <MenuItem Header="Undo"
                                      Command="ApplicationCommands.Undo"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <MenuItem Header="Redo"
                                      Command="ApplicationCommands.Redo"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <Separator/>
                            <MenuItem Header="Cut"
                                      Command="ApplicationCommands.Cut"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <MenuItem Header="Copy"
                                      Command="ApplicationCommands.Copy"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <MenuItem Header="Paste"
                                      Command="ApplicationCommands.Paste"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <Separator/>
                            <MenuItem Header="Select All"
                                      Command="ApplicationCommands.SelectAll"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <Separator/>
                            <MenuItem Header="Find..."
                                      InputGestureText="Ctrl+F"
                                      Click="FindMenuItem_Click"/>
                            <MenuItem Header="Replace..."
                                      InputGestureText="Ctrl+H"
                                      Click="ReplaceMenuItem_Click"/>
                        </MenuItem>
                        <MenuItem Header="View">
                            <MenuItem x:Name="HeaderWordWrapMenuItem"
                                      Header="Word Wrap"
                                      IsChecked="True"
                                      IsCheckable="True"
                                      Click="WordWrapMenuItem_Click"/>
                            <MenuItem x:Name="HeaderMarkdownMenuItem"
                                      Header="Markdown Preview"
                                      InputGestureText="Ctrl+Shift+V"
                                      IsCheckable="True"
                                      Click="MarkdownMenuItem_Click"/>
                            <Separator/>
                            <MenuItem x:Name="ReopenTabsOnStartupMenuItem"
                                      Header="Reopen Tabs on Startup"
                                      IsCheckable="True"
                                      Click="ReopenTabsOnStartupMenuItem_Click"/>
                            <MenuItem x:Name="TabsPanelMenuItem"
                                      Header="Show Tabs"
                                      InputGestureText="Ctrl+B"
                                      IsCheckable="True"
                                      Click="TabsPanelMenuItem_Click"/>
                        </MenuItem>
                    </Menu>
                    <TextBlock x:Name="DirtyStatusText"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource NotedDangerBrush}"
                               FontSize="11"
                               Text="Unsaved changes"
                               Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="FindButton"
                            Margin="0,0,6,0"
                            Click="FindButton_Click"
                            Style="{StaticResource HeaderIconButton}"
                            ToolTip="Find in note (Ctrl+F)"
                            AutomationProperties.Name="Find in note">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                   Text="&#xE721;"/>
                    </Button>
                    <Button x:Name="SaveButton"
                            Width="58"
                            Height="26"
                            Click="SaveButton_Click"
                            Content="Save"
                            IsEnabled="False"
                            Style="{StaticResource EditorButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="PersistenceErrorPanel"
                DockPanel.Dock="Bottom"
                Padding="8,5"
                Background="{DynamicResource NotedSubtleSurfaceBrush}"
                BorderBrush="{DynamicResource NotedWarningBrush}"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="PersistenceErrorText"
                       Foreground="{DynamicResource NotedWarningBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"/>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Margin="10,0,10,8"
                Padding="6,3"
                Background="{DynamicResource NotedSubtleSurfaceBrush}"
                BorderBrush="{DynamicResource NotedBorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DocumentCountText"
                           Foreground="{DynamicResource NotedSecondaryTextBrush}"
                           FontSize="10"/>
                <TextBlock x:Name="DocumentTimeText"
                           Grid.Column="1"
                           Margin="14,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource NotedMutedTextBrush}"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CaretPositionText"
                           Grid.Column="2"
                           Foreground="{DynamicResource NotedSecondaryTextBrush}"
                           FontSize="10"/>
            </Grid>
        </Border>

        <Border Margin="10"
                Padding="1"
                Background="{DynamicResource NotedSurfaceBrush}"
                BorderBrush="{DynamicResource NotedBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TabsColumn" Width="190"/>
                    <ColumnDefinition x:Name="TabsSplitterColumn" Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="TabsPanel"
                        Grid.Column="0"
                        Background="{DynamicResource NotedSubtleSurfaceBrush}"
                        CornerRadius="7,0,0,7"
                        Padding="7">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="5,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="OPEN NOTES"/>
                        </Grid>

                        <Button DockPanel.Dock="Bottom"
                                Margin="0,5,0,0"
                                Padding="8,6"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                Cursor="Hand"
                                Click="NewNoteButton_Click"
                                ToolTip="New note (Ctrl+N)"
                                AutomationProperties.Name="New note">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="NewTabBackground"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="1,0,7,0"
                                                       FontSize="16"
                                                       LineHeight="16"
                                                       Text="+"/>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Text="New note"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NewTabBackground"
                                                    Property="Background"
                                                    Value="{DynamicResource NotedAccentSoftBrush}"/>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource NotedAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <ListBox x:Name="OpenTabsList"
                                 AllowDrop="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Drop="OpenTabsList_Drop"
                                 HorizontalContentAlignment="Stretch"
                                 PreviewMouseDown="OpenTabsList_PreviewMouseDown"
                                 PreviewMouseLeftButtonDown="OpenTabsList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="OpenTabsList_PreviewMouseMove"
                                 PreviewKeyDown="OpenTabsList_PreviewKeyDown"
                                 SelectionChanged="OpenTabsList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,0,3"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="TabBackground"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Padding="8,6">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TabBackground"
                                                                Property="Background"
                                                                Value="{DynamicResource NotedAccentSoftBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="TabBackground"
                                                                Property="Background"
                                                                Value="{DynamicResource NotedAccentSoftHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ContextMenu>
                                            <ContextMenu Style="{StaticResource NotedContextMenu}">
                                                <ContextMenu.Resources>
                                                    <Style TargetType="MenuItem"
                                                           BasedOn="{StaticResource NotedContextMenuItem}"/>
                                                </ContextMenu.Resources>
                                                <MenuItem Header="Close Tab"
                                                          Click="CloseTabButton_Click"/>
                                                <MenuItem Header="Rename..."
                                                          Click="RenameTabNoteMenuItem_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Delete Note..."
                                                          Click="DeleteTabNoteMenuItem_Click"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{DynamicResource NotedTextBrush}"
                                                   FontSize="12"
                                                   Text="{Binding TabLabel}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FilePath}"/>
                                        <Button Grid.Column="1"
                                                Margin="7,0,0,0"
                                                Click="CloseTabButton_Click"
                                                Content="&#xE711;"
                                                Style="{StaticResource TabCloseButton}"
                                                ToolTip="Close tab"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="TabsSplitter"
                              Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource NotedBorderBrush}"
                              Cursor="SizeWE"
                              DragCompleted="TabsSplitter_DragCompleted"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns"/>

                <Grid x:Name="EditorWorkspace"
                      Grid.Column="2"
                      AllowDrop="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="EditorSplitterColumn" Width="0"/>
                        <ColumnDefinition x:Name="SecondaryEditorColumn" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="PrimaryEditorPane" Grid.Column="0">
                    <TextBox x:Name="EditorTextBox"
                             Padding="12"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             Background="{DynamicResource NotedInputBackgroundBrush}"
                             BorderThickness="0"
                             CaretBrush="{DynamicResource NotedAccentBrush}"
                             Foreground="{DynamicResource NotedTextBrush}"
                             FontFamily="Consolas"
                             FontSize="14"
                             HorizontalScrollBarVisibility="Disabled"
                             IsEnabled="False"
                             IsInactiveSelectionHighlightEnabled="True"
                             SelectionBrush="{DynamicResource NotedAccentSoftHoverBrush}"
                             SpellCheck.IsEnabled="True"
                             GotKeyboardFocus="EditorTextBox_GotKeyboardFocus"
                             SelectionChanged="EditorTextBox_SelectionChanged"
                             TextChanged="EditorTextBox_TextChanged"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto">
                        <TextBox.ContextMenu>
                            <ContextMenu Style="{StaticResource NotedContextMenu}">
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem"
                                           BasedOn="{StaticResource NotedContextMenuItem}"/>
                                </ContextMenu.Resources>
                                <MenuItem Header="Undo" Command="ApplicationCommands.Undo"/>
                                <MenuItem Header="Redo" Command="ApplicationCommands.Redo"/>
                                <Separator/>
                                <MenuItem Header="Cut" Command="ApplicationCommands.Cut"/>
                                <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                                <MenuItem Header="Paste" Command="ApplicationCommands.Paste"/>
                                <Separator/>
                                <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll"/>
                                <Separator/>
                                <MenuItem x:Name="ContextWordWrapMenuItem"
                                          Header="Word Wrap"
                                          IsChecked="True"
                                          IsCheckable="True"
                                          Click="WordWrapMenuItem_Click"/>
                                <MenuItem x:Name="ContextMarkdownMenuItem"
                                          Header="Markdown Preview"
                                          InputGestureText="Ctrl+Shift+V"
                                          IsCheckable="True"
                                          Click="MarkdownMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="Delete Note..."
                                          Foreground="{DynamicResource NotedDangerBrush}"
                                          Click="DeleteActiveNoteMenuItem_Click"/>
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>

                    <FlowDocumentScrollViewer x:Name="MarkdownPreview"
                                              Background="{DynamicResource NotedInputBackgroundBrush}"
                                              Foreground="{DynamicResource NotedTextBrush}"
                                              BorderThickness="0"
                                              IsToolBarVisible="False"
                                              Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto">
                        <FlowDocumentScrollViewer.ContextMenu>
                            <ContextMenu Style="{StaticResource NotedContextMenu}">
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem"
                                           BasedOn="{StaticResource NotedContextMenuItem}"/>
                                </ContextMenu.Resources>
                                <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                                <Separator/>
                                <MenuItem x:Name="PreviewMarkdownMenuItem"
                                          Header="Markdown Preview"
                                          InputGestureText="Ctrl+Shift+V"
                                          IsCheckable="True"
                                          Click="MarkdownMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="Delete Note..."
                                          Foreground="{DynamicResource NotedDangerBrush}"
                                          Click="DeleteActiveNoteMenuItem_Click"/>
                            </ContextMenu>
                        </FlowDocumentScrollViewer.ContextMenu>
                    </FlowDocumentScrollViewer>
                    </Grid>

                    <Border x:Name="FindPanel"
                            Grid.Column="0"
                            Panel.ZIndex="10"
                            Width="286"
                            Margin="8"
                            Padding="7"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource NotedSurfaceBrush}"
                            BorderBrush="{DynamicResource NotedAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12"
                                              ShadowDepth="3"
                                              Opacity="0.18"
                                              Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="ShowReplaceToggle"
                                              Click="ShowReplaceToggle_Click"
                                              ToolTip="Show replace">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton"
                                               BasedOn="{StaticResource EditorFindToggle}">
                                            <Setter Property="Content" Value="›"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Content" Value="⌄"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <TextBox x:Name="FindTextBox"
                                         Grid.Column="1"
                                         Margin="3,0,2,0"
                                         Style="{StaticResource EditorFindInput}"
                                         TextChanged="FindTextBox_TextChanged"
                                         PreviewKeyDown="FindTextBox_PreviewKeyDown"
                                         ToolTip="Find"/>
                                <Button Grid.Column="2"
                                        Content="↑"
                                        Click="FindPreviousButton_Click"
                                        Style="{StaticResource EditorFindButton}"
                                        ToolTip="Previous match (Shift+Enter)"/>
                                <Button Grid.Column="3"
                                        Content="↓"
                                        Click="FindNextButton_Click"
                                        Style="{StaticResource EditorFindButton}"
                                        ToolTip="Next match (Enter)"/>
                                <Button Grid.Column="4"
                                        Content="×"
                                        Click="CloseFindButton_Click"
                                        Style="{StaticResource EditorFindButton}"
                                        ToolTip="Close (Escape)"/>
                            </Grid>

                            <Grid x:Name="ReplaceRow"
                                  Margin="28,5,0,0"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ReplaceTextBox"
                                         Margin="0,0,2,0"
                                         Style="{StaticResource EditorFindInput}"
                                         ToolTip="Replace with"/>
                                <Button x:Name="ReplaceButton"
                                        Grid.Column="1"
                                        Content="Replace"
                                        Click="ReplaceButton_Click"
                                        Style="{StaticResource EditorFindButton}"/>
                                <Button x:Name="ReplaceAllButton"
                                        Grid.Column="2"
                                        Content="All"
                                        Click="ReplaceAllButton_Click"
                                        Style="{StaticResource EditorFindButton}"
                                        ToolTip="Replace all"/>
                            </Grid>

                            <Grid Margin="31,4,2,0">
                                <CheckBox x:Name="MatchCaseOption"
                                          Content="Match case"
                                          Checked="MatchCaseOption_Changed"
                                          Unchecked="MatchCaseOption_Changed"
                                          Style="{StaticResource NotedCheckBox}"
                                          FontSize="10"/>
                                <TextBlock x:Name="FindResultText"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                           FontSize="10"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <GridSplitter x:Name="EditorSplitter"
                                  Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  Background="{DynamicResource NotedBorderBrush}"
                                  Cursor="SizeWE"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Columns"
                                  Visibility="Collapsed"/>

                    <Border x:Name="SecondaryEditorPane"
                            Grid.Column="2"
                            Background="{DynamicResource NotedInputBackgroundBrush}"
                            BorderBrush="{DynamicResource NotedAccentBrush}"
                            BorderThickness="1,0,0,0"
                            Visibility="Collapsed">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Padding="9,5"
                                    Background="{DynamicResource NotedSubtleSurfaceBrush}"
                                    BorderBrush="{DynamicResource NotedBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock x:Name="SecondaryDocumentTitle"
                                               Margin="0,0,28,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button HorizontalAlignment="Right"
                                            Content="&#xE711;"
                                            Click="CloseSecondaryPaneButton_Click"
                                            Style="{StaticResource TabCloseButton}"
                                            ToolTip="Close side-by-side view"/>
                                </Grid>
                            </Border>
                            <TextBox x:Name="SecondaryEditorTextBox"
                                     Padding="12"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     Background="{DynamicResource NotedInputBackgroundBrush}"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource NotedAccentBrush}"
                                     Foreground="{DynamicResource NotedTextBrush}"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     HorizontalScrollBarVisibility="Disabled"
                                     IsInactiveSelectionHighlightEnabled="True"
                                     SelectionBrush="{DynamicResource NotedAccentSoftHoverBrush}"
                                     SpellCheck.IsEnabled="True"
                                     GotKeyboardFocus="SecondaryEditorTextBox_GotKeyboardFocus"
                                     SelectionChanged="SecondaryEditorTextBox_SelectionChanged"
                                     TextChanged="SecondaryEditorTextBox_TextChanged"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto">
                                <TextBox.ContextMenu>
                                    <ContextMenu Style="{StaticResource NotedContextMenu}">
                                        <ContextMenu.Resources>
                                            <Style TargetType="MenuItem"
                                                   BasedOn="{StaticResource NotedContextMenuItem}"/>
                                        </ContextMenu.Resources>
                                        <MenuItem Header="Undo" Command="ApplicationCommands.Undo"/>
                                        <MenuItem Header="Redo" Command="ApplicationCommands.Redo"/>
                                        <Separator/>
                                        <MenuItem Header="Cut" Command="ApplicationCommands.Cut"/>
                                        <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                                        <MenuItem Header="Paste" Command="ApplicationCommands.Paste"/>
                                        <Separator/>
                                        <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll"/>
                                        <Separator/>
                                        <MenuItem Header="Delete Note..."
                                                  Foreground="{DynamicResource NotedDangerBrush}"
                                                  Click="DeleteActiveNoteMenuItem_Click"/>
                                    </ContextMenu>
                                </TextBox.ContextMenu>
                            </TextBox>
                        </DockPanel>
                    </Border>

                    <Border x:Name="SideBySideDropTarget"
                            Panel.ZIndex="20"
                            Width="190"
                            Margin="10"
                            Padding="12"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            AllowDrop="True"
                            Background="{DynamicResource NotedAccentSoftBrush}"
                            BorderBrush="{DynamicResource NotedAccentBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            DragOver="SideBySideDropTarget_DragOver"
                            Drop="SideBySideDropTarget_Drop"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{DynamicResource NotedAccentBrush}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Text="&#xE71D;"/>
                            <TextBlock Margin="0,7,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource NotedTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="Open side by side"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</Window>
