<Window x:Class="Noted.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Note Editor"
        Width="900"
        Height="650"
        MinWidth="520"
        MinHeight="250"
        Background="#F5F9FC"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="EditorScrollBarThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#91C5DE" CornerRadius="3" Margin="1,2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Background" Value="#E6F2F8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource EditorScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorButton" TargetType="Button">
            <Setter Property="Background" Value="#5BA8C8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#4A97B7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#3F86A3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBackground" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBackground" Property="Background" Value="#DCEEF6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconBackground" Property="Background" Value="#C9E5F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Background="#F5F9FC">
        <Border DockPanel.Dock="Top"
                Padding="10,6"
                Background="#EFF7FB"
                BorderBrush="#C9DFEC"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ToggleTabsButton"
                            Margin="0,0,4,0"
                            Click="ToggleTabsButton_Click"
                            Style="{StaticResource HeaderIconButton}"
                            AutomationProperties.Name="Toggle tabs panel">
                        <Grid Width="14" Height="14">
                            <Border BorderBrush="#5F7480"
                                    BorderThickness="1"
                                    CornerRadius="1"/>
                            <Rectangle x:Name="TabsPanelIconSidebar"
                                       Width="4"
                                       Margin="2"
                                       HorizontalAlignment="Left"
                                       Fill="#5BA8C8"/>
                            <Border Width="1"
                                    Margin="6,2,0,2"
                                    HorizontalAlignment="Left"
                                    Background="#A8CDE0"/>
                        </Grid>
                    </Button>
                    <Menu Background="Transparent" Foreground="#355A6E" FontSize="12">
                        <MenuItem Header="File">
                            <MenuItem Header="New Note"
                                      InputGestureText="Ctrl+N"
                                      Click="NewNoteButton_Click"/>
                            <MenuItem Header="Save"
                                      InputGestureText="Ctrl+S"
                                      Click="SaveButton_Click"/>
                            <Separator/>
                            <MenuItem Header="Delete Note..."
                                      Click="DeleteActiveNoteMenuItem_Click"/>
                        </MenuItem>
                        <MenuItem Header="Edit">
                            <MenuItem Header="Undo"
                                      Command="ApplicationCommands.Undo"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <MenuItem Header="Redo"
                                      Command="ApplicationCommands.Redo"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <Separator/>
                            <MenuItem Header="Cut"
                                      Command="ApplicationCommands.Cut"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <MenuItem Header="Copy"
                                      Command="ApplicationCommands.Copy"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <MenuItem Header="Paste"
                                      Command="ApplicationCommands.Paste"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                            <Separator/>
                            <MenuItem Header="Select All"
                                      Command="ApplicationCommands.SelectAll"
                                      CommandTarget="{Binding ElementName=EditorTextBox}"/>
                        </MenuItem>
                        <MenuItem Header="View">
                            <MenuItem x:Name="HeaderWordWrapMenuItem"
                                      Header="Word Wrap"
                                      IsChecked="True"
                                      IsCheckable="True"
                                      Click="WordWrapMenuItem_Click"/>
                            <MenuItem x:Name="HeaderMarkdownMenuItem"
                                      Header="Markdown Preview"
                                      InputGestureText="Ctrl+Shift+V"
                                      IsCheckable="True"
                                      Click="MarkdownMenuItem_Click"/>
                            <Separator/>
                            <MenuItem x:Name="RestoreSessionMenuItem"
                                      Header="Reopen Tabs on Startup"
                                      IsCheckable="True"
                                      Click="RestoreSessionMenuItem_Click"/>
                            <MenuItem x:Name="TabsPanelMenuItem"
                                      Header="Show Tabs"
                                      InputGestureText="Ctrl+B"
                                      IsCheckable="True"
                                      Click="TabsPanelMenuItem_Click"/>
                        </MenuItem>
                    </Menu>
                    <TextBlock x:Name="DirtyStatusText"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#C9302C"
                               FontSize="11"
                               Text="Unsaved changes"
                               Visibility="Collapsed"/>
                </StackPanel>

                <Button x:Name="SaveButton"
                        Grid.Column="1"
                        Width="58"
                        Height="26"
                        VerticalAlignment="Center"
                        Click="SaveButton_Click"
                        Content="Save"
                        IsEnabled="False"
                        Style="{StaticResource EditorButton}"/>
            </Grid>
        </Border>

        <Border x:Name="PersistenceErrorPanel"
                DockPanel.Dock="Bottom"
                Padding="8,5"
                Background="#FFF4E5"
                BorderBrush="#E5A23B"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="PersistenceErrorText"
                       Foreground="#7A3E00"
                       FontSize="11"
                       TextWrapping="Wrap"/>
        </Border>

        <Border Margin="10"
                Padding="1"
                Background="White"
                BorderBrush="#C9DFEC"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TabsColumn" Width="190"/>
                    <ColumnDefinition x:Name="TabsSplitterColumn" Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="TabsPanel"
                        Grid.Column="0"
                        Background="#EFF7FB"
                        CornerRadius="7,0,0,7"
                        Padding="7">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="5,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="#66879A"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="OPEN NOTES"/>
                            <Button Grid.Column="1"
                                    Width="22"
                                    Height="22"
                                    Padding="2"
                                    Click="NewNoteButton_Click"
                                    Style="{StaticResource HeaderIconButton}"
                                    ToolTip="New note (Ctrl+N)"
                                    AutomationProperties.Name="New note">
                                <TextBlock Foreground="#355A6E"
                                           FontSize="17"
                                           FontWeight="Normal"
                                           LineHeight="17"
                                           Text="+"/>
                            </Button>
                        </Grid>

                        <ListBox x:Name="OpenTabsList"
                                 AllowDrop="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Drop="OpenTabsList_Drop"
                                 HorizontalContentAlignment="Stretch"
                                 PreviewMouseLeftButtonDown="OpenTabsList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="OpenTabsList_PreviewMouseMove"
                                 SelectionChanged="OpenTabsList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,0,3"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="TabBackground"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Padding="8,6">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TabBackground"
                                                                Property="Background"
                                                                Value="#E0F0F7"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="TabBackground"
                                                                Property="Background"
                                                                Value="#C9E5F2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ContextMenu>
                                            <ContextMenu Style="{StaticResource NotedContextMenu}">
                                                <ContextMenu.Resources>
                                                    <Style TargetType="MenuItem"
                                                           BasedOn="{StaticResource NotedContextMenuItem}"/>
                                                </ContextMenu.Resources>
                                                <MenuItem Header="Close Tab"
                                                          Click="CloseTabButton_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Delete Note..."
                                                          Click="DeleteTabNoteMenuItem_Click"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="#355A6E"
                                                   FontSize="12"
                                                   Text="{Binding TabLabel}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FilePath}"/>
                                        <Button Grid.Column="1"
                                                Margin="7,0,0,0"
                                                Padding="2,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="CloseTabButton_Click"
                                                Content="×"
                                                Cursor="Hand"
                                                Foreground="#66879A"
                                                FontSize="14"
                                                ToolTip="Close tab"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="TabsSplitter"
                              Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              Background="#C9DFEC"
                              Cursor="SizeWE"
                              DragCompleted="TabsSplitter_DragCompleted"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns"/>

                <Grid Grid.Column="2">
                    <TextBox x:Name="EditorTextBox"
                             Padding="12"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             Background="White"
                             BorderThickness="0"
                             CaretBrush="#2C6E91"
                             Foreground="#333333"
                             FontFamily="Consolas"
                             FontSize="14"
                             HorizontalScrollBarVisibility="Disabled"
                             IsEnabled="False"
                             SelectionBrush="#91C5DE"
                             SpellCheck.IsEnabled="True"
                             TextChanged="EditorTextBox_TextChanged"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto">
                        <TextBox.ContextMenu>
                            <ContextMenu Style="{StaticResource NotedContextMenu}">
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem"
                                           BasedOn="{StaticResource NotedContextMenuItem}"/>
                                </ContextMenu.Resources>
                                <MenuItem Header="Undo" Command="ApplicationCommands.Undo"/>
                                <MenuItem Header="Redo" Command="ApplicationCommands.Redo"/>
                                <Separator/>
                                <MenuItem Header="Cut" Command="ApplicationCommands.Cut"/>
                                <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                                <MenuItem Header="Paste" Command="ApplicationCommands.Paste"/>
                                <Separator/>
                                <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll"/>
                                <Separator/>
                                <MenuItem x:Name="ContextWordWrapMenuItem"
                                          Header="Word Wrap"
                                          IsChecked="True"
                                          IsCheckable="True"
                                          Click="WordWrapMenuItem_Click"/>
                                <MenuItem x:Name="ContextMarkdownMenuItem"
                                          Header="Markdown Preview"
                                          InputGestureText="Ctrl+Shift+V"
                                          IsCheckable="True"
                                          Click="MarkdownMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="Delete Note..."
                                          Foreground="#B84F4F"
                                          Click="DeleteActiveNoteMenuItem_Click"/>
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>

                    <FlowDocumentScrollViewer x:Name="MarkdownPreview"
                                              Background="White"
                                              BorderThickness="0"
                                              IsToolBarVisible="False"
                                              Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto">
                        <FlowDocumentScrollViewer.ContextMenu>
                            <ContextMenu Background="#F5F9FC"
                                         BorderBrush="#A8CDE0"
                                         BorderThickness="1"
                                         Padding="4">
                                <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                                <Separator/>
                                <MenuItem x:Name="PreviewMarkdownMenuItem"
                                          Header="Markdown Preview"
                                          InputGestureText="Ctrl+Shift+V"
                                          IsCheckable="True"
                                          Click="MarkdownMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="Delete Note..."
                                          Foreground="#B84F4F"
                                          Click="DeleteActiveNoteMenuItem_Click"/>
                            </ContextMenu>
                        </FlowDocumentScrollViewer.ContextMenu>
                    </FlowDocumentScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</Window>
