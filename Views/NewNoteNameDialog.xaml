<Window x:Class="Noted.NewNoteNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Note"
        Width="380"
        Height="245"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{DynamicResource NotedTextBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="DialogTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource NotedTextInput}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style x:Key="DialogButton"
               TargetType="Button"
               BasedOn="{StaticResource NotedSecondaryButton}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <Style x:Key="PrimaryDialogButton"
               TargetType="Button"
               BasedOn="{StaticResource NotedPrimaryButton}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border Margin="8"
                Background="{DynamicResource NotedWindowBackgroundBrush}"
                BorderBrush="{DynamicResource NotedStrongBorderBrush}"
                BorderThickness="1"
                CornerRadius="9">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14"
                                  Direction="270"
                                  Opacity="0.18"
                                  ShadowDepth="4"
                                  Color="#000000"/>
            </Border.Effect>

            <Grid Margin="14,10,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="2,0,0,8"
                        Background="Transparent"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource NotedAccentBrush}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#xE70F;"/>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource NotedTextBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="30"
                                Height="30"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource NotedHeaderIconButton}"
                                Click="CancelButton_Click"
                                ToolTip="Close"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,0,0,14"
                        BorderBrush="{DynamicResource NotedBorderBrush}"
                        BorderThickness="0,1,0,0"/>

                <TextBlock x:Name="PromptText"
                           Grid.Row="2"
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource NotedTextBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="Enter note title"/>

                <TextBox x:Name="NoteNameTextBox"
                         Grid.Row="3"
                         MinWidth="260"
                         VerticalAlignment="Top"
                         TextChanged="NoteNameTextBox_TextChanged"
                         KeyDown="NoteNameTextBox_KeyDown"
                         Style="{StaticResource DialogTextBox}"/>

                <StackPanel Grid.Row="4"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Content="Cancel"
                            Click="CancelButton_Click"
                            Style="{StaticResource DialogButton}"/>
                    <Button x:Name="ConfirmButton"
                            Content="Create"
                            Click="ConfirmButton_Click"
                            Style="{StaticResource PrimaryDialogButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
