<noted:OverlayWindow x:Class="Noted.DictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:noted="clr-namespace:Noted"
        Title="Dictionary"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="400"
        Height="500"
        Left="200"
        Top="150"
        MinWidth="300"
        MinHeight="350">

    <noted:OverlayWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource NotedScrollBar}"/>
        <Style x:Key="HeaderIconBtn"
               TargetType="Button"
               BasedOn="{StaticResource NotedHeaderIconButton}"/>

        <Style x:Key="DetailsButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderIconBtn}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Content" Value="&#xE70F;"/>
            <Setter Property="Foreground" Value="{DynamicResource NotedSecondaryTextBrush}"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource NotedPrimaryButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DictionaryTextBox" TargetType="TextBox" BasedOn="{StaticResource NotedTextInput}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </noted:OverlayWindow.Resources>

    <Grid Background="Transparent">
        <Border Margin="1"
                Background="{DynamicResource NotedWindowBackgroundBrush}"
                BorderBrush="{DynamicResource NotedStrongBorderBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                        Padding="2,1,0,8" Cursor="SizeAll">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="Aa" Margin="0,0,8,0" Foreground="{DynamicResource NotedAccentBrush}"
                                       FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Dictionary" Foreground="{DynamicResource NotedTextBrush}"
                                       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="⚠" Margin="8,0,0,0" Foreground="{DynamicResource NotedWarningBrush}"
                                       FontSize="12" VerticalAlignment="Center"
                                       Visibility="{Binding HasPersistenceError, Converter={StaticResource BoolToVisibility}}"
                                       ToolTip="{Binding PersistenceError}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="&#xE711;"
                                Style="{StaticResource HeaderIconBtn}"
                                Click="HideButton_Click" ToolTip="Hide"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,0,0,7" Padding="9,0"
                        Height="34"
                        Background="{DynamicResource NotedInputBackgroundBrush}"
                        BorderBrush="{DynamicResource NotedBorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,0,7,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                   Text="&#xE721;"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchTextBox"
                                     Padding="0"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource NotedTextBrush}"
                                     CaretBrush="{DynamicResource NotedAccentBrush}"
                                     SelectionBrush="{DynamicResource NotedAccentSoftHoverBrush}"
                                     FontSize="12"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Margin="1,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource NotedMutedTextBrush}"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Text="Search words or definitions...">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=SearchTextBox}" Value=""/>
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchTextBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{DynamicResource NotedSurfaceBrush}"
                        BorderBrush="{DynamicResource NotedBorderBrush}"
                        BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ItemsList"
                                          ItemsSource="{Binding FilteredItems}"
                                          Padding="5"
                                          Focusable="True"
                                          FocusVisualStyle="{x:Null}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,1" Padding="5,0,4,0" CornerRadius="6"
                                                PreviewMouseRightButtonDown="DictionaryItem_PreviewMouseRightButtonDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource NotedAccentSoftBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.ContextMenu>
                                                <ContextMenu Style="{StaticResource NotedContextMenu}"
                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Delete word" Foreground="{DynamicResource NotedDangerBrush}"
                                                              Style="{StaticResource NotedContextMenuItem}"
                                                              Click="DeleteWordMenuItem_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" MinHeight="43">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="WordTextBox" Grid.Column="0"
                                                             Style="{StaticResource DictionaryTextBox}"
                                                             Text="{Binding Word, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="13" FontWeight="SemiBold"/>
                                                    <Button Grid.Column="1" Style="{StaticResource DetailsButtonStyle}"
                                                            Tag="{Binding}" Click="EditDefinitionButton_Click"
                                                            ToolTip="Edit definition"/>
                                                </Grid>

                                                <Border Grid.Row="1" Margin="5,0,5,7" Padding="10,8"
                                                        Background="{DynamicResource NotedSubtleSurfaceBrush}"
                                                        BorderBrush="{DynamicResource NotedBorderBrush}"
                                                        BorderThickness="1" CornerRadius="6"
                                                        Visibility="{Binding Visibility, ElementName=DefinitionBox}">
                                                    <StackPanel>
                                                        <TextBlock Text="DEFINITION" Margin="1,0,0,5"
                                                                   Foreground="{DynamicResource NotedSecondaryTextBrush}" FontSize="10"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBox x:Name="DefinitionBox"
                                                                 Text="{Binding Definition, UpdateSourceTrigger=PropertyChanged}"
                                                                 MinHeight="48" MaxHeight="130"
                                                                 Padding="7,5"
                                                                 Background="{DynamicResource NotedInputBackgroundBrush}"
                                                                 BorderBrush="{DynamicResource NotedBorderBrush}" BorderThickness="1"
                                                                 Foreground="{DynamicResource NotedTextBrush}"
                                                                 CaretBrush="{DynamicResource NotedAccentBrush}"
                                                                 SelectionBrush="{DynamicResource NotedAccentSoftHoverBrush}"
                                                                 FontSize="12" TextWrapping="Wrap"
                                                                 AcceptsReturn="True"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 Visibility="Collapsed"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilteredItems.IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Aa" Foreground="{DynamicResource NotedBorderBrush}" FontSize="22"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding EmptyMessage}" Margin="0,5,0,0"
                                       Foreground="{DynamicResource NotedMutedTextBrush}" FontSize="12"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="1,8,1,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Items.Count, StringFormat={}{0} entries}"
                               Foreground="{DynamicResource NotedSecondaryTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Ghost" Margin="0,0,8,0"
                                  IsChecked="{Binding GhostModeEnabled, Mode=TwoWay}"
                                  Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                  Style="{StaticResource NotedCheckBox}"
                                  FontSize="11" VerticalAlignment="Center"/>
                        <Button Content="+ Add" Style="{StaticResource PrimaryBtn}"
                                Click="AddButton_Click" ToolTip="Add entry"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</noted:OverlayWindow>
