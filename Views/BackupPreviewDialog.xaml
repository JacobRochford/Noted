<Window x:Class="Noted.BackupPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Backup"
        Width="820"
        Height="560"
        MinWidth="680"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#5F7480"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background" Value="#DCEEF6"/>
                                <Setter Property="Foreground" Value="#2C6E91"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background" Value="#C9E4F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="13,4"/>
            <Setter Property="Background" Value="#EEF5F8"/>
            <Setter Property="Foreground" Value="#355A6E"/>
            <Setter Property="BorderBrush" Value="#B7D4E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background" Value="#DCEEF6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background" Value="#C9E5F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryDialogButton" TargetType="Button"
               BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#5BA8C8"/>
            <Setter Property="BorderBrush" Value="#5BA8C8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background" Value="#4A97B7"/>
                                <Setter TargetName="ButtonBackground"
                                        Property="BorderBrush" Value="#4A97B7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background" Value="#3E839F"/>
                                <Setter TargetName="ButtonBackground"
                                        Property="BorderBrush" Value="#3E839F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background" Value="#AFC7D2"/>
                                <Setter TargetName="ButtonBackground"
                                        Property="BorderBrush" Value="#AFC7D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackupFileItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBackground"
                                Padding="9,7"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background" Value="#E5F2F8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background" Value="#CFE8F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="BackupFileTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayPath}"
                           Foreground="#284B5E"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="6,2"
                        Background="{Binding StatusBackground}"
                        CornerRadius="8">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{Binding StatusForeground}"
                               FontSize="9"
                               FontWeight="SemiBold"/>
                </Border>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                           Margin="0,2,0,0"
                           Text="{Binding Category}"
                           Foreground="#5F7480"
                           FontSize="10"/>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                           Margin="0,1,0,0"
                           Text="{Binding Details}"
                           Foreground="#78909C"
                           FontSize="10"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border Margin="10"
                Background="#F5F9FC"
                BorderBrush="#87CEEB"
                BorderThickness="1"
                CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4"
                                  Opacity="0.22" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="14,10,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="2,0,0,8"
                        Background="Transparent" Cursor="SizeAll"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock Text="&#xE753;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#5BA8C8"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,0"/>
                            <TextBlock Text="Backup contents"
                                       Foreground="#2C6E91"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="&#xE711;"
                                Style="{StaticResource HeaderIconButton}"
                                Click="CloseButton_Click" ToolTip="Close"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="#D0E4EE" BorderThickness="0,1,0,0"/>
                    <StackPanel Margin="0,9,0,0">
                        <TextBlock x:Name="BackupDateText"
                                   Foreground="#355A6E"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="BackupSummaryText"
                                   Margin="0,2,0,0"
                                   Foreground="#6B8795"
                                   FontSize="11"/>
                    </StackPanel>
                    <Border x:Name="VerificationBadge"
                            Grid.Column="1" Margin="12,9,0,0"
                            Padding="8,3" Background="#DDF2E7"
                            CornerRadius="9" VerticalAlignment="Center">
                        <TextBlock x:Name="VerificationText" Text="Verified"
                                   Foreground="#347052"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#EDF5F9"
                            BorderBrush="#C9DFEC"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="6">
                        <ListBox x:Name="BackupFileList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemTemplate="{StaticResource BackupFileTemplate}"
                                 ItemContainerStyle="{StaticResource BackupFileItem}"
                                 SelectionChanged="BackupFileList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Border>

                    <Border Grid.Column="2"
                            Background="White"
                            BorderBrush="#C9DFEC"
                            BorderThickness="1"
                            CornerRadius="7"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Padding="11,8"
                                    Background="#EDF5F9"
                                    BorderBrush="#D8E8F1"
                                    BorderThickness="0,0,0,1">
                                <TextBlock x:Name="SelectedFileText"
                                           Text="Select a file"
                                           Foreground="#355A6E"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <RichTextBox x:Name="ContentPreview"
                                         Grid.Row="1"
                                         IsReadOnly="True"
                                         IsDocumentEnabled="False"
                                         BorderThickness="0"
                                         Background="White"
                                         Foreground="#2D3E48"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Padding="10"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="0,13,0,0">
                    <TextBlock Text="Preview is read-only. Restore verifies every file again."
                               Foreground="#6B8795"
                               FontSize="10"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close" IsCancel="True"
                                Click="CloseButton_Click"
                                Style="{StaticResource DialogButton}"
                                Margin="0,0,8,0"/>
                        <Button x:Name="RestoreBackupButton"
                                Content="Restore Full Backup"
                                Click="RestoreButton_Click"
                                Style="{StaticResource PrimaryDialogButton}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
