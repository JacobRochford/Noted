<Window x:Class="Noted.BackupPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Backup"
        Width="820"
        Height="560"
        MinWidth="680"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="HeaderIconButton"
               TargetType="Button"
               BasedOn="{StaticResource NotedHeaderIconButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="DialogButton"
               TargetType="Button"
               BasedOn="{StaticResource NotedSecondaryButton}">
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="13,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PrimaryDialogButton" TargetType="Button"
               BasedOn="{StaticResource NotedPrimaryButton}">
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="13,4"/>
        </Style>

        <Style x:Key="BackupFileItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBackground"
                                Padding="9,7"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background" Value="{DynamicResource NotedAccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background" Value="{DynamicResource NotedAccentSoftHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="BackupFileTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayPath}"
                           Foreground="{DynamicResource NotedTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="6,2"
                        Background="{Binding StatusBackground}"
                        CornerRadius="8">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{Binding StatusForeground}"
                               FontSize="9"
                               FontWeight="SemiBold"/>
                </Border>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                           Margin="0,2,0,0"
                           Text="{Binding Category}"
                           Foreground="{DynamicResource NotedSecondaryTextBrush}"
                           FontSize="10"/>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                           Margin="0,1,0,0"
                           Text="{Binding Details}"
                           Foreground="{DynamicResource NotedMutedTextBrush}"
                           FontSize="10"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border Margin="10"
                Background="{DynamicResource NotedWindowBackgroundBrush}"
                BorderBrush="{DynamicResource NotedStrongBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4"
                                  Opacity="0.22" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="14,10,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="2,0,0,8"
                        Background="Transparent" Cursor="SizeAll"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock Text="&#xE753;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource NotedAccentBrush}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,0"/>
                            <TextBlock x:Name="DialogTitleText"
                                       Text="Backup contents"
                                       Foreground="{DynamicResource NotedAccentBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="&#xE711;"
                                Style="{StaticResource HeaderIconButton}"
                                Click="CloseButton_Click" ToolTip="Close"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="{DynamicResource NotedBorderBrush}" BorderThickness="0,1,0,0"/>
                    <StackPanel Margin="0,9,0,0">
                        <TextBlock x:Name="BackupDateText"
                                   Foreground="{DynamicResource NotedTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="BackupSummaryText"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                    <Border x:Name="VerificationBadge"
                            Grid.Column="1" Margin="12,9,0,0"
                            Padding="8,3" Background="{DynamicResource NotedSubtleSurfaceBrush}"
                            CornerRadius="9" VerticalAlignment="Center">
                        <TextBlock x:Name="VerificationText" Text="Verified"
                                   Foreground="{DynamicResource NotedSuccessBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource NotedSubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource NotedBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="6">
                        <ListBox x:Name="BackupFileList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemTemplate="{StaticResource BackupFileTemplate}"
                                 ItemContainerStyle="{StaticResource BackupFileItem}"
                                 SelectionChanged="BackupFileList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource NotedSurfaceBrush}"
                            BorderBrush="{DynamicResource NotedBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Padding="11,8"
                                    Background="{DynamicResource NotedSubtleSurfaceBrush}"
                                    BorderBrush="{DynamicResource NotedBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <TextBlock x:Name="SelectedFileText"
                                           Text="Select a file"
                                           Foreground="{DynamicResource NotedTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <RichTextBox x:Name="ContentPreview"
                                         Grid.Row="1"
                                         IsReadOnly="True"
                                         IsDocumentEnabled="False"
                                         BorderThickness="0"
                                         Background="{DynamicResource NotedInputBackgroundBrush}"
                                         Foreground="{DynamicResource NotedTextBrush}"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Padding="10"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="0,13,0,0">
                    <TextBlock x:Name="FooterText"
                               Text="Preview is read-only. Restore verifies every file again."
                               Foreground="{DynamicResource NotedSecondaryTextBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close" IsCancel="True"
                                Click="CloseButton_Click"
                                Style="{StaticResource DialogButton}"
                                Margin="0,0,8,0"/>
                        <Button x:Name="RestoreBackupButton"
                                Content="Restore Full Backup"
                                Click="RestoreButton_Click"
                                Style="{StaticResource PrimaryDialogButton}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
