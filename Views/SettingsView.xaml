<UserControl x:Class="Noted.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:Noted.Services">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
                        <DockPanel Margin="0,4,0,0">
                            <DockPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource NotedSecondaryButton}"/>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource NotedCheckBox}"/>
                                <Style TargetType="RadioButton" BasedOn="{StaticResource NotedRadioButton}"/>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource NotedComboBox}"/>
                                <Style TargetType="Slider" BasedOn="{StaticResource NotedSlider}"/>
                            </DockPanel.Resources>
                            <ScrollViewer DockPanel.Dock="Bottom"
                                          VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                            <Border Background="Transparent"
                                    BorderBrush="{DynamicResource NotedBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="0"
                                    Padding="12,0,12,16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <Style x:Key="AccentSwatchButton" TargetType="Button">
                                            <Setter Property="Width" Value="27"/>
                                            <Setter Property="Height" Value="27"/>
                                            <Setter Property="Margin" Value="0,0,7,7"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Swatch"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{DynamicResource NotedStrongBorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="14"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Swatch" Property="BorderThickness" Value="3"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="Swatch" Property="Opacity" Value="0.75"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </StackPanel.Resources>

                                    <TextBlock Text="Appearance"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource NotedTextBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Choose how Noted looks. Changes are previewed immediately."
                                               FontSize="11"
                                               Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Theme"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                                   FontSize="11"/>
                                        <ComboBox x:Name="AppearanceModeCombo" SelectedValue="{Binding ThemeMode}" ItemsSource="{Binding AppearanceOptions}"
                                                  Grid.Column="1"
                                                  MinHeight="28"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Mode"/>
                                    </Grid>

                                    <TextBlock Text="Accent color"
                                               Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                               FontSize="11"
                                               Margin="0,0,0,6"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource AccentSwatchButton}"
                                                Background="#5BA8C8" Tag="#5BA8C8"
                                                ToolTip="Noted blue"
                                                Click="AccentPresetButton_Click"/>
                                        <Button Style="{StaticResource AccentSwatchButton}"
                                                Background="#2C6E91" Tag="#2C6E91"
                                                ToolTip="Deep blue"
                                                Click="AccentPresetButton_Click"/>
                                        <Button Style="{StaticResource AccentSwatchButton}"
                                                Background="#008080" Tag="#008080"
                                                ToolTip="Teal"
                                                Click="AccentPresetButton_Click"/>
                                        <Button Style="{StaticResource AccentSwatchButton}"
                                                Background="#3E8E68" Tag="#3E8E68"
                                                ToolTip="Green"
                                                Click="AccentPresetButton_Click"/>
                                        <Button Style="{StaticResource AccentSwatchButton}"
                                                Background="#7A5CB8" Tag="#7A5CB8"
                                                ToolTip="Purple"
                                                Click="AccentPresetButton_Click"/>
                                        <Button Style="{StaticResource AccentSwatchButton}"
                                                Background="#D9822B" Tag="#D9822B"
                                                ToolTip="Orange"
                                                Click="AccentPresetButton_Click"/>
                                        <Button Style="{StaticResource AccentSwatchButton}"
                                                Background="#C65D8B" Tag="#C65D8B"
                                                ToolTip="Pink"
                                                Click="AccentPresetButton_Click"/>
                                        <Button Style="{StaticResource AccentSwatchButton}"
                                                Background="#526D82" Tag="#526D82"
                                                ToolTip="Slate"
                                                Click="AccentPresetButton_Click"/>
                                        <Button Style="{StaticResource AccentSwatchButton}"
                                                Background="#1A9CB0" Tag="#1A9CB0"
                                                ToolTip="Cyan"
                                                Click="AccentPresetButton_Click"/>
                                        <Button Style="{StaticResource AccentSwatchButton}"
                                                Background="#2F9E73" Tag="#2F9E73"
                                                ToolTip="Emerald"
                                                Click="AccentPresetButton_Click"/>
                                        <Button Style="{StaticResource AccentSwatchButton}"
                                                Background="#7B8D42" Tag="#7B8D42"
                                                ToolTip="Olive"
                                                Click="AccentPresetButton_Click"/>
                                        <Button Style="{StaticResource AccentSwatchButton}"
                                                Background="#C99A24" Tag="#C99A24"
                                                ToolTip="Gold"
                                                Click="AccentPresetButton_Click"/>
                                        <Button Style="{StaticResource AccentSwatchButton}"
                                                Background="#C95151" Tag="#C95151"
                                                ToolTip="Red"
                                                Click="AccentPresetButton_Click"/>
                                        <Button Style="{StaticResource AccentSwatchButton}"
                                                Background="#D66B5D" Tag="#D66B5D"
                                                ToolTip="Coral"
                                                Click="AccentPresetButton_Click"/>
                                        <Button Style="{StaticResource AccentSwatchButton}"
                                                Background="#B85C9E" Tag="#B85C9E"
                                                ToolTip="Magenta"
                                                Click="AccentPresetButton_Click"/>
                                        <Button Content="More colors..."
                                                Height="27"
                                                Margin="0,0,0,7"
                                                Padding="8,2"
                                                Style="{StaticResource NotedSecondaryButton}"
                                                ToolTip="Choose any accent color"
                                                Click="ChooseAccentColorButton_Click"/>
                                    </WrapPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="AccentHexTextBox" Text="{Binding AccentText, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="28"
                                                 MaxLength="7"
                                                 Padding="7,4"
                                                 Background="{DynamicResource NotedInputBackgroundBrush}"
                                                 BorderBrush="{DynamicResource NotedBorderBrush}"
                                                 Foreground="{DynamicResource NotedTextBrush}"
                                                 CaretBrush="{DynamicResource NotedTextBrush}"
                                                 LostKeyboardFocus="AccentHexTextBox_LostKeyboardFocus"/>
                                        <Button Grid.Column="1"
                                                Content="Reset"
                                                Margin="8,0,0,0"
                                                Padding="8,3"
                                                MinHeight="28"
                                                Style="{StaticResource NotedSecondaryButton}"
                                                Command="{Binding ResetAppearanceCommand}"/>
                                    </Grid>
                                    <TextBlock x:Name="AccentValidationText" Text="{Binding AccentMessage}"
                                               FontSize="10"
                                               Margin="1,4,0,8"/>

                                    <Border Background="{DynamicResource NotedSurfaceBrush}"
                                            BorderBrush="{DynamicResource NotedBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Theme preview"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource NotedTextBrush}"/>
                                                <TextBlock Text="Surfaces, text, and accent"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource NotedSecondaryTextBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource NotedAccentBrush}"
                                                    CornerRadius="5"
                                                    Padding="9,5">
                                                <TextBlock Text="Accent"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource NotedAccentTextBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Background="Transparent"
                                    BorderBrush="{DynamicResource NotedBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="0"
                                    Padding="12,0,12,16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Note Behavior"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource NotedTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <RadioButton x:Name="NewNotePromptOption" IsChecked="{Binding NewNoteModePrompt}"
                                                 GroupName="NewNoteBehavior"
                                                 Margin="0,0,0,6"
                                                 HorizontalAlignment="Stretch">
                                        <TextBlock Text="Always ask for note name"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </RadioButton>
                                    <RadioButton x:Name="NewNoteQuickOption" IsChecked="{Binding NewNoteModeQuick}"
                                                 GroupName="NewNoteBehavior"
                                                 Margin="0,0,0,6"
                                                 HorizontalAlignment="Stretch">
                                        <TextBlock Text="Always create quick note"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </RadioButton>
                                    <RadioButton x:Name="NewNoteBothOption" IsChecked="{Binding NewNoteModeBoth}"
                                                 GroupName="NewNoteBehavior"
                                                 Margin="0,0,0,0"
                                                 HorizontalAlignment="Stretch">
                                        <TextBlock Text="Show both buttons (let me choose)"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </RadioButton>
                                    <CheckBox x:Name="ShowModifiedSubtitleOption" IsChecked="{Binding ShowModifiedSubtitle}"
                                            Foreground="{DynamicResource NotedTextBrush}"
                                            FontWeight="SemiBold"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock Text="Show 'Modified' timestamp in note subtitle"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    </CheckBox>
                                    <CheckBox x:Name="ConfirmNoteDeletionOption" IsChecked="{Binding ConfirmNoteDeletion}"
                                              Foreground="{DynamicResource NotedTextBrush}"
                                              FontWeight="SemiBold"
                                              Margin="0,10,0,0"
                                              HorizontalAlignment="Stretch">
                                        <TextBlock Text="Confirm before deleting notes"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <Border Background="Transparent"
                                    BorderBrush="{DynamicResource NotedBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="0"
                                    Padding="12,0,12,16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Folder Navigation"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource NotedTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="How clicking a folder opens it"
                                               FontSize="11"
                                               Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <RadioButton x:Name="FolderNavDrillDownOption" IsChecked="{Binding FolderNavigationModeDrillDown}"
                                                 GroupName="FolderNavigation"
                                                 Margin="0,0,0,6"
                                                 HorizontalAlignment="Stretch">
                                        <TextBlock Text="Navigate into folder (drill-down)"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </RadioButton>
                                    <RadioButton x:Name="FolderNavExpandOption" IsChecked="{Binding FolderNavigationModeExpand}"
                                                 GroupName="FolderNavigation"
                                                 HorizontalAlignment="Stretch">
                                        <TextBlock Text="Expand folder inline (tree view)"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <Border Background="Transparent"
                                    BorderBrush="{DynamicResource NotedBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="0"
                                    Padding="12,0,12,16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Startup"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource NotedTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <CheckBox x:Name="RunOnStartupOption" IsChecked="{Binding RunOnStartup}"
                                            Foreground="{DynamicResource NotedTextBrush}"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock Text="Launch Noted automatically when Windows starts"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <Border Background="Transparent"
                                    BorderBrush="{DynamicResource NotedBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="0"
                                    Padding="12,0,12,16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Window Behavior"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource NotedTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Choose whether Hide also hides all other windows"
                                               FontSize="11"
                                               Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Open Noted on"
                                               FontSize="11"
                                               Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="PreferredDisplayCombo" SelectedItem="{Binding PreferredDisplay}" ItemsSource="{Binding DisplayOptions}"
                                              Margin="0,0,0,12"
                                              MinHeight="28"
                                              DisplayMemberPath="Label"/>
                                    <CheckBox x:Name="MainHideButtonHidesAllOption" IsChecked="{Binding MainHideButtonHidesAll}"
                                            Foreground="{DynamicResource NotedTextBrush}"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock Text="Hide other windows when hiding notes"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <Border Background="Transparent"
                                    BorderBrush="{DynamicResource NotedBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="0"
                                    Padding="12,0,12,16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="App Opacity"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource NotedTextBrush}"
                                               Margin="0,0,0,8"/>

                                    <!-- Visible opacity (always active) -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Visible opacity"
                                                   Grid.Column="0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DefaultOpacityLabel" Text="{Binding DefaultOpacityLabel}"
                                                   Grid.Column="1"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource NotedAccentBrush}"
                                                   VerticalAlignment="Center"
                                                   MinWidth="32"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="DefaultOpacitySlider" Value="{Binding DefaultOpacityPercent}"
                                            Minimum="5"
                                            Maximum="100"
                                            SmallChange="1"
                                            LargeChange="1"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="False"
                                            Margin="0,0,0,14"/>

                                    <!-- Idle fade toggle -->
                                    <CheckBox x:Name="GhostModeOption" IsChecked="{Binding GhostModeEnabled}"
                                            Foreground="{DynamicResource NotedTextBrush}"
                                            FontWeight="SemiBold"
                                            Margin="0,0,0,10"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock Text="Fade windows when inactive"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </CheckBox>

                                    <CheckBox Style="{StaticResource NotedToggleSwitch}" Content="Always keep this window visible" ToolTip="Use the app visible opacity even when this window is inactive" Margin="0,0,0,10"
                                              IsChecked="{Binding Path=(s:WindowAppearance.AlwaysVisible), RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>

                                    <!-- Idle opacity (disabled when idle fade is off) -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Idle opacity"
                                                   Grid.Column="0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="GhostModeOpacityLabel" Text="{Binding GhostOpacityLabel}"
                                                   Grid.Column="1"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource NotedAccentBrush}"
                                                   VerticalAlignment="Center"
                                                   MinWidth="32"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="GhostModeOpacitySlider" Value="{Binding GhostOpacityPercent}"
                                            Minimum="0"
                                            Maximum="100"
                                            SmallChange="1"
                                            LargeChange="1"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="False"
                                            IsEnabled="{Binding ElementName=GhostModeOption, Path=IsChecked}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="Transparent"
                                    BorderBrush="{DynamicResource NotedBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="0"
                                    Padding="12,0,12,16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="New Note Timestamp"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                              Foreground="{DynamicResource NotedTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <RadioButton x:Name="TimestampNoneOption" IsChecked="{Binding TimestampPlacementNone}"
                                                 GroupName="TimestampPlacement"
                                                 Margin="0,0,0,6"
                                                 HorizontalAlignment="Stretch">
                                        <TextBlock Text="No timestamp"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </RadioButton>
                                    <RadioButton x:Name="TimestampTopOption" IsChecked="{Binding TimestampPlacementTop}"
                                                 GroupName="TimestampPlacement"
                                                 Margin="0,0,0,6"
                                                 HorizontalAlignment="Stretch">
                                        <TextBlock Text="Add timestamp to top of page"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </RadioButton>
                                    <RadioButton x:Name="TimestampBottomOption" IsChecked="{Binding TimestampPlacementBottom}"
                                                 GroupName="TimestampPlacement"
                                                 Margin="0,0,0,6"
                                                 HorizontalAlignment="Stretch">
                                        <TextBlock Text="Add timestamp to bottom of page"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </RadioButton>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TimestampLineOption" IsChecked="{Binding TimestampPlacementLine}"
                                                     GroupName="TimestampPlacement"
                                                     VerticalAlignment="Center">
                                            <TextBlock Text="Add timestamp on line"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </RadioButton>
                                        <TextBox x:Name="TimestampLineTextBox" Text="{Binding TimestampLineText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="54"
                                                 Height="25"
                                                 Margin="8,0,0,0"
                                                 Padding="6,2"
                                                 MaxLength="5"
                                                 IsEnabled="{Binding ElementName=TimestampLineOption, Path=IsChecked}"
                                                 VerticalContentAlignment="Center"
                                                 Style="{StaticResource NotedTextInput}"
                                                 LostFocus="TimestampLineTextBox_LostFocus"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="Transparent"
                                    BorderBrush="{DynamicResource NotedBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="0"
                                    Padding="12,0,12,16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Notes Folder"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource NotedTextBrush}"
                                                   Margin="0,0,8,0"/>
                                        <Button x:Name="ToggleNotesFolderPathButton" Content="{Binding ToggleNotesDirectoryText}"
                                                Command="{Binding ToggleNotesDirectoryCommand}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource NotedTextBrush}"
                                                Cursor="Hand"
                                                Padding="6,2"
                                                Margin="0,0,0,0"
                                                Style="{StaticResource NotedSecondaryButton}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="NotesFolderPathText" Text="{Binding NotesDirectory}"
                                               FontSize="11"
                                               Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,10"
                                               Visibility="{Binding ShowNotesDirectory, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button x:Name="ChangeFolderButton"
                                            Content="Change Folder"
                                            Command="{Binding ChangeFolderCommand}"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource NotedTextBrush}"
                                            Cursor="Hand"
                                            Padding="8,3"
                                            HorizontalAlignment="Left"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource NotedStrongBorderBrush}"
                                            BorderThickness="1">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg"
                                                        Background="{DynamicResource NotedSubtleSurfaceBrush}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource NotedAccentSoftBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Background="Transparent"
                                    BorderBrush="{DynamicResource NotedBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="0"
                                    Padding="12,0,12,16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Data Protection"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource NotedTextBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Create a verified backup of your notes, settings, checklist, dictionary, Scratchpad, MiniPad, and open-note recovery. View it before restoring, export a copy, or import one from another Noted installation. Noted changes this backup only when you choose Update Backup."
                                               FontSize="11"
                                               Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button x:Name="CreateOrUpdateBackupButton" Content="{Binding CreateBackupText}"
                                                Command="{Binding CreateBackupCommand}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource NotedTextBrush}"
                                                Cursor="Hand"
                                                Padding="8,3"
                                                Margin="0,0,8,6"
                                                Style="{StaticResource NotedSecondaryButton}"/>
                                        <Button x:Name="ViewBackupButton"
                                                Content="View Backup"
                                                Command="{Binding ViewBackupCommand}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource NotedTextBrush}"
                                                Cursor="Hand"
                                                Padding="8,3"
                                                Margin="0,0,8,6"
                                                Style="{StaticResource NotedSecondaryButton}"/>
                                        <Button x:Name="ExportBackupButton"
                                                Content="Export"
                                                Command="{Binding ExportBackupCommand}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource NotedTextBrush}"
                                                Cursor="Hand"
                                                Padding="8,3"
                                                Margin="0,0,8,6"
                                                Style="{StaticResource NotedSecondaryButton}"/>
                                        <Button x:Name="ImportBackupButton"
                                                Content="Import"
                                                Command="{Binding ImportBackupCommand}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource NotedTextBrush}"
                                                Cursor="Hand"
                                                Padding="8,3"
                                                Margin="0,0,8,6"
                                                Style="{StaticResource NotedSecondaryButton}"/>
                                        <Button x:Name="RestoreBackupButton"
                                                Content="Restore Backup"
                                                Command="{Binding RestoreBackupCommand}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource NotedTextBrush}"
                                                Cursor="Hand"
                                                Padding="8,3"
                                                Margin="0,0,0,6"
                                                Style="{StaticResource NotedSecondaryButton}"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="BackupStatusText" Text="{Binding BackupStatus}"
                                               FontSize="10"
                                               Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="0"
                                    Padding="12,0,12,4"
                                    Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Hotkeys"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource NotedTextBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Show or hide a window with a keyboard shortcut"
                                               FontSize="11"
                                               Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <Grid Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Notes"
                                                   Foreground="{DynamicResource NotedTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CurrentNotesHotkeyDisplay" ToolTip="{Binding NotesHotkeyTooltip}" Text="{Binding NotesHotkey}"
                                                   Grid.Column="1"
                                                   Foreground="{DynamicResource NotedAccentBrush}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="4,0,4,0"/>
                                        <Button Grid.Column="2"
                                                Tag="Notes"
                                                Click="EditHotkeyButton_Click"
                                                Style="{DynamicResource HeaderChromeButtonStyle}"
                                                ToolTip="Change Notes hotkey"
                                                AutomationProperties.Name="Change Notes hotkey">
                                            <TextBlock Text="✎" FontSize="13"/>
                                        </Button>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource NotedBorderBrush}"/>
                                    <Grid Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Checklist"
                                                   Foreground="{DynamicResource NotedTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CurrentChecklistHotkeyDisplay" ToolTip="{Binding ChecklistHotkeyTooltip}" Text="{Binding ChecklistHotkey}"
                                                   Grid.Column="1"
                                                   Foreground="{DynamicResource NotedAccentBrush}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="4,0,4,0"/>
                                        <Button Grid.Column="2"
                                                Tag="Checklist"
                                                Click="EditHotkeyButton_Click"
                                                Style="{DynamicResource HeaderChromeButtonStyle}"
                                                ToolTip="Change Checklist hotkey"
                                                AutomationProperties.Name="Change Checklist hotkey">
                                            <TextBlock Text="✎" FontSize="13"/>
                                        </Button>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource NotedBorderBrush}"/>
                                    <Grid Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dictionary"
                                                   Foreground="{DynamicResource NotedTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CurrentDictionaryHotkeyDisplay" ToolTip="{Binding DictionaryHotkeyTooltip}" Text="{Binding DictionaryHotkey}"
                                                   Grid.Column="1"
                                                   Foreground="{DynamicResource NotedAccentBrush}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="4,0,4,0"/>
                                        <Button Grid.Column="2"
                                                Tag="Dictionary"
                                                Click="EditHotkeyButton_Click"
                                                Style="{DynamicResource HeaderChromeButtonStyle}"
                                                ToolTip="Change Dictionary hotkey"
                                                AutomationProperties.Name="Change Dictionary hotkey">
                                            <TextBlock Text="✎" FontSize="13"/>
                                        </Button>
                                    </Grid>

                                    <Popup x:Name="HotkeyEditorPopup" IsOpen="{Binding IsHotkeyEditorOpen, Mode=TwoWay}"
                                           Placement="Bottom"
                                           HorizontalOffset="-220"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade"
                                           StaysOpen="False"
                                          >
                                        <Border Width="250"
                                                Padding="12"
                                                Background="{DynamicResource NotedWindowBackgroundBrush}"
                                                BorderBrush="{DynamicResource NotedStrongBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12"
                                                                  ShadowDepth="3"
                                                                  Opacity="0.2"
                                                                  Color="#000000"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock x:Name="HotkeyEditorTitle" Text="{Binding HotkeyEditorTitle}"
                                                           Margin="0,0,0,9"
                                                           Foreground="{DynamicResource NotedAccentBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                                <WrapPanel Margin="0,0,0,9">
                                                    <CheckBox x:Name="HotkeyModifierCtrl" IsChecked="{Binding HotkeyCtrl}" Content="Ctrl" Margin="0,0,12,5"
                                                              Style="{StaticResource NotedCheckBox}"/>
                                                    <CheckBox x:Name="HotkeyModifierAlt" IsChecked="{Binding HotkeyAlt}" Content="Alt" Margin="0,0,12,5"
                                                              Style="{StaticResource NotedCheckBox}"/>
                                                    <CheckBox x:Name="HotkeyModifierShift" IsChecked="{Binding HotkeyShift}" Content="Shift" Margin="0,0,12,5"
                                                              Style="{StaticResource NotedCheckBox}"/>
                                                    <CheckBox x:Name="HotkeyModifierWin" IsChecked="{Binding HotkeyWin}" Content="Win" Margin="0,0,0,5"
                                                              Style="{StaticResource NotedCheckBox}"/>
                                                </WrapPanel>
                                                <ComboBox x:Name="HotkeyKeyCombo" SelectedItem="{Binding HotkeyKey}" ItemsSource="{Binding HotkeyKeys}"
                                                          Style="{StaticResource NotedComboBox}"
                                                          Padding="8,5"
                                                          FontSize="11"
                                                          Margin="0,0,0,8"/>
                                                <Border BorderBrush="{DynamicResource NotedBorderBrush}"
                                                        BorderThickness="1"
                                                        Background="{DynamicResource NotedInputBackgroundBrush}"
                                                        Padding="8,5"
                                                        Margin="0,0,0,10">
                                                    <TextBlock x:Name="HotkeyPreview" Text="{Binding HotkeyPreview}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource NotedTextBrush}"/>
                                                </Border>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="Reset"
                                                            Command="{Binding ResetHotkeyCommand}"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                                            Cursor="Hand"
                                                            Padding="4,3"
                                                            HorizontalAlignment="Left"
                                                            Style="{StaticResource NotedSecondaryButton}"/>
                                                    <Button Grid.Column="1"
                                                            Content="Cancel"
                                                            Command="{Binding CancelHotkeyCommand}"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource NotedSecondaryTextBrush}"
                                                            Cursor="Hand"
                                                            Padding="7,3"
                                                            Margin="0,0,5,0"
                                                            Style="{StaticResource NotedSecondaryButton}"/>
                                                    <Button Grid.Column="2"
                                                            Content="Apply"
                                                            Command="{Binding ApplyHotkeyCommand}"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource NotedAccentTextBrush}"
                                                            Cursor="Hand"
                                                            Padding="9,4"
                                                            Style="{StaticResource NotedPrimaryButton}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Border>

                            </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
</UserControl>
