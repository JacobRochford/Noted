<Window x:Class="Noted.GoToLineDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go to Line" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource NotedWindowBackgroundBrush}"
        Foreground="{DynamicResource NotedTextBrush}" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Margin="0,0,0,10"/>
        <TextBox x:Name="LineNumberTextBox" Style="{StaticResource NotedTextInput}"
                 AutomationProperties.Name="Line number"/>
        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource NotedDangerBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"
                    Style="{StaticResource NotedSecondaryButton}"/>
            <Button Content="Go" IsDefault="True" Click="GoButton_Click"
                    Style="{StaticResource NotedPrimaryButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
