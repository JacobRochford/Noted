<noted:ChecklistEditorWindow x:Class="Noted.ChecklistNotificationOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:noted="clr-namespace:Noted"
        Title="Notification options" Width="480" MinWidth="400" MinHeight="280" SizeToContent="Height"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{DynamicResource NotedSurfaceBrush}" Foreground="{DynamicResource NotedTextBrush}">
    <Window.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource NotedComboBox}"/>
        <Style TargetType="Button" BasedOn="{StaticResource NotedSecondaryButton}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource NotedCheckBox}"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource NotedScrollBar}"/>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource NotedDangerBrush}"
                       AutomationProperties.LiveSetting="Assertive" Margin="0,8,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Padding="12,7" Margin="0,0,8,0"/>
                <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource NotedPrimaryButton}" Padding="12,7" Click="Apply_Click"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer x:Name="OptionsFields" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="FixedStyle" FontWeight="SemiBold" Margin="0,0,0,8" Visibility="Collapsed"/>
                <StackPanel x:Name="StylePicker" Margin="0,0,0,8">
                    <TextBlock Text="Notification style" Margin="0,0,0,4"/>
                    <ComboBox x:Name="PreviewStyle" AutomationProperties.Name="Notification style" SelectionChanged="Style_Changed"/>
                </StackPanel>
                <StackPanel x:Name="WindowsSoundOptions">
                    <TextBlock Text="Sound" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SoundChoice" AutomationProperties.Name="Notification sound"/>
                    <TextBlock Text="Windows controls sound playback and notification visibility."
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel x:Name="UrgentOptions">
                    <TextBlock Text="Window" Margin="0,0,0,4"/>
                    <ComboBox x:Name="AlertSize" AutomationProperties.Name="Urgent window size"/>
                    <CheckBox x:Name="AllMonitors" Content="Show on all monitors" Margin="0,8,0,0"
                              AutomationProperties.HelpText="By default, alerts appear on the primary monitor."/>
                    <TextBlock Text="Acknowledgment" Margin="0,8,0,4"/>
                    <ComboBox x:Name="Acknowledgment" AutomationProperties.Name="Acknowledgment method"/>
                    <CheckBox x:Name="PlayAlarmSound" Content="Play alarm sound" Margin="0,8,0,0"/>
                </StackPanel>
                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="PlaySound" Content="Play sound" Click="PlaySound_Click" Padding="12,7" Margin="0,0,8,4"
                            IsEnabled="{Binding IsChecked, ElementName=PlayAlarmSound}"/>
                    <Button Content="Preview" Click="Preview_Click" Padding="12,7" Margin="0,0,8,4"/>
                    <Button Content="Stop preview" Click="StopPreview_Click" Padding="12,7" Margin="0,0,0,4"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</noted:ChecklistEditorWindow>
