<Window x:Class="Noted.ChecklistNotificationOptionsDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Notification options" Width="560" Height="760" MinHeight="400" MinWidth="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI"
 Background="{DynamicResource NotedSurfaceBrush}" Foreground="{DynamicResource NotedTextBrush}">
 <Window.Resources><Style TargetType="ComboBox" BasedOn="{StaticResource NotedComboBox}"/>
 <Style TargetType="Button" BasedOn="{StaticResource NotedSecondaryButton}"/>
 <Style TargetType="CheckBox" BasedOn="{StaticResource NotedCheckBox}"/>
 <Style TargetType="TextBox" BasedOn="{StaticResource NotedTextInput}">
  <Setter Property="MinHeight" Value="32"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
 <Style TargetType="ScrollBar" BasedOn="{StaticResource NotedScrollBar}"/>
 </Window.Resources>
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource NotedDangerBrush}" AutomationProperties.LiveSetting="Assertive" Margin="0,10"/>
   <WrapPanel HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Padding="12,7" Margin="0,0,8,0"/>
    <Button Content="Apply" Style="{StaticResource NotedPrimaryButton}" Padding="12,7" Click="Apply_Click"/></WrapPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0"><StackPanel>
   <TextBlock Text="Notification options" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <TextBlock Text="Windows notifications" FontSize="17" FontWeight="SemiBold"/>
   <TextBlock Text="Standard sound" Margin="0,8,0,4"/><ComboBox x:Name="StandardSound" AutomationProperties.Name="Standard notification sound"/>
   <TextBlock Text="Persistent sound" Margin="0,8,0,4"/><ComboBox x:Name="PersistentSound" AutomationProperties.Name="Persistent notification sound"/>
   <TextBlock Text="Windows controls notification visibility, sound playback and looping duration." TextWrapping="Wrap" Margin="0,8,0,16"/>
   <TextBlock Text="Urgent Noted alert" FontSize="17" FontWeight="SemiBold"/>
   <TextBlock Text="Window size" Margin="0,8,0,4"/><ComboBox x:Name="AlertSize" AutomationProperties.Name="Urgent window size"/>
   <TextBlock Text="Screen percentage (30-100)" Margin="0,8,0,4"/><TextBox x:Name="ScreenPercent" AutomationProperties.Name="Screen percentage"/>
   <TextBlock Text="Monitor" Margin="0,8,0,4"/><ComboBox x:Name="AlertMonitor" AutomationProperties.Name="Alert monitor policy"/>
   <ComboBox x:Name="SelectedMonitor" Margin="0,6,0,0" AutomationProperties.Name="Selected display"/>
   <TextBlock Text="All displays share acknowledgment state and use one sound channel." TextWrapping="Wrap" Margin="0,6,0,0"/>
   <TextBlock Text="Reminder text size (18-64)" Margin="0,8,0,4"/><TextBox x:Name="TextSize" AutomationProperties.Name="Reminder text size"/>
   <CheckBox x:Name="Pulse" Content="Slowly pulsating accent border" Margin="0,12,0,8"/>
   <TextBlock Text="Acknowledgment" Margin="0,8,0,4"/><ComboBox x:Name="Acknowledgment" AutomationProperties.Name="Acknowledgment method"/>
   <TextBlock Text="Hold duration in seconds (1-10)" Margin="0,8,0,4"/><TextBox x:Name="HoldSeconds" AutomationProperties.Name="Hold duration in seconds"/>
   <TextBlock Text="Urgent sound" Margin="0,8,0,4"/><ComboBox x:Name="UrgentSound" AutomationProperties.Name="Urgent reminder sound"/>
   <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="Choose WAV..." Click="ChooseSound_Click" Padding="8,4"/><TextBox x:Name="CustomSound" AutomationProperties.Name="Custom WAV file" Margin="0,0,8,0"/></DockPanel>
   <TextBlock Text="Custom WAV files are external references. Backups preserve the reference, not the audio file. Missing files use the built-in alarm." TextWrapping="Wrap" Margin="0,6,0,0"/>
   <CheckBox x:Name="Repeat" Content="Repeat sound until silenced or acknowledged" Margin="0,12,0,0"/>
   <TextBlock Text="Repeat interval in seconds (2-3600)" Margin="0,8,0,4"/><TextBox x:Name="RepeatSeconds" AutomationProperties.Name="Repeat interval in seconds"/>
   <TextBlock Text="Snooze is disabled. Acknowledging never completes the task." TextWrapping="Wrap" Margin="0,12,0,16"/>
   <TextBlock Text="Preview" FontSize="17" FontWeight="SemiBold"/>
   <ComboBox x:Name="PreviewStyle" Margin="0,8,0,8" AutomationProperties.Name="Preview notification style"/>
   <WrapPanel><Button Content="Preview" Padding="12,7" Click="Preview_Click" Margin="0,0,8,0"/>
    <Button Content="Stop preview" Padding="12,7" Click="StopPreview_Click"/></WrapPanel>
   <TextBlock Text="Preview uses sample data and never changes real tasks or reminder state." TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
