<Window x:Class="Noted.ChecklistNotificationOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification options" Width="480" Height="660" MinWidth="400" MinHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NotedSurfaceBrush}" Foreground="{DynamicResource NotedTextBrush}">
    <Window.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource NotedComboBox}"/>
        <Style TargetType="Button" BasedOn="{StaticResource NotedSecondaryButton}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource NotedCheckBox}"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource NotedScrollBar}"/>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource NotedDangerBrush}"
                       AutomationProperties.LiveSetting="Assertive" Margin="0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Padding="12,7" Margin="0,0,8,0"/>
                <Button Content="Apply" Style="{StaticResource NotedPrimaryButton}" Padding="12,7" Click="Apply_Click"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Notification options" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <TextBlock Text="Notification style" Margin="0,0,0,4"/>
                <ComboBox x:Name="PreviewStyle" AutomationProperties.Name="Notification style" SelectionChanged="Style_Changed"/>
                <TextBlock Text="Sound" Margin="0,12,0,4"/>
                <ComboBox x:Name="SoundChoice" AutomationProperties.Name="Notification sound"/>
                <TextBlock x:Name="WindowsHint" Text="Windows controls sound playback and notification visibility."
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                <StackPanel x:Name="UrgentOptions">
                    <CheckBox x:Name="Repeat" Content="Repeat sound until silenced or acknowledged" Margin="0,12,0,0"/>
                    <TextBlock Text="Repeat every (seconds)" Margin="0,8,0,4"/>
                    <ComboBox x:Name="RepeatInterval" AutomationProperties.Name="Sound repeat interval"
                              IsEnabled="{Binding IsChecked, ElementName=Repeat}"/>
                    <TextBlock Text="Window" Margin="0,16,0,4"/>
                    <ComboBox x:Name="AlertSize" AutomationProperties.Name="Urgent window size"/>
                    <CheckBox x:Name="AllMonitors" Content="Show on all monitors" Margin="0,12,0,4"/>
                    <TextBlock Text="Otherwise, alerts appear on the primary monitor."
                               Foreground="{DynamicResource NotedMutedTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="Acknowledgment" Margin="0,16,0,4"/>
                    <ComboBox x:Name="Acknowledgment" AutomationProperties.Name="Acknowledgment method"/>
                    <TextBlock Text="A gentle pulsing border respects reduced-motion and high-contrast settings. Silencing never acknowledges or completes the task."
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
                <WrapPanel Margin="0,20,0,0">
                    <Button Content="Play sound" Click="PlaySound_Click" Padding="12,7" Margin="0,0,8,8"/>
                    <Button Content="Preview" Click="Preview_Click" Padding="12,7" Margin="0,0,8,8"/>
                    <Button Content="Stop preview" Click="StopPreview_Click" Padding="12,7" Margin="0,0,0,8"/>
                </WrapPanel>
                <TextBlock Text="Once delivery starts, that alert keeps its original options until you reschedule it."
                           TextWrapping="Wrap" Foreground="{DynamicResource NotedMutedTextBrush}" Margin="0,4,0,8"/>
                <TextBlock Text="Previews use sample data and never change tasks or saved reminder state."
                           TextWrapping="Wrap" Foreground="{DynamicResource NotedMutedTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
