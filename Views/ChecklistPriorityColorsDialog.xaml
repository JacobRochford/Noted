<Window x:Class="Noted.ChecklistPriorityColorsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Priority Colors"
        Width="410"
        Height="332"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="Segoe UI">
    <Window.Resources>
        <DataTemplate x:Key="ColorChoiceTemplate">
            <Grid MinWidth="215">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="12" Height="12" Fill="{Binding Hex}"/>
                <TextBlock Grid.Column="1" Margin="6,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource NotedTextBrush}"
                           Text="{Binding Name}"/>
                <TextBlock Grid.Column="2" Margin="12,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource NotedSecondaryTextBrush}"
                           FontSize="11" Text="{Binding Hex}"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="ColorComboBox"
               TargetType="ComboBox"
               BasedOn="{StaticResource NotedComboBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MaxDropDownHeight" Value="220"/>
            <Setter Property="ItemTemplate" Value="{StaticResource ColorChoiceTemplate}"/>
        </Style>

        <Style x:Key="HeaderIconButton"
               TargetType="Button"
               BasedOn="{StaticResource NotedHeaderIconButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="DialogButton"
               TargetType="Button"
               BasedOn="{StaticResource NotedSecondaryButton}">
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="13,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PrimaryDialogButton" TargetType="Button"
               BasedOn="{StaticResource NotedPrimaryButton}">
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="13,4"/>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border Margin="8"
                Background="{DynamicResource NotedWindowBackgroundBrush}"
                BorderBrush="{DynamicResource NotedStrongBorderBrush}"
                BorderThickness="1"
                CornerRadius="9">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3"
                                  Opacity="0.2" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="14,10,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="2,0,0,8"
                        Background="Transparent" Cursor="SizeAll"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <Grid Width="22" Height="22" Margin="0,0,8,0">
                                <Ellipse Width="9" Height="9" Margin="0,0,7,7"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="#FF0000"/>
                                <Ellipse Width="9" Height="9" Margin="7,7,0,0"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="{DynamicResource NotedAccentBrush}"/>
                            </Grid>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource NotedAccentBrush}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Text="Priority colors"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="&#xE711;"
                                Style="{StaticResource HeaderIconButton}"
                                Click="CloseButton_Click" ToolTip="Close"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,0,0,14" Padding="0,9,0,0"
                        BorderBrush="{DynamicResource NotedBorderBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Foreground="{DynamicResource NotedSecondaryTextBrush}" FontSize="12"
                               Text="Choose a color for each checklist priority."/>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource NotedTextBrush}"
                               FontSize="12" Text="High"/>
                    <ComboBox x:Name="HighColorComboBox" Grid.Column="1"
                              Margin="0,0,0,9" Style="{StaticResource ColorComboBox}"/>

                    <TextBlock Grid.Row="1" VerticalAlignment="Center"
                               Foreground="{DynamicResource NotedTextBrush}" FontSize="12" Text="Medium"/>
                    <ComboBox x:Name="MediumColorComboBox" Grid.Row="1" Grid.Column="1"
                              Margin="0,0,0,9" Style="{StaticResource ColorComboBox}"/>

                    <TextBlock Grid.Row="2" VerticalAlignment="Center"
                               Foreground="{DynamicResource NotedTextBrush}" FontSize="12" Text="Low"/>
                    <ComboBox x:Name="LowColorComboBox" Grid.Row="2" Grid.Column="1"
                              Style="{StaticResource ColorComboBox}"/>
                </Grid>

                <Grid Grid.Row="3" Margin="0,17,0,0">
                    <Button HorizontalAlignment="Left" Content="Reset"
                            Click="ResetButton_Click" Style="{StaticResource DialogButton}"/>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Margin="0,0,8,0" Content="Cancel" IsCancel="True"
                                Click="CancelButton_Click" Style="{StaticResource DialogButton}"/>
                        <Button Content="Save" IsDefault="True"
                                Click="SaveButton_Click" Style="{StaticResource PrimaryDialogButton}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
