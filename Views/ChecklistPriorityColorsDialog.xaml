<Window x:Class="Noted.ChecklistPriorityColorsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Priority Colors"
        Width="390"
        Height="310"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F9FC"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ColorComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#A8CDE0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid MinWidth="190">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="12" Height="12" Fill="{Binding Hex}"/>
                            <TextBlock Grid.Column="1" Margin="6,0,0,0"
                                       VerticalAlignment="Center" Text="{Binding Name}"/>
                            <TextBlock Grid.Column="2" Margin="12,0,0,0"
                                       VerticalAlignment="Center" Foreground="#78909C"
                                       FontSize="11" Text="{Binding Hex}"/>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Foreground="#2C6E91" FontSize="19" FontWeight="SemiBold"
                   Text="Priority colors"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,15" Foreground="#6B8795"
                   Text="Choose a color for each checklist priority."/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Foreground="#355A6E" Text="High"/>
            <ComboBox x:Name="HighColorComboBox" Grid.Column="1" Margin="0,0,0,9"
                      Style="{StaticResource ColorComboBox}"/>

            <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="#355A6E" Text="Medium"/>
            <ComboBox x:Name="MediumColorComboBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,9"
                      Style="{StaticResource ColorComboBox}"/>

            <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="#355A6E" Text="Low"/>
            <ComboBox x:Name="LowColorComboBox" Grid.Row="2" Grid.Column="1"
                      Style="{StaticResource ColorComboBox}"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,17,0,0">
            <Button HorizontalAlignment="Left" Content="Reset"
                    Click="ResetButton_Click" Style="{StaticResource DialogButton}"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="0,0,8,0" Content="Cancel"
                        Click="CancelButton_Click" Style="{StaticResource DialogButton}"/>
                <Button Background="#2C6E91" BorderBrush="#2C6E91" Foreground="White"
                        Content="Save" Click="SaveButton_Click"
                        Style="{StaticResource DialogButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
